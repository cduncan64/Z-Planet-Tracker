5480   3C8B             
5481   3C8B             ; ---------------------------------------------------------------------------
5482   3C8B             ; Printer serial layer.
5483   3C8B             ;
5484   3C8B             ; IMPORTANT: the rear TRANZ serial connector used by our proven GPS/PC bridge
5485   3C8B             ; is DART B ($22 data / $23 control).  DART A is the internal modem/debug path
5486   3C8B             ; and must NOT be used for the external Printer 250.
5487   3C8B             ;
5488   3C8B             ; DART B is already initialized at startup for the hardware-proven 9600 8-N-1
5489   3C8B             ; GPS link.  Printing therefore uses only the DART-B transmitter; no baud-rate
5490   3C8B             ; or CTC reconfiguration is needed.  GPS acquisition is complete before the
5491   3C8B             ; print UI can be reached, so transmitting a report cannot disturb an active
5492   3C8B             ; startup acquisition.
5493   3C8B             ;
5494   3C8B             ; A short inter-character delay is provided so a report remains conservative
5495   3C8B             ; even if hardware flow control is not present in the particular printer cable.
5496   3C8B             ; ---------------------------------------------------------------------------
5497   3C8B             G_PRINTER_INIT:
5498   3C8B                     ; DART B is already 9600 8-N-1 and TX-enabled by DEBUG_DART_INIT.
5499   3C8B C9                  RET
5500   3C8C             
5501   3C8C             G_PRINTER_RESTORE_DEBUG:
5502   3C8C                     ; Nothing was reconfigured; leave the proven GPS/DART-B setup intact.
5503   3C8C C9                  RET
5504   3C8D             
5505   3C8D             G_PRN_TX_CHAR:
5506   3C8D C5                  PUSH BC
5507   3C8E 47                  LD B,A
5508   3C8F             G_PRN_TX_WAIT:
5509   3C8F DB 23               IN A,(DART_B_CTRL)
5510   3C91 E6 04               AND $04
5511   3C93 28 FA               JR Z,G_PRN_TX_WAIT
5512   3C95 78                  LD A,B
5513   3C96 D3 22               OUT (DART_B_DATA),A
5514   3C98             
5515   3C98                     ; Approximately 12 ms pacing at the firmware's nominal DELAY_2MS.
5516   3C98 06 06               LD B,6
5517   3C9A             G_PRN_PACE:
5518   3C9A CD B2 06            CALL DELAY_2MS
5519   3C9D 10 FB               DJNZ G_PRN_PACE
5520   3C9F C1                  POP BC
5521   3CA0 C9                  RET
5522   3CA1             
5523   3CA1             G_PRN_PRINT_Z:
5524   3CA1 F5                  PUSH AF
5525   3CA2 E5                  PUSH HL
5526   3CA3             G_PRN_PZ_LOOP:
5527   3CA3 7E                  LD A,(HL)
5528   3CA4 B7                  OR A
5529   3CA5 28 06               JR Z,G_PRN_PZ_DONE
5530   3CA7 CD 8D 3C            CALL G_PRN_TX_CHAR
5531   3CAA 23                  INC HL
5532   3CAB 18 F6               JR G_PRN_PZ_LOOP
5533   3CAD             G_PRN_PZ_DONE:
5534   3CAD E1                  POP HL
5535   3CAE F1                  POP AF
5536   3CAF C9                  RET
5537   3CB0             
5538   3CB0             G_PRN_CRLF:
5539   3CB0 3E 0D               LD A,13
5540   3CB2 CD 8D 3C            CALL G_PRN_TX_CHAR
5541   3CB5 3E 0A               LD A,10
5542   3CB7 CD 8D 3C            CALL G_PRN_TX_CHAR
5543   3CBA             
5544   3CBA                     ; Extra end-of-line settling pause: 200 x nominal 2 ms = ~400 ms.
5545   3CBA                     ; Existing per-character pacing in G_PRN_TX_CHAR is unchanged.
5546   3CBA C5                  PUSH BC
5547   3CBB 06 C8               LD B,200              ; 200 x nominal 2 ms = ~400 ms
5548   3CBD             G_PRN_EOL_PAUSE:
5549   3CBD CD B2 06            CALL DELAY_2MS
5550   3CC0 10 FB               DJNZ G_PRN_EOL_PAUSE
5551   3CC2 C1                  POP BC
5552   3CC3 C9                  RET
5553   3CC4             
5554   3CC4             ; A=0..99, print exactly two decimal digits.
5555   3CC4             G_PRN_DEC2:
5556   3CC4 C5                  PUSH BC
5557   3CC5 06 30               LD B,'0'
5558   3CC7             G_PD2_LOOP:
5559   3CC7 FE 0A               CP 10
5560   3CC9 38 05               JR C,G_PD2_DONE
5561   3CCB D6 0A               SUB 10
5562   3CCD 04                  INC B
5563   3CCE 18 F7               JR G_PD2_LOOP
5564   3CD0             G_PD2_DONE:
5565   3CD0 4F                  LD C,A
5566   3CD1 78                  LD A,B
5567   3CD2 CD 8D 3C            CALL G_PRN_TX_CHAR
5568   3CD5 79                  LD A,C
5569   3CD6 C6 30               ADD A,'0'
5570   3CD8 CD 8D 3C            CALL G_PRN_TX_CHAR
5571   3CDB C1                  POP BC
5572   3CDC C9                  RET
5573   3CDD             
5574   3CDD             ; HL=0..999, print exactly three decimal digits.
5575   3CDD             G_PRN_DEC3:
5576   3CDD C5                  PUSH BC
5577   3CDE D5                  PUSH DE
5578   3CDF 11 64 00            LD DE,100
5579   3CE2 CD F4 3C            CALL G_PRN_DIGIT
5580   3CE5 11 0A 00            LD DE,10
5581   3CE8 CD F4 3C            CALL G_PRN_DIGIT
5582   3CEB 7D                  LD A,L
5583   3CEC C6 30               ADD A,'0'
5584   3CEE CD 8D 3C            CALL G_PRN_TX_CHAR
5585   3CF1 D1                  POP DE
5586   3CF2 C1                  POP BC
5587   3CF3 C9                  RET
5588   3CF4             
5589   3CF4             ; Helper for fixed decimal digit, HL value and DE divisor.
5590   3CF4             G_PRN_DIGIT:
5591   3CF4 06 30               LD B,'0'
5592   3CF6             G_PRN_DIGIT_LOOP:
5593   3CF6 B7                  OR A
5594   3CF7 ED 52               SBC HL,DE
5595   3CF9 38 03               JR C,G_PRN_DIGIT_DONE
5596   3CFB 04                  INC B
5597   3CFC 18 F8               JR G_PRN_DIGIT_LOOP
5598   3CFE             G_PRN_DIGIT_DONE:
5599   3CFE 19                  ADD HL,DE
5600   3CFF 78                  LD A,B
5601   3D00 C3 8D 3C            JP G_PRN_TX_CHAR
5602   3D03             
5603   3D03             ; HL unsigned 0..999, print without leading zeroes.
5604   3D03             G_PRN_U16_TRIM3:
5605   3D03 C5                  PUSH BC
5606   3D04 D5                  PUSH DE
5607   3D05 06 00               LD B,0
5608   3D07 11 64 00            LD DE,100
5609   3D0A             G_PUT3_HUND_LOOP:
5610   3D0A B7                  OR A
5611   3D0B ED 52               SBC HL,DE
5612   3D0D 38 03               JR C,G_PUT3_HUND_DONE
5613   3D0F 04                  INC B
5614   3D10 18 F8               JR G_PUT3_HUND_LOOP
5615   3D12             G_PUT3_HUND_DONE:
5616   3D12 19                  ADD HL,DE
5617   3D13 78                  LD A,B
5618   3D14 B7                  OR A
5619   3D15 28 07               JR Z,G_PUT3_TENS
5620   3D17 C6 30               ADD A,'0'
5621   3D19 CD 8D 3C            CALL G_PRN_TX_CHAR
5622   3D1C 06 01               LD B,1                         ; hundreds already emitted
5623   3D1E             
5624   3D1E             G_PUT3_TENS:
5625   3D1E 0E 00               LD C,0
5626   3D20 11 0A 00            LD DE,10
5627   3D23             G_PUT3_TENS_LOOP:
5628   3D23 B7                  OR A
5629   3D24 ED 52               SBC HL,DE
5630   3D26 38 03               JR C,G_PUT3_TENS_DONE
5631   3D28 0C                  INC C
5632   3D29 18 F8               JR G_PUT3_TENS_LOOP
5633   3D2B             G_PUT3_TENS_DONE:
5634   3D2B 19                  ADD HL,DE
5635   3D2C 78                  LD A,B
5636   3D2D B7                  OR A
5637   3D2E 20 04               JR NZ,G_PUT3_EMIT_TENS
5638   3D30 79                  LD A,C
5639   3D31 B7                  OR A
5640   3D32 28 06               JR Z,G_PUT3_ONES
5641   3D34             G_PUT3_EMIT_TENS:
5642   3D34 79                  LD A,C
5643   3D35 C6 30               ADD A,'0'
5644   3D37 CD 8D 3C            CALL G_PRN_TX_CHAR
5645   3D3A             G_PUT3_ONES:
5646   3D3A 7D                  LD A,L
5647   3D3B C6 30               ADD A,'0'
5648   3D3D CD 8D 3C            CALL G_PRN_TX_CHAR
5649   3D40 D1                  POP DE
5650   3D41 C1                  POP BC
5651   3D42 C9                  RET
5652   3D43             
5653   3D43             ; HL=angle in tenths.  Print unsigned degrees with one decimal.
5654   3D43             G_PRN_ANGLE10:
5655   3D43 CD 6F 13            CALL ASTRO_DIVU10              ; HL=integer, DE=remainder 0..9
5656   3D46 D5                  PUSH DE
5657   3D47 CD 03 3D            CALL G_PRN_U16_TRIM3
5658   3D4A 3E 2E               LD A,'.'
5659   3D4C CD 8D 3C            CALL G_PRN_TX_CHAR
5660   3D4F D1                  POP DE
5661   3D50 7B                  LD A,E
5662   3D51 C6 30               ADD A,'0'
5663   3D53 C3 8D 3C            JP G_PRN_TX_CHAR
5664   3D56             
5665   3D56             ; HL=signed elevation in tenths.  Print explicit +/- sign and one decimal.
5666   3D56             G_PRN_SIGNED_ANGLE10:
5667   3D56 CB 7C               BIT 7,H
5668   3D58 28 0B               JR Z,G_PSA_POS
5669   3D5A 3E 2D               LD A,'-'
5670   3D5C CD 8D 3C            CALL G_PRN_TX_CHAR
5671   3D5F CD CF 19            CALL ASTRO_NEG_HL
5672   3D62 C3 43 3D            JP G_PRN_ANGLE10
5673   3D65             G_PSA_POS:
5674   3D65 3E 2B               LD A,'+'
5675   3D67 CD 8D 3C            CALL G_PRN_TX_CHAR
5676   3D6A C3 43 3D            JP G_PRN_ANGLE10
5677   3D6D             
5678   3D6D             ; Print compass sector corresponding to unsigned AZ10 in HL.
5679   3D6D             G_PRN_COMPASS16:
5680   3D6D 11 70 00            LD DE,112
5681   3D70 19                  ADD HL,DE
5682   3D71 CD 7C 0F            CALL ASTRO_NORM3600
5683   3D74 06 00               LD B,0
5684   3D76 11 E1 00            LD DE,225
5685   3D79             G_PCOMP_DIV:
5686   3D79 B7                  OR A
5687   3D7A ED 52               SBC HL,DE
5688   3D7C 38 03               JR C,G_PCOMP_DONE
5689   3D7E 04                  INC B
5690   3D7F 18 F8               JR G_PCOMP_DIV
5691   3D81             G_PCOMP_DONE:
5692   3D81 78                  LD A,B
5693   3D82 E6 0F               AND $0F
5694   3D84 87                  ADD A,A
5695   3D85 5F                  LD E,A
5696   3D86 16 00               LD D,0
5697   3D88 21 6A 5C            LD HL,G_COMPASS_PTRS
5698   3D8B 19                  ADD HL,DE
5699   3D8C 5E                  LD E,(HL)
5700   3D8D 23                  INC HL
5701   3D8E 56                  LD D,(HL)
5702   3D8F EB                  EX DE,HL
5703   3D90 C3 A1 3C            JP G_PRN_PRINT_Z
5704   3D93             
5705   3D93             ; Select one of the eight traditional phase names from corrected Moon-Sun
5706   3D93             ; elongation.  Boundaries are 22.5-degree half-sector points.
5707   3D93             G_PRN_MOON_PHASE_NAME:
5708   3D93 2A DE 89            LD HL,(G_MOON_LON)
5709   3D96 ED 5B E0 89         LD DE,(G_SUN_LON)
5710   3D9A B7                  OR A
5711   3D9B ED 52               SBC HL,DE
5712   3D9D CD 7C 0F            CALL ASTRO_NORM3600
5713   3DA0 22 8D 89            LD (G_TMPW0),HL
5714   3DA3             
5715   3DA3 11 E1 00            LD DE,225
5716   3DA6 B7                  OR A
5717   3DA7 ED 52               SBC HL,DE
5718   3DA9 38 4D               JR C,G_PMP_NEW
5719   3DAB             
5720   3DAB 2A 8D 89            LD HL,(G_TMPW0)
5721   3DAE 11 A3 02            LD DE,675
5722   3DB1 B7                  OR A
5723   3DB2 ED 52               SBC HL,DE
5724   3DB4 38 48               JR C,G_PMP_WAX_CRES
5725   3DB6             
5726   3DB6 2A 8D 89            LD HL,(G_TMPW0)
5727   3DB9 11 65 04            LD DE,1125
5728   3DBC B7                  OR A
5729   3DBD ED 52               SBC HL,DE
5730   3DBF 38 43               JR C,G_PMP_FIRST
5731   3DC1             
5732   3DC1 2A 8D 89            LD HL,(G_TMPW0)
5733   3DC4 11 27 06            LD DE,1575
5734   3DC7 B7                  OR A
5735   3DC8 ED 52               SBC HL,DE
5736   3DCA 38 3E               JR C,G_PMP_WAX_GIB
5737   3DCC             
5738   3DCC 2A 8D 89            LD HL,(G_TMPW0)
5739   3DCF 11 E9 07            LD DE,2025
5740   3DD2 B7                  OR A
5741   3DD3 ED 52               SBC HL,DE
5742   3DD5 38 39               JR C,G_PMP_FULL
5743   3DD7             
5744   3DD7 2A 8D 89            LD HL,(G_TMPW0)
5745   3DDA 11 AB 09            LD DE,2475
5746   3DDD B7                  OR A
5747   3DDE ED 52               SBC HL,DE
5748   3DE0 38 34               JR C,G_PMP_WAN_GIB
5749   3DE2             
5750   3DE2 2A 8D 89            LD HL,(G_TMPW0)
5751   3DE5 11 6D 0B            LD DE,2925
5752   3DE8 B7                  OR A
5753   3DE9 ED 52               SBC HL,DE
5754   3DEB 38 2F               JR C,G_PMP_LAST
5755   3DED             
5756   3DED 2A 8D 89            LD HL,(G_TMPW0)
5757   3DF0 11 2F 0D            LD DE,3375
5758   3DF3 B7                  OR A
5759   3DF4 ED 52               SBC HL,DE
5760   3DF6 38 2A               JR C,G_PMP_WAN_CRES
5761   3DF8             G_PMP_NEW:
5762   3DF8 21 C2 5A            LD HL,GPRN_PHASE_NEW
5763   3DFB C3 A1 3C            JP G_PRN_PRINT_Z
5764   3DFE             G_PMP_WAX_CRES:
5765   3DFE 21 C6 5A            LD HL,GPRN_PHASE_WAX_CRES
5766   3E01 C3 A1 3C            JP G_PRN_PRINT_Z
5767   3E04             G_PMP_FIRST:
5768   3E04 21 D6 5A            LD HL,GPRN_PHASE_FIRST
5769   3E07 C3 A1 3C            JP G_PRN_PRINT_Z
5770   3E0A             G_PMP_WAX_GIB:
5771   3E0A 21 E4 5A            LD HL,GPRN_PHASE_WAX_GIB
5772   3E0D C3 A1 3C            JP G_PRN_PRINT_Z
5773   3E10             G_PMP_FULL:
5774   3E10 21 F3 5A            LD HL,GPRN_PHASE_FULL
5775   3E13 C3 A1 3C            JP G_PRN_PRINT_Z
5776   3E16             G_PMP_WAN_GIB:
5777   3E16 21 F8 5A            LD HL,GPRN_PHASE_WAN_GIB
5778   3E19 C3 A1 3C            JP G_PRN_PRINT_Z
5779   3E1C             G_PMP_LAST:
5780   3E1C 21 07 5B            LD HL,GPRN_PHASE_LAST
5781   3E1F C3 A1 3C            JP G_PRN_PRINT_Z
5782   3E22             G_PMP_WAN_CRES:
5783   3E22 21 14 5B            LD HL,GPRN_PHASE_WAN_CRES
5784   3E25 C3 A1 3C            JP G_PRN_PRINT_Z
5785   3E28             
5786   3E28             ; ---------------------------------------------------------------------------
5787   3E28             ; Build and send the complete 42-column-friendly report.
5788   3E28             ; ---------------------------------------------------------------------------
5789   3E28             G_PRINT_REPORT_AND_FINISH:
