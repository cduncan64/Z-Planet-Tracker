8055   4F0C ED 5B 8F 89         LD DE,(G_TMPW1)
8056   4F10 29                  ADD HL,HL
8057   4F11 19                  ADD HL,DE                  ; 3P
8058   4F12 11 06 00            LD DE,6
8059   4F15 CD 1A 4C            CALL G_ADD_SIN_TERM
8060   4F18 2A 8F 89            LD HL,(G_TMPW1)
