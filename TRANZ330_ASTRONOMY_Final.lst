7830   4D5F             ; DYNAMIC MOON EVENTS: 10-minute coarse scan + 1-minute refinement.
7831   4D5F             ; ---------------------------------------------------------------------------
7832   4D5F             G_EVENTS_MOON:
7833   4D5F 21 FF FF            LD HL,$FFFF
7834   4D62 22 26 89            LD (AST_RISE),HL
7835   4D65 22 28 89            LD (AST_SET),HL
7836   4D68 CD D1 48            CALL G_SET_LST0
