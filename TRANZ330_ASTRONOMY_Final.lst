0439   0301 3E 05           LD A,$05
0440   0303 D3 23           OUT (DART_B_CTRL),A
0441   0305 3E EA           LD A,$EA
0442   0307 D3 23           OUT (DART_B_CTRL),A
0443   0309 3E 01           LD A,$01
0444   030B D3 23           OUT (DART_B_CTRL),A
0445   030D AF              XOR A
0446   030E D3 23           OUT (DART_B_CTRL),A
0447   0310 C9              RET
