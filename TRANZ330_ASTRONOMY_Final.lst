8230   5161             
8231   5161             ; ============================================================================
8232   5161             ; V11 GPS RMC INPUT
8233   5161             ; Wait for checksum-valid $GPRMC/$GNRMC status A, capture UTC and site, then
8234   5161             ; ask once for the local UTC offset.  * decrements one hour, # increments one
8235   5161             ; hour, ENTER accepts.  The selected offset is then applied to the GPS UTC,
8236   5161             ; and the resulting local civil time is written to the battery-backed RTC.
8237   5161             ; ============================================================================
8238   5161             
8239   5161             GPS_STARTUP_WAIT:
8240   5161 CD BE 06            CALL ASTRO_CLOCK_INIT
8241   5164 21 00 00            LD HL,0
8242   5167 22 77 89            LD (AST_UTC_OFFSET_MIN),HL
8243   516A AF                  XOR A
8244   516B 32 7B 89            LD (AST_UTC_OFFSET_HR),A
8245   516E 32 26 8A            LD (GPS_COLLECTING),A
8246   5171 32 27 8A            LD (GPS_INDEX),A
8247   5174 32 28 8A            LD (GPS_FIX_READY),A
8248   5177 21 AD 58            LD HL,GMSG_ACQUIRING_GPS
8249   517A CD 2E 06            CALL DISPLAY_SHOW
8250   517D             GPS_WAIT_LOOP:
8251   517D                     ; Allow ALPHA to restart while waiting for GPS.
8252   517D CD E8 01            CALL KEY_SCAN
8253   5180 FE 0C               CP KEY_ALPHA
8254   5182 CA F3 37            JP Z,G_FULL_RESET
8255   5185             
8256   5185 DB 23               IN A,(DART_B_CTRL)
8257   5187 E6 01               AND $01
8258   5189 28 F2               JR Z,GPS_WAIT_LOOP
8259   518B DB 22               IN A,(DART_B_DATA)
8260   518D CD 94 52            CALL GPS_RX_BYTE
8261   5190 3A 28 8A            LD A,(GPS_FIX_READY)
8262   5193 B7                  OR A
8263   5194 28 E7               JR Z,GPS_WAIT_LOOP
8264   5196             
8265   5196 21 BE 58            LD HL,GMSG_GPS_FIX
8266   5199 CD 2E 06            CALL DISPLAY_SHOW
8267   519C CD 85 52            CALL GPS_DELAY_1S
8268   519F CD AE 51            CALL GPS_SELECT_UTC_OFFSET
8269   51A2 CD 29 52            CALL GPS_APPLY_OFFSET_TO_LOCAL
8270   51A5 CD A0 07            CALL RTC_WRITE_LOCAL
8271   51A8 3E 01               LD A,1
8272   51AA 32 00 89            LD (AST_CLOCK_OK),A
8273   51AD C9                  RET
8274   51AE             
8275   51AE             ; Select one whole-hour local offset from UTC, once after each fresh GPS fix.
8276   51AE             ; Starts at UTC+00.  * moves west/down one hour; # moves east/up one hour.
8277   51AE             ; Range is UTC-12 through UTC+12.  CLEAR resets the choice to UTC+00.
8278   51AE             GPS_SELECT_UTC_OFFSET:
8279   51AE AF                  XOR A
8280   51AF 32 7B 89            LD (AST_UTC_OFFSET_HR),A
8281   51B2             GPS_UTC_OFFSET_DRAW:
8282   51B2 CD 1A 06            CALL DISPLAY_CLEAR
8283   51B5 21 92 1A            LD HL,GMSG_UTC_SELECT
8284   51B8 CD 48 06            CALL DISPLAY_PRINT_Z
8285   51BB 3A 7B 89            LD A,(AST_UTC_OFFSET_HR)
8286   51BE CB 7F               BIT 7,A
8287   51C0 20 09               JR NZ,GPS_UTC_OFFSET_NEG_DRAW
8288   51C2 F5                  PUSH AF
8289   51C3 3E 2B               LD A,'+'
8290   51C5 CD 51 06            CALL DISPLAY_PUT_ASCII
8291   51C8 F1                  POP AF
8292   51C9 18 09               JR GPS_UTC_OFFSET_MAG_DRAW
8293   51CB             GPS_UTC_OFFSET_NEG_DRAW:
8294   51CB F5                  PUSH AF
8295   51CC 3E 2D               LD A,'-'
8296   51CE CD 51 06            CALL DISPLAY_PUT_ASCII
8297   51D1 F1                  POP AF
8298   51D2 2F                  CPL
8299   51D3 3C                  INC A
8300   51D4             GPS_UTC_OFFSET_MAG_DRAW:
8301   51D4 CD 9A 06            CALL DISPLAY_DEC2
8302   51D7             GPS_UTC_OFFSET_KEY:
8303   51D7 CD 3E 02            CALL KEY_GET
8304   51DA FE 0C               CP KEY_ALPHA
8305   51DC CA F3 37            JP Z,G_FULL_RESET
8306   51DF FE 04               CP KEY_CLEAR
8307   51E1 28 CB               JR Z,GPS_SELECT_UTC_OFFSET
8308   51E3 FE 10               CP KEY_ENTER
8309   51E5 28 24               JR Z,GPS_UTC_OFFSET_ACCEPT
8310   51E7 FE 0D               CP KEY_UTC_NEG             ; * = one hour more negative
8311   51E9 28 06               JR Z,GPS_UTC_OFFSET_DEC
8312   51EB FE 0F               CP KEY_UTC_POS             ; # = one hour more positive
8313   51ED 28 0F               JR Z,GPS_UTC_OFFSET_INC
8314   51EF 18 E6               JR GPS_UTC_OFFSET_KEY
8315   51F1             GPS_UTC_OFFSET_DEC:
8316   51F1 3A 7B 89            LD A,(AST_UTC_OFFSET_HR)
8317   51F4 FE F4               CP $F4                     ; -12 in 8-bit two's complement
8318   51F6 28 BA               JR Z,GPS_UTC_OFFSET_DRAW
8319   51F8 3D                  DEC A
8320   51F9 32 7B 89            LD (AST_UTC_OFFSET_HR),A
8321   51FC 18 B4               JR GPS_UTC_OFFSET_DRAW
8322   51FE             GPS_UTC_OFFSET_INC:
8323   51FE 3A 7B 89            LD A,(AST_UTC_OFFSET_HR)
8324   5201 FE 0C               CP 12
8325   5203 28 AD               JR Z,GPS_UTC_OFFSET_DRAW
8326   5205 3C                  INC A
8327   5206 32 7B 89            LD (AST_UTC_OFFSET_HR),A
8328   5209 18 A7               JR GPS_UTC_OFFSET_DRAW
8329   520B             GPS_UTC_OFFSET_ACCEPT:
8330   520B                     ; Convert signed whole hours to signed minutes for all astronomy math.
8331   520B 3A 7B 89            LD A,(AST_UTC_OFFSET_HR)
8332   520E 6F                  LD L,A
8333   520F 26 00               LD H,0
8334   5211 CB 7F               BIT 7,A
8335   5213 28 02               JR Z,GPS_UTC_OFFSET_EXTENDED
8336   5215 26 FF               LD H,$FF
8337   5217             GPS_UTC_OFFSET_EXTENDED:
8338   5217 E5                  PUSH HL                    ; x1
8339   5218 29                  ADD HL,HL                 ; x2
8340   5219 29                  ADD HL,HL                 ; x4
8341   521A EB                  EX DE,HL                  ; DE=x4
8342   521B E1                  POP HL                    ; HL=x1
8343   521C 29                  ADD HL,HL                 ; x2
8344   521D 29                  ADD HL,HL                 ; x4
8345   521E 29                  ADD HL,HL                 ; x8
8346   521F 29                  ADD HL,HL                 ; x16
8347   5220 29                  ADD HL,HL                 ; x32
8348   5221 29                  ADD HL,HL                 ; x64
8349   5222 B7                  OR A
8350   5223 ED 52               SBC HL,DE                 ; x60
8351   5225 22 77 89            LD (AST_UTC_OFFSET_MIN),HL
8352   5228 C9                  RET
8353   5229             
8354   5229             ; Convert the just-received GPS UTC date/time to selected local civil time.
8355   5229             ; Offset range is only +/-12h, so at most one calendar-day adjustment occurs.
8356   5229             GPS_APPLY_OFFSET_TO_LOCAL:
8357   5229 3A 18 8A            LD A,(GPS_UTC_YEAR)
8358   522C 32 01 89            LD (AST_YEAR),A
8359   522F 3A 19 8A            LD A,(GPS_UTC_MONTH)
8360   5232 32 02 89            LD (AST_MONTH),A
8361   5235 3A 1A 8A            LD A,(GPS_UTC_DAY)
8362   5238 32 03 89            LD (AST_DAY),A
8363   523B 3A 1C 8A            LD A,(GPS_UTC_MINUTE)
8364   523E 32 05 89            LD (AST_MINUTE),A
8365   5241 3A 1D 8A            LD A,(GPS_UTC_SECOND)
8366   5244 32 57 89            LD (AST_SECOND),A
8367   5247             
8368   5247 3A 1B 8A            LD A,(GPS_UTC_HOUR)
8369   524A 6F                  LD L,A
8370   524B 26 00               LD H,0
8371   524D 3A 7B 89            LD A,(AST_UTC_OFFSET_HR)
8372   5250 5F                  LD E,A
8373   5251 16 00               LD D,0
8374   5253 CB 7F               BIT 7,A
8375   5255 28 02               JR Z,GPS_APPLY_OFFSET_EXTENDED
8376   5257 16 FF               LD D,$FF
8377   5259             GPS_APPLY_OFFSET_EXTENDED:
8378   5259 19                  ADD HL,DE
8379   525A CB 7C               BIT 7,H
8380   525C 28 0C               JR Z,GPS_APPLY_OFFSET_NONNEG
8381   525E 11 18 00            LD DE,24
8382   5261 19                  ADD HL,DE
8383   5262 7D                  LD A,L
8384   5263 32 04 89            LD (AST_HOUR),A
8385   5266 CD 8E 56            CALL GPS_LOCAL_PREVIOUS_DAY
8386   5269 C9                  RET
8387   526A             GPS_APPLY_OFFSET_NONNEG:
8388   526A 7C                  LD A,H
8389   526B B7                  OR A
8390   526C 20 09               JR NZ,GPS_APPLY_OFFSET_NEXT
8391   526E 7D                  LD A,L
8392   526F FE 18               CP 24
8393   5271 30 04               JR NC,GPS_APPLY_OFFSET_NEXT
8394   5273 32 04 89            LD (AST_HOUR),A
8395   5276 C9                  RET
8396   5277             GPS_APPLY_OFFSET_NEXT:
8397   5277 11 18 00            LD DE,24
8398   527A B7                  OR A
8399   527B ED 52               SBC HL,DE
8400   527D 7D                  LD A,L
8401   527E 32 04 89            LD (AST_HOUR),A
8402   5281 CD B8 56            CALL GPS_LOCAL_NEXT_DAY
8403   5284 C9                  RET
8404   5285             
8405   5285             GPS_DELAY_1S:
8406   5285 06 FA               LD B,250
8407   5287             GPS_D1_A:
8408   5287 CD B2 06            CALL DELAY_2MS
8409   528A 10 FB               DJNZ GPS_D1_A
8410   528C 06 FA               LD B,250
8411   528E             GPS_D1_B:
8412   528E CD B2 06            CALL DELAY_2MS
8413   5291 10 FB               DJNZ GPS_D1_B
8414   5293 C9                  RET
8415   5294             
8416   5294             ; A = received byte. '$' always re-synchronizes. CR/LF terminates a sentence.
8417   5294             GPS_RX_BYTE:
8418   5294 32 29 8A            LD (GPS_RX_SAVED),A
8419   5297 FE 24               CP '$'
8420   5299 28 29               JR Z,GPS_RX_DOLLAR
8421   529B 57                  LD D,A
8422   529C 3A 26 8A            LD A,(GPS_COLLECTING)
8423   529F B7                  OR A
8424   52A0 C8                  RET Z
8425   52A1 7A                  LD A,D
8426   52A2 FE 0D               CP 13
8427   52A4 28 2E               JR Z,GPS_RX_END
8428   52A6 FE 0A               CP 10
8429   52A8 28 2A               JR Z,GPS_RX_END
8430   52AA             
8431   52AA 3A 27 8A            LD A,(GPS_INDEX)
8432   52AD FE 4F               CP 79
8433   52AF 30 39               JR NC,GPS_RX_ABORT
8434   52B1 5F                  LD E,A
8435   52B2 16 00               LD D,0
8436   52B4 21 50 8A            LD HL,GPS_BUFFER
8437   52B7 19                  ADD HL,DE
8438   52B8 3A 29 8A            LD A,(GPS_RX_SAVED)
8439   52BB 77                  LD (HL),A
8440   52BC 3A 27 8A            LD A,(GPS_INDEX)
8441   52BF 3C                  INC A
8442   52C0 32 27 8A            LD (GPS_INDEX),A
8443   52C3 C9                  RET
8444   52C4             
8445   52C4             GPS_RX_DOLLAR:
8446   52C4 3E 01               LD A,1
8447   52C6 32 26 8A            LD (GPS_COLLECTING),A
8448   52C9 3E 01               LD A,1
8449   52CB 32 27 8A            LD (GPS_INDEX),A
8450   52CE 3E 24               LD A,'$'
8451   52D0 32 50 8A            LD (GPS_BUFFER),A
8452   52D3 C9                  RET
8453   52D4             
8454   52D4             GPS_RX_END:
8455   52D4 AF                  XOR A
8456   52D5 32 26 8A            LD (GPS_COLLECTING),A
8457   52D8 3A 27 8A            LD A,(GPS_INDEX)
8458   52DB B7                  OR A
8459   52DC C8                  RET Z
8460   52DD 5F                  LD E,A
8461   52DE 16 00               LD D,0
8462   52E0 21 50 8A            LD HL,GPS_BUFFER
8463   52E3 19                  ADD HL,DE
8464   52E4 AF                  XOR A
8465   52E5 77                  LD (HL),A
8466   52E6 CD F2 52            CALL GPS_PARSE_RMC
8467   52E9 C9                  RET
8468   52EA             
8469   52EA             GPS_RX_ABORT:
8470   52EA AF                  XOR A
8471   52EB 32 26 8A            LD (GPS_COLLECTING),A
8472   52EE 32 27 8A            LD (GPS_INDEX),A
8473   52F1 C9                  RET
8474   52F2             
8475   52F2             ; ---------------------------------------------------------------------------
8476   52F2             ; Checksum-valid RMC parser. All required fields are first parsed into
8477   52F2             ; temporary RAM. Astronomy-visible state is committed only after the complete
8478   52F2             ; sentence validates, so a malformed sentence cannot partially update time/site.
8479   52F2             ; ---------------------------------------------------------------------------
8480   52F2             GPS_PARSE_RMC:
8481   52F2 CD 63 53            CALL GPS_VALIDATE_CHECKSUM
8482   52F5 D8                  RET C
8483   52F6             
8484   52F6 21 51 8A            LD HL,GPS_BUFFER+1
8485   52F9 7E                  LD A,(HL)
8486   52FA FE 47               CP 'G'
8487   52FC C0                  RET NZ
8488   52FD 23                  INC HL
8489   52FE 7E                  LD A,(HL)
8490   52FF FE 50               CP 'P'
8491   5301 28 03               JR Z,GPS_PR_TALKER_OK
8492   5303 FE 4E               CP 'N'
8493   5305 C0                  RET NZ
8494   5306             GPS_PR_TALKER_OK:
8495   5306 23                  INC HL
8496   5307 7E                  LD A,(HL)
8497   5308 FE 52               CP 'R'
8498   530A C0                  RET NZ
8499   530B 23                  INC HL
8500   530C 7E                  LD A,(HL)
8501   530D FE 4D               CP 'M'
8502   530F C0                  RET NZ
8503   5310 23                  INC HL
8504   5311 7E                  LD A,(HL)
8505   5312 FE 43               CP 'C'
8506   5314 C0                  RET NZ
8507   5315 23                  INC HL
8508   5316 7E                  LD A,(HL)
8509   5317 FE 2C               CP ','
8510   5319 C0                  RET NZ
8511   531A 23                  INC HL
8512   531B             
8513   531B                     ; UTC hhmmss[.ss]
8514   531B CD E3 53            CALL GPS_PARSE_TIME
8515   531E D8                  RET C
8516   531F             
8517   531F                     ; Status must be A and field must be exactly one character.
8518   531F 7E                  LD A,(HL)
8519   5320 FE 41               CP 'A'
8520   5322 C0                  RET NZ
8521   5323 23                  INC HL
8522   5324 7E                  LD A,(HL)
8523   5325 FE 2C               CP ','
8524   5327 C0                  RET NZ
8525   5328 23                  INC HL
8526   5329             
8527   5329                     ; Latitude ddmm.mmmmm
8528   5329 CD 70 54            CALL GPS_PARSE_LAT_FIELD
8529   532C D8                  RET C
8530   532D 7E                  LD A,(HL)
8531   532E FE 4E               CP 'N'
8532   5330 28 03               JR Z,GPS_LAT_HEMI_OK
8533   5332 FE 53               CP 'S'
8534   5334 C0                  RET NZ
8535   5335             GPS_LAT_HEMI_OK:
8536   5335 32 35 8A            LD (GPS_TMP_LAT_HEMI),A
8537   5338 23                  INC HL
8538   5339 7E                  LD A,(HL)
8539   533A FE 2C               CP ','
8540   533C C0                  RET NZ
8541   533D 23                  INC HL
8542   533E             
8543   533E                     ; Longitude dddmm.mmmmm
8544   533E CD A8 54            CALL GPS_PARSE_LON_FIELD
8545   5341 D8                  RET C
8546   5342 7E                  LD A,(HL)
8547   5343 FE 45               CP 'E'
8548   5345 28 03               JR Z,GPS_LON_HEMI_OK
8549   5347 FE 57               CP 'W'
8550   5349 C0                  RET NZ
8551   534A             GPS_LON_HEMI_OK:
8552   534A 32 39 8A            LD (GPS_TMP_LON_HEMI),A
8553   534D 23                  INC HL
8554   534E 7E                  LD A,(HL)
8555   534F FE 2C               CP ','
8556   5351 C0                  RET NZ
8557   5352 23                  INC HL
8558   5353             
8559   5353                     ; Skip speed and course fields.
8560   5353 CD 5C 54            CALL GPS_SKIP_FIELD
8561   5356 D8                  RET C
8562   5357 CD 5C 54            CALL GPS_SKIP_FIELD
8563   535A D8                  RET C
8564   535B             
8565   535B                     ; Date ddmmyy
8566   535B CD 20 54            CALL GPS_PARSE_DATE
8567   535E D8                  RET C
8568   535F             
8569   535F                     ; We have a complete, checksum-valid active RMC sentence.
8570   535F CD 0E 56            CALL GPS_COMMIT_FIX
8571   5362 C9                  RET
8572   5363             
8573   5363             ; A checksum failure returns carry set. Checksum is XOR of bytes after '$'
8574   5363             ; through byte before '*', compared to the two ASCII hex digits after '*'.
8575   5363             GPS_VALIDATE_CHECKSUM:
8576   5363 21 50 8A            LD HL,GPS_BUFFER
8577   5366 7E                  LD A,(HL)
8578   5367 FE 24               CP '$'
8579   5369 20 2B               JR NZ,GPS_CKS_BAD
8580   536B 23                  INC HL
8581   536C 06 00               LD B,0
8582   536E             GPS_CKS_LOOP:
8583   536E 7E                  LD A,(HL)
8584   536F B7                  OR A
8585   5370 28 24               JR Z,GPS_CKS_BAD
8586   5372 FE 2A               CP '*'
8587   5374 28 07               JR Z,GPS_CKS_STAR
8588   5376 4F                  LD C,A
8589   5377 78                  LD A,B
8590   5378 A9                  XOR C
8591   5379 47                  LD B,A
8592   537A 23                  INC HL
8593   537B 18 F1               JR GPS_CKS_LOOP
8594   537D             GPS_CKS_STAR:
8595   537D 23                  INC HL
8596   537E 7E                  LD A,(HL)
8597   537F CD 98 53            CALL GPS_HEX_NIBBLE
8598   5382 38 12               JR C,GPS_CKS_BAD
8599   5384 87                  ADD A,A
8600   5385 87                  ADD A,A
8601   5386 87                  ADD A,A
8602   5387 87                  ADD A,A
8603   5388 57                  LD D,A
8604   5389 23                  INC HL
8605   538A 7E                  LD A,(HL)
8606   538B CD 98 53            CALL GPS_HEX_NIBBLE
8607   538E 38 06               JR C,GPS_CKS_BAD
8608   5390 B2                  OR D
8609   5391 B8                  CP B
8610   5392 20 02               JR NZ,GPS_CKS_BAD
8611   5394 B7                  OR A
8612   5395 C9                  RET
8613   5396             GPS_CKS_BAD:
8614   5396 37                  SCF
8615   5397 C9                  RET
8616   5398             
8617   5398             ; ASCII hex nibble -> A=0..15, carry on invalid.
8618   5398             GPS_HEX_NIBBLE:
8619   5398 FE 30               CP '0'
8620   539A 38 20               JR C,GPS_HEX_BAD
8621   539C FE 3A               CP '9'+1
8622   539E 38 18               JR C,GPS_HEX_DEC
8623   53A0 FE 41               CP 'A'
8624   53A2 38 04               JR C,GPS_HEX_LOWER_TEST
8625   53A4 FE 47               CP 'F'+1
8626   53A6 38 0C               JR C,GPS_HEX_UPPER
8627   53A8             GPS_HEX_LOWER_TEST:
8628   53A8 FE 61               CP 'a'
8629   53AA 38 10               JR C,GPS_HEX_BAD
8630   53AC FE 67               CP 'f'+1
8631   53AE 30 0C               JR NC,GPS_HEX_BAD
8632   53B0 D6 57               SUB 'a'-10
8633   53B2 B7                  OR A
8634   53B3 C9                  RET
8635   53B4             GPS_HEX_UPPER:
8636   53B4 D6 37               SUB 'A'-10
8637   53B6 B7                  OR A
8638   53B7 C9                  RET
8639   53B8             GPS_HEX_DEC:
8640   53B8 D6 30               SUB '0'
8641   53BA B7                  OR A
8642   53BB C9                  RET
8643   53BC             GPS_HEX_BAD:
8644   53BC 37                  SCF
8645   53BD C9                  RET
8646   53BE             
8647   53BE             ; Parse two decimal digits at (HL), advance HL by two, A=value, carry invalid.
8648   53BE             GPS_PARSE_2DIG:
8649   53BE 7E                  LD A,(HL)
8650   53BF CD D5 53            CALL GPS_ASCII_DIGIT
8651   53C2 D8                  RET C
8652   53C3 47                  LD B,A
8653   53C4 23                  INC HL
8654   53C5 7E                  LD A,(HL)
8655   53C6 CD D5 53            CALL GPS_ASCII_DIGIT
8656   53C9 D8                  RET C
8657   53CA 4F                  LD C,A
8658   53CB 23                  INC HL
8659   53CC 78                  LD A,B
8660   53CD 87                  ADD A,A
8661   53CE 57                  LD D,A
8662   53CF 87                  ADD A,A
8663   53D0 87                  ADD A,A
8664   53D1 82                  ADD A,D
8665   53D2 81                  ADD A,C
8666   53D3 B7                  OR A
8667   53D4 C9                  RET
8668   53D5             
8669   53D5             GPS_ASCII_DIGIT:
8670   53D5 FE 30               CP '0'
8671   53D7 38 08               JR C,GPS_DIG_BAD
8672   53D9 FE 3A               CP '9'+1
8673   53DB 30 04               JR NC,GPS_DIG_BAD
8674   53DD D6 30               SUB '0'
8675   53DF B7                  OR A
8676   53E0 C9                  RET
8677   53E1             GPS_DIG_BAD:
8678   53E1 37                  SCF
8679   53E2 C9                  RET
8680   53E3             
8681   53E3             GPS_PARSE_TIME:
8682   53E3 CD BE 53            CALL GPS_PARSE_2DIG
8683   53E6 D8                  RET C
8684   53E7 FE 18               CP 24
8685   53E9 30 33               JR NC,GPS_TIME_BAD
8686   53EB 32 2F 8A            LD (GPS_TMP_UTC_HOUR),A
8687   53EE CD BE 53            CALL GPS_PARSE_2DIG
8688   53F1 D8                  RET C
8689   53F2 FE 3C               CP 60
8690   53F4 30 28               JR NC,GPS_TIME_BAD
8691   53F6 32 30 8A            LD (GPS_TMP_UTC_MIN),A
8692   53F9 CD BE 53            CALL GPS_PARSE_2DIG
8693   53FC D8                  RET C
8694   53FD FE 3C               CP 60
8695   53FF 30 1D               JR NC,GPS_TIME_BAD
8696   5401 32 31 8A            LD (GPS_TMP_UTC_SEC),A
8697   5404 7E                  LD A,(HL)
8698   5405 FE 2E               CP '.'
8699   5407 20 0D               JR NZ,GPS_TIME_COMMA
8700   5409 23                  INC HL
8701   540A             GPS_TIME_FRAC:
8702   540A 7E                  LD A,(HL)
8703   540B FE 2C               CP ','
8704   540D 28 0C               JR Z,GPS_TIME_DONE
8705   540F CD D5 53            CALL GPS_ASCII_DIGIT
8706   5412 D8                  RET C
8707   5413 23                  INC HL
8708   5414 18 F4               JR GPS_TIME_FRAC
8709   5416             GPS_TIME_COMMA:
8710   5416 7E                  LD A,(HL)
8711   5417 FE 2C               CP ','
8712   5419 20 03               JR NZ,GPS_TIME_BAD
8713   541B             GPS_TIME_DONE:
8714   541B 23                  INC HL
8715   541C B7                  OR A
8716   541D C9                  RET
8717   541E             GPS_TIME_BAD:
8718   541E 37                  SCF
8719   541F C9                  RET
8720   5420             
8721   5420             GPS_PARSE_DATE:
8722   5420 CD BE 53            CALL GPS_PARSE_2DIG
8723   5423 D8                  RET C
8724   5424 B7                  OR A
8725   5425 28 31               JR Z,GPS_DATE_BAD
8726   5427 FE 20               CP 32
8727   5429 30 2D               JR NC,GPS_DATE_BAD
8728   542B 32 2E 8A            LD (GPS_TMP_UTC_DAY),A
8729   542E CD BE 53            CALL GPS_PARSE_2DIG
8730   5431 D8                  RET C
8731   5432 B7                  OR A
8732   5433 28 23               JR Z,GPS_DATE_BAD
8733   5435 FE 0D               CP 13
8734   5437 30 1F               JR NC,GPS_DATE_BAD
8735   5439 32 2D 8A            LD (GPS_TMP_UTC_MONTH),A
8736   543C CD BE 53            CALL GPS_PARSE_2DIG
8737   543F D8                  RET C
8738   5440 32 2C 8A            LD (GPS_TMP_UTC_YEAR),A
8739   5443                     ; RMC date is followed by comma or '*' depending on optional fields.
8740   5443 7E                  LD A,(HL)
8741   5444 FE 2C               CP ','
8742   5446 28 04               JR Z,GPS_DATE_RANGE
8743   5448 FE 2A               CP '*'
8744   544A 20 0C               JR NZ,GPS_DATE_BAD
8745   544C             GPS_DATE_RANGE:
8746   544C                     ; Validate day against parsed month/year without touching AST date.
8747   544C CD E7 55            CALL GPS_TMP_DAYS_IN_MONTH
8748   544F 47                  LD B,A
8749   5450 3A 2E 8A            LD A,(GPS_TMP_UTC_DAY)
8750   5453 B8                  CP B
8751   5454 38 04               JR C,GPS_DATE_OK
8752   5456 28 02               JR Z,GPS_DATE_OK
8753   5458             GPS_DATE_BAD:
8754   5458 37                  SCF
8755   5459 C9                  RET
8756   545A             GPS_DATE_OK:
8757   545A B7                  OR A
8758   545B C9                  RET
8759   545C             
8760   545C             ; HL at field start. Advance through field and comma. Empty fields are allowed.
8761   545C             GPS_SKIP_FIELD:
8762   545C             GPS_SKIP_LOOP:
8763   545C 7E                  LD A,(HL)
8764   545D B7                  OR A
8765   545E 28 0E               JR Z,GPS_SKIP_BAD
8766   5460 FE 2C               CP ','
8767   5462 28 07               JR Z,GPS_SKIP_DONE
8768   5464 FE 2A               CP '*'
8769   5466 28 06               JR Z,GPS_SKIP_BAD
8770   5468 23                  INC HL
8771   5469 18 F1               JR GPS_SKIP_LOOP
8772   546B             GPS_SKIP_DONE:
8773   546B 23                  INC HL
8774   546C B7                  OR A
8775   546D C9                  RET
8776   546E             GPS_SKIP_BAD:
8777   546E 37                  SCF
8778   546F C9                  RET
8779   5470             
8780   5470             ; Latitude field: DDMM.m...  Longitude field: DDDMM.m...
8781   5470             ; Outputs temporary degree byte, 3-decimal degree fraction, and angle10.
8782   5470             GPS_PARSE_LAT_FIELD:
8783   5470 CD BE 53            CALL GPS_PARSE_2DIG
8784   5473 D8                  RET C
8785   5474 FE 5B               CP 91
8786   5476 D2 F7 54            JP NC,GPS_COORD_BAD             ; V11d10a: was JR at +126, only 1 byte from limit
8787   5479 32 3E 8A            LD (GPS_TMP_COORD_DEG),A
8788   547C 32 49 8A            LD (GPS_TMP_COORD_ORIG_DEG),A
8789   547F CD F9 54            CALL GPS_PARSE_MINUTES
8790   5482 D8                  RET C
8791   5483                     ; 90 degrees is valid only with 00.000 minutes.
8792   5483 3A 49 8A            LD A,(GPS_TMP_COORD_ORIG_DEG)
8793   5486 FE 5A               CP 90
8794   5488 20 07               JR NZ,GPS_LAT_RANGE_OK
8795   548A 2A 47 8A            LD HL,(GPS_TMP_MIN_MILLI)
8796   548D 7C                  LD A,H
8797   548E B5                  OR L
8798   548F 20 66               JR NZ,GPS_COORD_BAD
8799   5491             GPS_LAT_RANGE_OK:
8800   5491 3A 3E 8A            LD A,(GPS_TMP_COORD_DEG)
8801   5494 32 32 8A            LD (GPS_TMP_LAT_DEG),A
8802   5497 2A 3F 8A            LD HL,(GPS_TMP_COORD_FRAC3)
8803   549A 22 33 8A            LD (GPS_TMP_LAT_FRAC3),HL
8804   549D 2A 41 8A            LD HL,(GPS_TMP_COORD_ANGLE10)
8805   54A0 22 3A 8A            LD (GPS_TMP_LAT10),HL
8806   54A3 2A 2A 8A            LD HL,(GPS_FIELD_PTR)
8807   54A6 B7                  OR A
8808   54A7 C9                  RET
8809   54A8             
8810   54A8             GPS_PARSE_LON_FIELD:
8811   54A8                     ; Three degree digits, 000..180.
8812   54A8 7E                  LD A,(HL)
8813   54A9 CD D5 53            CALL GPS_ASCII_DIGIT
8814   54AC D8                  RET C
8815   54AD F5                  PUSH AF                       ; preserve hundreds digit
8816   54AE 23                  INC HL
8817   54AF CD BE 53            CALL GPS_PARSE_2DIG
8818   54B2 38 42               JR C,GPS_LON_POP_BAD
8819   54B4 4F                  LD C,A                        ; low two degree digits
8820   54B5 F1                  POP AF
8821   54B6 B7                  OR A
8822   54B7 28 09               JR Z,GPS_LON_DEG_HAVE
8823   54B9                     ; 1xx only; 2xx is outside longitude range.
8824   54B9 FE 01               CP 1
8825   54BB 20 3A               JR NZ,GPS_COORD_BAD
8826   54BD 79                  LD A,C
8827   54BE C6 64               ADD A,100
8828   54C0 18 01               JR GPS_LON_DEG_STORE
8829   54C2             GPS_LON_DEG_HAVE:
8830   54C2 79                  LD A,C
8831   54C3             GPS_LON_DEG_STORE:
8832   54C3 FE B5               CP 181
8833   54C5 30 30               JR NC,GPS_COORD_BAD
8834   54C7 32 3E 8A            LD (GPS_TMP_COORD_DEG),A
8835   54CA 32 49 8A            LD (GPS_TMP_COORD_ORIG_DEG),A
8836   54CD CD F9 54            CALL GPS_PARSE_MINUTES
8837   54D0 D8                  RET C
8838   54D1                     ; 180 degrees is valid only with 00.000 minutes.
8839   54D1 3A 49 8A            LD A,(GPS_TMP_COORD_ORIG_DEG)
8840   54D4 FE B4               CP 180
8841   54D6 20 07               JR NZ,GPS_LON_RANGE_OK
8842   54D8 2A 47 8A            LD HL,(GPS_TMP_MIN_MILLI)
8843   54DB 7C                  LD A,H
8844   54DC B5                  OR L
8845   54DD 20 18               JR NZ,GPS_COORD_BAD
8846   54DF             GPS_LON_RANGE_OK:
8847   54DF 3A 3E 8A            LD A,(GPS_TMP_COORD_DEG)
8848   54E2 32 36 8A            LD (GPS_TMP_LON_DEG),A
8849   54E5 2A 3F 8A            LD HL,(GPS_TMP_COORD_FRAC3)
8850   54E8 22 37 8A            LD (GPS_TMP_LON_FRAC3),HL
8851   54EB 2A 41 8A            LD HL,(GPS_TMP_COORD_ANGLE10)
8852   54EE 22 3C 8A            LD (GPS_TMP_LON10),HL
8853   54F1 2A 2A 8A            LD HL,(GPS_FIELD_PTR)
8854   54F4 B7                  OR A
8855   54F5 C9                  RET
8856   54F6             GPS_LON_POP_BAD:
8857   54F6 F1                  POP AF
8858   54F7             GPS_COORD_BAD:
8859   54F7 37                  SCF
8860   54F8 C9                  RET
8861   54F9             
8862   54F9             ; Input HL points at MM.m... of a coordinate. Requires at least one
8863   54F9             ; fractional digit. Returns through GPS_FIELD_PTR with HL after the comma.
8864   54F9             ; Uses the first three fractional minute digits (zero-padded) for display
8865   54F9             ; rounding; later digits are syntactically validated and ignored.
8866   54F9             GPS_PARSE_MINUTES:
8867   54F9 CD BE 53            CALL GPS_PARSE_2DIG
8868   54FC D8                  RET C
8869   54FD FE 3C               CP 60
8870   54FF D2 CD 55            JP NC,GPS_MIN_BAD
8871   5502 32 43 8A            LD (GPS_TMP_MINUTES),A
8872   5505 7E                  LD A,(HL)
8873   5506 FE 2E               CP '.'
8874   5508 C2 CD 55            JP NZ,GPS_MIN_BAD
8875   550B 23                  INC HL
8876   550C AF                  XOR A
8877   550D 32 44 8A            LD (GPS_TMP_F1),A
8878   5510 32 45 8A            LD (GPS_TMP_F2),A
8879   5513 32 46 8A            LD (GPS_TMP_F3),A
8880   5516 06 00               LD B,0
8881   5518             GPS_MIN_FRAC_LOOP:
