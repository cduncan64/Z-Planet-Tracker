8916   554D                     ; minute_milli = minutes*1000 + first three fractional digits.
8917   554D 3A 43 8A            LD A,(GPS_TMP_MINUTES)
8918   5550 6F                  LD L,A
8919   5551 26 00               LD H,0
8920   5553 CD E0 55            CALL GPS_MUL10_HL
8921   5556 CD E0 55            CALL GPS_MUL10_HL
8922   5559 CD E0 55            CALL GPS_MUL10_HL
8923   555C E5                  PUSH HL
8924   555D 3A 44 8A            LD A,(GPS_TMP_F1)
8925   5560 6F                  LD L,A
8926   5561 26 00               LD H,0
8927   5563 CD E0 55            CALL GPS_MUL10_HL
8928   5566 CD E0 55            CALL GPS_MUL10_HL
8929   5569 54                  LD D,H
8930   556A 5D                  LD E,L
8931   556B 3A 45 8A            LD A,(GPS_TMP_F2)
8932   556E 6F                  LD L,A
8933   556F 26 00               LD H,0
8934   5571 CD E0 55            CALL GPS_MUL10_HL
8935   5574 19                  ADD HL,DE
8936   5575 3A 46 8A            LD A,(GPS_TMP_F3)
8937   5578 5F                  LD E,A
8938   5579 16 00               LD D,0
8939   557B 19                  ADD HL,DE
8940   557C EB                  EX DE,HL
8941   557D E1                  POP HL
8942   557E 19                  ADD HL,DE
8943   557F 22 47 8A            LD (GPS_TMP_MIN_MILLI),HL
8944   5582             
8945   5582                     ; angle10 = original degree*10 + round(minute_milli / 6000).
8946   5582                     ; Do this BEFORE display rounding, because 59.999 minutes may carry
8947   5582                     ; the displayed coordinate into the next whole degree.
8948   5582 2A 47 8A            LD HL,(GPS_TMP_MIN_MILLI)
8949   5585 11 B8 0B            LD DE,3000
8950   5588 19                  ADD HL,DE
8951   5589 11 70 17            LD DE,6000
8952   558C 06 00               LD B,0
8953   558E             GPS_DIV6000_LOOP:
8954   558E B7                  OR A
8955   558F ED 52               SBC HL,DE
8956   5591 38 03               JR C,GPS_DIV6000_DONE
8957   5593 04                  INC B
8958   5594 18 F8               JR GPS_DIV6000_LOOP
