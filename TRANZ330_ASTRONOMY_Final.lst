2527   0F95             ; PLANET VECTOR
2528   0F95             ; ============================================================================
2529   0F95             
2530   0F95             ; Input: HL = UTC minutes 0..1439 for this AST_DAYS date.
2531   0F95             ; Output: AST_X/Y/Z equatorial geocentric vector.
2532   0F95             ;
2533   0F95             ; Fractional-day correction is intentionally applied only to mean anomalies;
2534   0F95             ; all other element rates are negligible over one day at this resolution.
2535   0F95             ASTRO_VECTOR:
2536   0F95 22 4D 89            LD (AST_TMP7),HL           ; UTC minutes
2537   0F98             
2538   0F98                     ; ----- Sun mean anomaly fractional day -----
2539   0F98                     ; correction = round(minutes * 9.856 / 1440), 0..10 tenths.
2540   0F98                     ; We use a compact hour lookup: index = minutes/60, 0..23.
2541   0F98 CD 02 16            CALL ASTRO_MINUTES_TO_HOUR
