8886   5520 DA CD 55            JP C,GPS_MIN_BAD
8887   5523 4F                  LD C,A
8888   5524 78                  LD A,B
8889   5525 B7                  OR A
8890   5526 20 06               JR NZ,GPS_MIN_NOT_F1
8891   5528 79                  LD A,C
8892   5529 32 44 8A            LD (GPS_TMP_F1),A
8893   552C 18 12               JR GPS_MIN_NEXT
8894   552E             GPS_MIN_NOT_F1:
8895   552E FE 01               CP 1
8896   5530 20 06               JR NZ,GPS_MIN_NOT_F2
8897   5532 79                  LD A,C
8898   5533 32 45 8A            LD (GPS_TMP_F2),A
8899   5536 18 08               JR GPS_MIN_NEXT
8900   5538             GPS_MIN_NOT_F2:
8901   5538 FE 02               CP 2
8902   553A 20 04               JR NZ,GPS_MIN_NEXT
