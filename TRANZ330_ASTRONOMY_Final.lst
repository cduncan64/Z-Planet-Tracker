5148   39F7 CD 41 3C            CALL G_COPY_GPS_UTC_TO_PRINT
5149   39FA CD 48 3A            CALL G_RESTORE_AST_CLOCK_TEMP
5150   39FD C9                  RET
5151   39FE             
