7175   4800             
7176   4800             ; HL=local minute. Return A=0 below geometric horizon, A=1 at/above it.
7177   4800             ; For crossing polarity we only need the sign of UP; EAST/NORTH and the
7178   4800             ; elevation angle are unnecessary.  This preserves the existing geometric
7179   4800             ; zero-degree crossing exactly (it intentionally does NOT apply H0 here).
7180   4800             G_EF_SIGN_AT_MIN:
7181   4800 CD 09 48            CALL G_UP_FOR_VECTOR_FAST
7182   4803 2A 3B 89            LD HL,(AST_UP)
7183   4806 C3 67 47            JP G_EF_SIGN_HL
7184   4809             
7185   4809             ; Compute only q and UP for the fixed AST_X/Y/Z vector.  Compared with
7186   4809             ; G_HORIZONTAL_FOR_VECTOR this skips EAST and NORTH entirely: two trig calls
7187   4809             ; and four Q15 multiplies instead of four trig calls and eight multiplies.
7188   4809             G_UP_FOR_VECTOR_FAST:
7189   4809 E5                  PUSH HL
7190   480A CD F5 15            CALL ASTRO_SID_ADV10
7191   480D EB                  EX DE,HL
7192   480E 2A 2F 89            LD HL,(AST_LST0)
7193   4811 19                  ADD HL,DE
7194   4812 CD 86 0F            CALL ASTRO_NORM3600_SIGNED
7195   4815 22 8D 89            LD (G_TMPW0),HL
7196   4818             
7197   4818                     ; q = x*cos(LST) + y*sin(LST)
7198   4818 CD 24 16            CALL ASTRO_COS10
7199   481B EB                  EX DE,HL
7200   481C 2A 20 89            LD HL,(AST_X)
7201   481F CD 34 16            CALL ASTRO_MUL_Q15
7202   4822 22 8F 89            LD (G_TMPW1),HL
