7838   4D6B 21 00 40            LD HL,16384
7839   4D6E 11 47 00            LD DE,G_H0_MOON
7840   4D71 CD 34 16            CALL ASTRO_MUL_Q15
7841   4D74 22 31 89            LD (AST_HORIZON_Q),HL
7842   4D77                     ; minute 0
7843   4D77 21 00 00            LD HL,0
7844   4D7A CD 55 4E            CALL G_MOON_UP_AT_MIN
7845   4D7D 22 E8 89            LD (G_DYN_PREV),HL
7846   4D80 CD 7E 14            CALL ASTRO_ABOVE_HORIZON
7847   4D83 32 73 89            LD (AST_PREV),A
7848   4D86 21 0A 00            LD HL,10
7849   4D89 22 6C 89            LD (AST_SCAN_MIN),HL
7850   4D8C             G_EM_LOOP:
7851   4D8C                     ; Spread progress dots 2, 3 and 4 across the lunar event scan.
7852   4D8C 2A 6C 89            LD HL,(AST_SCAN_MIN)
7853   4D8F 11 68 01            LD DE,360
7854   4D92 B7                  OR A
7855   4D93 ED 52               SBC HL,DE
7856   4D95 28 16               JR Z,G_EM_PROGRESS
7857   4D97 2A 6C 89            LD HL,(AST_SCAN_MIN)
7858   4D9A 11 D0 02            LD DE,720
7859   4D9D B7                  OR A
7860   4D9E ED 52               SBC HL,DE
7861   4DA0 28 0B               JR Z,G_EM_PROGRESS
7862   4DA2 2A 6C 89            LD HL,(AST_SCAN_MIN)
7863   4DA5 11 38 04            LD DE,1080
7864   4DA8 B7                  OR A
7865   4DA9 ED 52               SBC HL,DE
