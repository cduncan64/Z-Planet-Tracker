6260   4190 87                  ADD A,A
6261   4191 5F                  LD E,A
6262   4192 16 00               LD D,0
6263   4194 21 6A 5C            LD HL,G_COMPASS_PTRS
6264   4197 19                  ADD HL,DE
6265   4198 5E                  LD E,(HL)
6266   4199 23                  INC HL
6267   419A 56                  LD D,(HL)
6268   419B EB                  EX DE,HL
6269   419C C3 48 06            JP DISPLAY_PRINT_Z
6270   419F             
6271   419F             ; Safe RTC refresh. ASTRO_RTC_READ writes candidate fields before it
6272   419F             ; validates them, so save the current valid/manual clock and restore on error.
6273   419F             G_REFRESH_RTC_SAFE:
6274   419F                     ; V1H: Manual-clock mode.
6275   419F                     ; Preserve the date/time entered at startup and do not overwrite it
6276   419F                     ; with the hardware RTC during object selection/calculation.
6277   419F 37                  SCF
6278   41A0 C9                  RET
6279   41A1             
6280   41A1             ; ---------------------------------------------------------------------------
6281   41A1             ; DATE PREPARATION AND FAST LINEAR ELEMENT EVOLUTION
6282   41A1             ; ---------------------------------------------------------------------------
6283   41A1             G_PREPARE_DATE:
6284   41A1 CD 9F 41            CALL G_REFRESH_RTC_SAFE
6285   41A4 38 00               JR C,G_PD_KEEP_MANUAL
6286   41A6                     ; RTC valid -> AST_* refreshed.
6287   41A6             G_PD_KEEP_MANUAL:
6288   41A6 CD E0 0D            CALL ASTRO_DAY_NUMBER
6289   41A9 CD AD 41            CALL G_PREPARE_SUN_BASE
6290   41AC C9                  RET
6291   41AD             
6292   41AD             G_PREPARE_SUN_BASE:
6293   41AD                     ; Sun mean anomaly at UTC 00:00
6294   41AD 21 E8 0D            LD HL,G_SUN_M0
6295   41B0 22 96 89            LD (G_CALC_BASE),HL
6296   41B3 21 09 00            LD HL,G_SUN_MI
6297   41B6 22 9A 89            LD (G_CALC_INT),HL
6298   41B9 21 70 21            LD HL,G_SUN_MF
6299   41BC 22 9C 89            LD (G_CALC_FRAC),HL
6300   41BF CD 12 42            CALL G_CALC_MEAN
6301   41C2 22 08 89            LD (AST_SM),HL
6302   41C5                     ; Sun longitude of perihelion
6303   41C5 21 0D 0B            LD HL,G_SUN_W0
6304   41C8 22 96 89            LD (G_CALC_BASE),HL
6305   41CB 21 05 00            LD HL,G_SUN_WR
6306   41CE 22 98 89            LD (G_CALC_RATE),HL
6307   41D1 CD D8 41            CALL G_CALC_SMALL
6308   41D4 22 0C 89            LD (AST_SW),HL
6309   41D7 C9                  RET
6310   41D8             
6311   41D8             ; G_CALC_SMALL: base angle + signed small drift.
6312   41D8             ; rate units = 1/10000 of a tenth-degree per day.
6313   41D8             G_CALC_SMALL:
6314   41D8 2A 98 89            LD HL,(G_CALC_RATE)
6315   41DB AF                  XOR A
6316   41DC 32 9E 89            LD (G_CALC_SIGN),A
6317   41DF CB 7C               BIT 7,H
6318   41E1 28 08               JR Z,G_CS_POS
6319   41E3 CD CF 19            CALL ASTRO_NEG_HL
6320   41E6 3E 01               LD A,1
6321   41E8 32 9E 89            LD (G_CALC_SIGN),A
6322   41EB             G_CS_POS:
6323   41EB EB                  EX DE,HL
6324   41EC 2A 06 89            LD HL,(AST_DAYS)
6325   41EF CD 7C 16            CALL ASTRO_UMUL16
6326   41F2 21 88 13            LD HL,5000
6327   41F5 CD 49 42            CALL G_M32_ADD16
6328   41F8 21 10 27            LD HL,10000
6329   41FB CD 06 17            CALL ASTRO_DIV32_BY_16
6330   41FE EB                  EX DE,HL                   ; DE=correction
6331   41FF 2A 96 89            LD HL,(G_CALC_BASE)
6332   4202 3A 9E 89            LD A,(G_CALC_SIGN)
6333   4205 B7                  OR A
6334   4206 28 06               JR Z,G_CS_ADD
6335   4208 B7                  OR A
6336   4209 ED 52               SBC HL,DE
6337   420B C3 86 0F            JP ASTRO_NORM3600_SIGNED
6338   420E             G_CS_ADD:
6339   420E 19                  ADD HL,DE
6340   420F C3 7C 0F            JP ASTRO_NORM3600
6341   4212             
6342   4212             ; G_CALC_MEAN: base + days*(integer + frac/10000), modulo 3600.
6343   4212             G_CALC_MEAN:
6344   4212                     ; fractional contribution, rounded
6345   4212 2A 06 89            LD HL,(AST_DAYS)
6346   4215 ED 5B 9C 89         LD DE,(G_CALC_FRAC)
6347   4219 CD 7C 16            CALL ASTRO_UMUL16
6348   421C 21 88 13            LD HL,5000
6349   421F CD 49 42            CALL G_M32_ADD16
6350   4222 21 10 27            LD HL,10000
6351   4225 CD 06 17            CALL ASTRO_DIV32_BY_16
6352   4228 22 8D 89            LD (G_TMPW0),HL
6353   422B                     ; integer contribution
6354   422B 2A 06 89            LD HL,(AST_DAYS)
6355   422E ED 5B 9A 89         LD DE,(G_CALC_INT)
6356   4232 CD 7C 16            CALL ASTRO_UMUL16
6357   4235 2A 8D 89            LD HL,(G_TMPW0)
6358   4238 CD 49 42            CALL G_M32_ADD16
6359   423B 2A 96 89            LD HL,(G_CALC_BASE)
6360   423E CD 49 42            CALL G_M32_ADD16
6361   4241 21 10 0E            LD HL,3600
6362   4244 CD 06 17            CALL ASTRO_DIV32_BY_16
6363   4247 EB                  EX DE,HL                   ; divider leaves remainder in DE
6364   4248 C9                  RET
6365   4249             
6366   4249             ; Add unsigned HL to little-endian M32_ACC.
6367   4249             G_M32_ADD16:
6368   4249 3A 5E 89            LD A,(M32_ACC)
6369   424C 85                  ADD A,L
6370   424D 32 5E 89            LD (M32_ACC),A
6371   4250 3A 5F 89            LD A,(M32_ACC+1)
6372   4253 8C                  ADC A,H
6373   4254 32 5F 89            LD (M32_ACC+1),A
6374   4257 3A 60 89            LD A,(M32_ACC+2)
6375   425A CE 00               ADC A,0
6376   425C 32 60 89            LD (M32_ACC+2),A
6377   425F 3A 61 89            LD A,(M32_ACC+3)
6378   4262 CE 00               ADC A,0
6379   4264 32 61 89            LD (M32_ACC+3),A
6380   4267 C9                  RET
6381   4268             
6382   4268             ; Fractional-day correction: input HL=UTC minutes (may be up to 1739),
6383   4268             ; DE=mean motion in hundredths of a tenth-degree/day. Returns HL=angle10 delta.
6384   4268             G_MINUTE_MDELTA:
6385   4268 CD 7C 16            CALL ASTRO_UMUL16
6386   426B 21 A0 05            LD HL,1440
6387   426E CD 06 17            CALL ASTRO_DIV32_BY_16     ; hundredths of tenth in HL
6388   4271 11 32 00            LD DE,50
6389   4274 19                  ADD HL,DE
6390   4275 CD 6F 13            CALL ASTRO_DIVU10
6391   4278 C3 6F 13            JP ASTRO_DIVU10
6392   427B             
6393   427B             ; Load normal planet table for current object and evolve date elements.
