5109   39BA             ; ---------------------------------------------------------------------------
5110   39BA             ; CURRENT print
5111   39BA             ; ---------------------------------------------------------------------------
5112   39BA             G_PRINT_CURRENT:
5113   39BA                     ; Build UTC from the timestamp captured at calculation completion,
5114   39BA                     ; not from the potentially newer live RTC display time.
5115   39BA CD CD 39            CALL G_BUILD_CURRENT_PRINT_UTC
5116   39BD CD 28 3E            CALL G_PRINT_REPORT_AND_FINISH
5117   39C0             
5118   39C0                     ; A completed print is a finished transaction.  Reset PRINT to NO so
5119   39C0                     ; the next trip through the result carousel never inherits YES from
5120   39C0                     ; the previous print request.
5121   39C0 AF                  XOR A
5122   39C1 32 A0 8A            LD (G_PRINT_CHOICE),A
5123   39C4             
5124   39C4                     ; After printing, return to the first result/status screen, e.g.
5125   39C4                     ; "JUPITER VIS", rather than returning to the PRINT screen.
5126   39C4 32 81 89            LD (G_SCREEN),A
5127   39C7 CD 68 38            CALL G_DRAW_RESULT_SCREEN
5128   39CA C3 88 37            JP G_RESULT_WAIT
5129   39CD             
5130   39CD             ; Convert G_CALC_* local civil time to UTC while preserving the live AST clock.
5131   39CD             G_BUILD_CURRENT_PRINT_UTC:
5132   39CD CD 23 3A            CALL G_SAVE_AST_CLOCK_TEMP
5133   39D0             
5134   39D0 3A A8 8A            LD A,(G_CALC_YEAR)
