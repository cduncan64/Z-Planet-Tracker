9192   5723 CD 9A 06            CALL DISPLAY_DEC2
9193   5726 3E 55               LD A,'U'
9194   5728 C3 51 06            JP DISPLAY_PUT_ASCII
9195   572B             
9196   572B             ; Build dynamic UTC display fields from current RTC local time.
9197   572B             ; UTC = local - selected signed whole-hour offset.  Because the supported
9198   572B             ; range is +/-12 hours, at most one date rollover is required.
9199   572B             G_RTC_LOCAL_TO_UTC:
9200   572B 3A 01 89            LD A,(AST_YEAR)
9201   572E 32 18 8A            LD (GPS_UTC_YEAR),A
9202   5731 3A 02 89            LD A,(AST_MONTH)
9203   5734 32 19 8A            LD (GPS_UTC_MONTH),A
9204   5737 3A 03 89            LD A,(AST_DAY)
9205   573A 32 1A 8A            LD (GPS_UTC_DAY),A
9206   573D 3A 05 89            LD A,(AST_MINUTE)
