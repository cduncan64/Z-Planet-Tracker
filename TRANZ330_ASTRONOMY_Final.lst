8975   55B3 B7                  OR A
8976   55B4 ED 52               SBC HL,DE
8977   55B6 38 0C               JR C,GPS_FRAC_LT1000
8978   55B8                     ; Rounded 59.999 minutes carries into the displayed next degree.
8979   55B8 21 00 00            LD HL,0
8980   55BB 3A 3E 8A            LD A,(GPS_TMP_COORD_DEG)
8981   55BE 3C                  INC A
8982   55BF 32 3E 8A            LD (GPS_TMP_COORD_DEG),A
8983   55C2 18 01               JR GPS_FRAC_STORE
