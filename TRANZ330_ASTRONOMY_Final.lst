9184   570D CD 9A 06            CALL DISPLAY_DEC2
9185   5710 3E 20               LD A,' '
9186   5712 CD 51 06            CALL DISPLAY_PUT_ASCII
9187   5715 3A 1B 8A            LD A,(GPS_UTC_HOUR)
9188   5718 CD 9A 06            CALL DISPLAY_DEC2
