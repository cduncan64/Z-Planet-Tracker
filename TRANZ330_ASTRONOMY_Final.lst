7209   4833 2A 8F 89            LD HL,(G_TMPW1)
7210   4836 19                  ADD HL,DE
7211   4837 22 35 89            LD (AST_Q),HL
7212   483A             
7213   483A                     ; up = q*cos(lat) + z*sin(lat)
7214   483A ED 5B 16 8A         LD DE,(G_SITE_LAT_COS_Q15)
7215   483E CD 34 16            CALL ASTRO_MUL_Q15
7216   4841 22 8F 89            LD (G_TMPW1),HL
