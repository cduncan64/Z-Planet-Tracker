6515   4347 22 EC 89            LD (G_SUN_M_CUR),HL
6516   434A                     ; E = M + 10*sin(M)
6517   434A E5                  PUSH HL
6518   434B CD 14 16            CALL ASTRO_SIN10
6519   434E 3E 0A               LD A,10
6520   4350 CD 2E 16            CALL ASTRO_SCALE_Q15_U8
6521   4353 EB                  EX DE,HL
6522   4354 E1                  POP HL
6523   4355 19                  ADD HL,DE
6524   4356 CD 7C 0F            CALL ASTRO_NORM3600
6525   4359 22 8F 89            LD (G_TMPW1),HL            ; E
6526   435C 22 F4 89            LD (G_DBG_SUN_E),HL
6527   435F                     ; xv
6528   435F CD 24 16            CALL ASTRO_COS10
6529   4362 EB                  EX DE,HL
6530   4363 21 00 02            LD HL,G_SUN_AQ
6531   4366 CD 34 16            CALL ASTRO_MUL_Q15
6532   4369 11 09 00            LD DE,G_SUN_AEQ
6533   436C B7                  OR A
6534   436D ED 52               SBC HL,DE
6535   436F 22 CA 89            LD (G_XV),HL
6536   4372                     ; yv
6537   4372 2A 8F 89            LD HL,(G_TMPW1)
6538   4375 CD 14 16            CALL ASTRO_SIN10
6539   4378 EB                  EX DE,HL
6540   4379 21 00 02            LD HL,G_SUN_BQ
6541   437C CD 34 16            CALL ASTRO_MUL_Q15
6542   437F 22 CC 89            LD (G_YV),HL
6543   4382                     ; rotate by w
6544   4382 2A 0C 89            LD HL,(AST_SW)
6545   4385 CD 24 16            CALL ASTRO_COS10
6546   4388 22 91 89            LD (G_TMPW2),HL
6547   438B 2A 0C 89            LD HL,(AST_SW)
6548   438E CD 14 16            CALL ASTRO_SIN10
6549   4391 22 93 89            LD (G_TMPW3),HL
6550   4394 2A CA 89            LD HL,(G_XV)
