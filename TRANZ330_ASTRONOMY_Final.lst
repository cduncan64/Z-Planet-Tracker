6502   4333             ; ---------------------------------------------------------------------------
6503   4333             ; SUN ECLIPTIC VECTOR, input HL=UTC minutes 0..1739
6504   4333             ; returns G_SX/G_SY, and G_SUN_LON
6505   4333             ; ---------------------------------------------------------------------------
6506   4333             G_SUN_VECTOR:
6507   4333 22 8B 89            LD (G_UTC_MIN),HL
6508   4336 11 DA 03            LD DE,G_SUN_MX100
6509   4339 CD 68 42            CALL G_MINUTE_MDELTA
6510   433C EB                  EX DE,HL
