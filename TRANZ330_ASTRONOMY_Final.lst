7904   4DFB B7                  OR A
7905   4DFC ED 52               SBC HL,DE
7906   4DFE DA 8C 4D            JP C,G_EM_LOOP
7907   4E01                     ; refine rise/set to one minute; transit is intentionally omitted
7908   4E01 2A 26 89            LD HL,(AST_RISE)
7909   4E04 CD 14 4E            CALL G_REFINE_CROSS
7910   4E07 22 26 89            LD (AST_RISE),HL
