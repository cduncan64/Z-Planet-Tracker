8992   55CD 37                  SCF
8993   55CE C9                  RET
8994   55CF             
8995   55CF             ; 16-bit unsigned divide by 60 for values <= 60029. HL=quotient.
8996   55CF             GPS_DIV60_16:
8997   55CF 01 00 00            LD BC,0
8998   55D2 11 3C 00            LD DE,60
8999   55D5             GPS_D60_16_LOOP:
