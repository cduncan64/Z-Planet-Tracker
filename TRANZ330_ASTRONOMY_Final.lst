7239   4871 2A 3B 89            LD HL,(AST_UP)
7240   4874 CD 73 18            CALL ASTRO_ATAN2_SIGNED90
7241   4877 C9                  RET
7242   4878             
7243   4878             ; Refine a detected coarse horizon crossing.
7244   4878             ; AST_PREV = state at previous coarse sample; AST_SCAN_MIN = current sample.
7245   4878             ; Search current-9 through current.  For ordinary 10-minute samples this is
7246   4878             ; exactly previous+1..current.  At the special 1439 sample it harmlessly starts
7247   4878             ; at 1430 (one duplicate evaluation) and still covers through 1439.
7248   4878             G_EF_REFINE_CROSSING:
7249   4878 2A 6C 89            LD HL,(AST_SCAN_MIN)
7250   487B 11 09 00            LD DE,9
7251   487E B7                  OR A
7252   487F ED 52               SBC HL,DE
7253   4881 22 4B 89            LD (AST_TMP6),HL               ; candidate minute
7254   4884             G_EF_RC_LOOP:
