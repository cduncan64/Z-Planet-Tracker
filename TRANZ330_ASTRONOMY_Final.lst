7929   4E26 CD 55 4E            CALL G_MOON_UP_AT_MIN
7930   4E29 CD 7E 14            CALL ASTRO_ABOVE_HORIZON
7931   4E2C 32 73 89            LD (AST_PREV),A
7932   4E2F 06 0A               LD B,10
7933   4E31             G_RC_LOOP:
7934   4E31 2A 0E 8A            LD HL,(G_REFINE_MIN)
7935   4E34 23                  INC HL
7936   4E35 22 0E 8A            LD (G_REFINE_MIN),HL
7937   4E38 C5                  PUSH BC                         ; lunar vector code freely uses B/C
7938   4E39 CD 55 4E            CALL G_MOON_UP_AT_MIN
7939   4E3C CD 7E 14            CALL ASTRO_ABOVE_HORIZON
7940   4E3F C1                  POP BC                          ; preserve DJNZ refinement count
7941   4E40 57                  LD D,A
7942   4E41 3A 73 89            LD A,(AST_PREV)
7943   4E44 BA                  CP D
7944   4E45 20 0A               JR NZ,G_RC_FOUND
7945   4E47 7A                  LD A,D
7946   4E48 32 73 89            LD (AST_PREV),A
7947   4E4B 10 E4               DJNZ G_RC_LOOP
7948   4E4D 2A 0E 8A            LD HL,(G_REFINE_MIN)
7949   4E50 C9                  RET
7950   4E51             G_RC_FOUND:
7951   4E51 2A 0E 8A            LD HL,(G_REFINE_MIN)
7952   4E54 C9                  RET
7953   4E55             
7954   4E55             ; Input HL=local minute, returns signed up coordinate.
7955   4E55             ; IMPORTANT: lunar vector generation uses G_TMPW0..G_TMPW3 as scratch,
7956   4E55             ; so preserve the local minute in dedicated RAM instead of a G_TMPW register.
7957   4E55             G_MOON_UP_AT_MIN:
7958   4E55 22 0C 8A            LD (G_MOON_LOCAL_MIN),HL
7959   4E58 CD C9 48            CALL G_LOCAL_TO_UTC_MIN
7960   4E5B CD 27 45            CALL G_VECTOR_SELECTED
7961   4E5E 2A 0C 8A            LD HL,(G_MOON_LOCAL_MIN)
7962   4E61                     ; Event detection needs only UP.  Skip EAST/NORTH during all lunar
7963   4E61                     ; coarse and one-minute event samples; final current AZ/EL still uses
7964   4E61                     ; the complete horizontal calculation elsewhere.
7965   4E61 CD 09 48            CALL G_UP_FOR_VECTOR_FAST
7966   4E64 2A 3B 89            LD HL,(AST_UP)
7967   4E67 C9                  RET
7968   4E68             
7969   4E68             ; ---------------------------------------------------------------------------
7970   4E68             ; MOON PHASE from corrected Moon/Sun ecliptic longitude at current vector.
7971   4E68             ; 0 => NEW, 100 => FULL, 1..99 numeric PHASE.
7972   4E68             ; ---------------------------------------------------------------------------
7973   4E68             G_CALC_MOON_PHASE:
7974   4E68 2A DE 89            LD HL,(G_MOON_LON)
7975   4E6B ED 5B E0 89         LD DE,(G_SUN_LON)
7976   4E6F B7                  OR A
7977   4E70 ED 52               SBC HL,DE
7978   4E72 CD 86 0F            CALL ASTRO_NORM3600_SIGNED
7979   4E75 E5                  PUSH HL
7980   4E76 11 08 07            LD DE,1800
7981   4E79 B7                  OR A
7982   4E7A ED 52               SBC HL,DE
7983   4E7C 3E 00               LD A,0                       ; 0 = waxing for elongation < 180 deg
7984   4E7E 38 01               JR C,G_PHASE_DIR_STORE
7985   4E80 3C                  INC A                        ; 1 = waning for elongation >= 180 deg
7986   4E81             G_PHASE_DIR_STORE:
7987   4E81 32 0A 8A            LD (G_PHASE_DIR),A
7988   4E84 E1                  POP HL
7989   4E85 CD 21 16            CALL ASTRO_COS10_SIGNED
7990   4E88 EB                  EX DE,HL                   ; DE=cos Q15 signed
7991   4E89 21 FF 7F            LD HL,32767
7992   4E8C B7                  OR A
7993   4E8D ED 52               SBC HL,DE                  ; 0..65534
7994   4E8F                     ; divide by 655, quotient 0..100
7995   4E8F 06 00               LD B,0
7996   4E91 11 8F 02            LD DE,655
7997   4E94             G_PHASE_DIV:
7998   4E94 B7                  OR A
7999   4E95 ED 52               SBC HL,DE
8000   4E97 38 03               JR C,G_PHASE_DONE
8001   4E99 04                  INC B
8002   4E9A 18 F8               JR G_PHASE_DIV
8003   4E9C             G_PHASE_DONE:
8004   4E9C 78                  LD A,B
8005   4E9D FE 65               CP 101
8006   4E9F 38 02               JR C,G_PHASE_STORE
8007   4EA1 3E 64               LD A,100
8008   4EA3             G_PHASE_STORE:
8009   4EA3 32 82 89            LD (G_PHASE),A
8010   4EA6 C9                  RET
8011   4EA7             
8012   4EA7             ; ---------------------------------------------------------------------------
8013   4EA7             ; PLUTO SPECIAL LOW-PRECISION MODEL (Schlyter-style periodic series).
8014   4EA7             ; input uses current G_UTC_MIN. returns through G_ECL_TO_EQ.
8015   4EA7             ; ---------------------------------------------------------------------------
8016   4EA7             G_VECTOR_PLUTO:
8017   4EA7                     ; For the 0.1-degree Z80 model, evolve S, P and base longitude using
8018   4EA7                     ; small linear rates from AST_DAYS; fractional day is negligible here.
8019   4EA7 21 F4 01            LD HL,500
8020   4EAA 22 96 89            LD (G_CALC_BASE),HL
8021   4EAD 21 12 0D            LD HL,3346
8022   4EB0 22 98 89            LD (G_CALC_RATE),HL
8023   4EB3 CD D8 41            CALL G_CALC_SMALL
8024   4EB6 22 8D 89            LD (G_TMPW0),HL            ; S
8025   4EB9 21 56 09            LD HL,2390
8026   4EBC 22 96 89            LD (G_CALC_BASE),HL
8027   4EBF 21 8D 01            LD HL,397
8028   4EC2 22 98 89            LD (G_CALC_RATE),HL
8029   4EC5 CD D8 41            CALL G_CALC_SMALL
8030   4EC8 22 8F 89            LD (G_TMPW1),HL            ; P
8031   4ECB 21 56 09            LD HL,2390
8032   4ECE 22 96 89            LD (G_CALC_BASE),HL
8033   4ED1 21 91 01            LD HL,401
8034   4ED4 22 98 89            LD (G_CALC_RATE),HL
8035   4ED7 CD D8 41            CALL G_CALC_SMALL
