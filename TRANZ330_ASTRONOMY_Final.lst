9165   56EB             ; ---------------------------------------------------------------------------
9166   56EB             ; Dynamic result displays.
9167   56EB             ; ---------------------------------------------------------------------------
9168   56EB             G_DRAW_UTC_DATE_TIME:
9169   56EB                     ; Refresh local civil time from the battery-backed RTC every time this
9170   56EB                     ; result screen is entered, then derive UTC using the one-time offset
9171   56EB                     ; selected immediately after GPS acquisition.
9172   56EB CD BE 06            CALL ASTRO_CLOCK_INIT
9173   56EE CD 2B 57            CALL G_RTC_LOCAL_TO_UTC
9174   56F1 CD 1A 06            CALL DISPLAY_CLEAR
9175   56F4 3A 19 8A            LD A,(GPS_UTC_MONTH)
9176   56F7 CD 9A 06            CALL DISPLAY_DEC2
9177   56FA 3E 2F               LD A,'/'
9178   56FC CD 51 06            CALL DISPLAY_PUT_ASCII
9179   56FF 3A 1A 8A            LD A,(GPS_UTC_DAY)
9180   5702 CD 9A 06            CALL DISPLAY_DEC2
9181   5705 3E 2F               LD A,'/'
9182   5707 CD 51 06            CALL DISPLAY_PUT_ASCII
