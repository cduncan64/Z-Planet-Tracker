5141   39E5 32 04 89            LD (AST_HOUR),A
5142   39E8 3A AC 8A            LD A,(G_CALC_MINUTE)
5143   39EB 32 05 89            LD (AST_MINUTE),A
5144   39EE 3A AD 8A            LD A,(G_CALC_SECOND)
5145   39F1 32 57 89            LD (AST_SECOND),A
5146   39F4             
