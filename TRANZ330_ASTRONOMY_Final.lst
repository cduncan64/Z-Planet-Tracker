8069   4F2C 11 FD FF            LD DE,-3
8070   4F2F CD 1A 4C            CALL G_ADD_SIN_TERM
8071   4F32 2A 8F 89            LD HL,(G_TMPW1)
8072   4F35 29                  ADD HL,HL
8073   4F36 29                  ADD HL,HL
8074   4F37 11 FE FF            LD DE,-2
8075   4F3A CD 2B 4C            CALL G_ADD_COS_TERM
8076   4F3D 2A 8F 89            LD HL,(G_TMPW1)
8077   4F40 ED 5B 8F 89         LD DE,(G_TMPW1)
8078   4F44 29                  ADD HL,HL
8079   4F45 29                  ADD HL,HL
8080   4F46 19                  ADD HL,DE                  ; 5P
8081   4F47 11 01 00            LD DE,1
