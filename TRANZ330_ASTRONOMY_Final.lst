2758   1167 22 41 89            LD (AST_TMP1),HL           ; xh
2759   116A             
2760   116A                     ; yh = x1*sinN + y1*cosi*cosN
2761   116A 2A 43 89            LD HL,(AST_TMP2)
2762   116D ED 5B 49 89         LD DE,(AST_TMP5)
2763   1171 CD 34 16            CALL ASTRO_MUL_Q15
2764   1174 22 3F 89            LD (AST_TMP0),HL
2765   1177 2A 45 89            LD HL,(AST_TMP3)
2766   117A ED 5B 4B 89         LD DE,(AST_TMP6)
2767   117E CD 34 16            CALL ASTRO_MUL_Q15
2768   1181 ED 5B 47 89         LD DE,(AST_TMP4)
2769   1185 CD 34 16            CALL ASTRO_MUL_Q15
2770   1188 EB                  EX DE,HL
2771   1189 2A 3F 89            LD HL,(AST_TMP0)
2772   118C 19                  ADD HL,DE
2773   118D 22 3F 89            LD (AST_TMP0),HL           ; yh
2774   1190             
2775   1190                     ; zh = y1*sin i
2776   1190 2A 45 89            LD HL,(AST_TMP3)
2777   1193 ED 5B 4D 89         LD DE,(AST_TMP7)
2778   1197 CD 34 16            CALL ASTRO_MUL_Q15
2779   119A 22 24 89            LD (AST_Z),HL              ; zh; preserve across perturbation scratch
2780   119D             
2781   119D                     ; Apply Jupiter/Saturn longitude perturbation.
2782   119D                     ; Returns HL = signed perturbation in tenths degree.
2783   119D CD 5E 12            CALL ASTRO_JUP_PERTURB
2784   11A0 CD FC 11            CALL ASTRO_ROTATE_PERTURB_SAFE
2785   11A3             
2786   11A3                     ; Geocentric ecliptic = Jupiter heliocentric + Sun geocentric.
2787   11A3 2A 20 89            LD HL,(AST_X)              ; xs
2788   11A6 ED 5B 41 89         LD DE,(AST_TMP1)           ; xh
2789   11AA 19                  ADD HL,DE
2790   11AB 22 41 89            LD (AST_TMP1),HL           ; xg
2791   11AE 2A 22 89            LD HL,(AST_Y)              ; ys
2792   11B1 ED 5B 3F 89         LD DE,(AST_TMP0)           ; yh
2793   11B5 19                  ADD HL,DE
2794   11B6 22 3F 89            LD (AST_TMP0),HL           ; yg
2795   11B9                     ; zg = zh already preserved in AST_Z
2796   11B9             
2797   11B9                     ; Ecliptic -> equatorial.
2798   11B9 2A 41 89            LD HL,(AST_TMP1)
2799   11BC 22 20 89            LD (AST_X),HL
2800   11BF             
2801   11BF 2A 3F 89            LD HL,(AST_TMP0)
2802   11C2 11 6F 75            LD DE,OBL_COS_Q15
2803   11C5 CD 34 16            CALL ASTRO_MUL_Q15
2804   11C8 22 47 89            LD (AST_TMP4),HL
2805   11CB 2A 24 89            LD HL,(AST_Z)
2806   11CE 11 EA 32            LD DE,OBL_SIN_Q15
2807   11D1 CD 34 16            CALL ASTRO_MUL_Q15
2808   11D4 EB                  EX DE,HL
2809   11D5 2A 47 89            LD HL,(AST_TMP4)
2810   11D8 B7                  OR A
2811   11D9 ED 52               SBC HL,DE
2812   11DB 22 22 89            LD (AST_Y),HL
2813   11DE             
2814   11DE 2A 3F 89            LD HL,(AST_TMP0)
2815   11E1 11 EA 32            LD DE,OBL_SIN_Q15
2816   11E4 CD 34 16            CALL ASTRO_MUL_Q15
2817   11E7 22 47 89            LD (AST_TMP4),HL
2818   11EA 2A 24 89            LD HL,(AST_Z)
2819   11ED 11 6F 75            LD DE,OBL_COS_Q15
2820   11F0 CD 34 16            CALL ASTRO_MUL_Q15
2821   11F3 EB                  EX DE,HL
2822   11F4 2A 47 89            LD HL,(AST_TMP4)
2823   11F7 19                  ADD HL,DE
2824   11F8 22 24 89            LD (AST_Z),HL
2825   11FB C9                  RET
