8965   55A0 16 00               LD D,0
8966   55A2 19                  ADD HL,DE
8967   55A3 22 41 8A            LD (GPS_TMP_COORD_ANGLE10),HL
8968   55A6             
8969   55A6                     ; frac3 degrees = round(minute_milli / 60), 0..1000.
8970   55A6 2A 47 8A            LD HL,(GPS_TMP_MIN_MILLI)
8971   55A9 11 1E 00            LD DE,30
8972   55AC 19                  ADD HL,DE
8973   55AD CD CF 55            CALL GPS_DIV60_16
