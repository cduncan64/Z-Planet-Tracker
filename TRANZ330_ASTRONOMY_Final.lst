6810   45FA             G_EF_H0:
6811   45FA CD 34 16            CALL ASTRO_MUL_Q15
6812   45FD 22 31 89            LD (AST_HORIZON_Q),HL
6813   4600 CD D1 48            CALL G_SET_LST0
6814   4603             
6815   4603                     ; V11d11o: find SET first with the proven V11d11n coarse-to-fine
6816   4603                     ; search.  Then use that known SET as the anchor for RISE instead of
6817   4603                     ; starting a second independent search from NOW.
6818   4603                     ;
6819   4603                     ; RISE seed sequence requested after hardware timing tests:
6820   4603                     ;       SET + 10 hours
6821   4603                     ;       SET + 11 hours
6822   4603                     ;       SET + 12 hours ...
6823   4603                     ; in one-hour steps until elevation changes from negative to
6824   4603                     ; nonnegative.  That brackets RISE inside one hour.  The existing
6825   4603                     ; 30/15/5/1-minute polarity refinement then finds the minute.
6826   4603                     ;
6827   4603                     ; If SET+10 is already nonnegative (unusual geometry) or SET was not
6828   4603                     ; found, fall back to the independent V11d11n RISE search so this
6829   4603                     ; optimization cannot silently lose an event.
6830   4603 CD 1B 46            CALL G_EF_NOW_MIN
6831   4606 22 CB 8A            LD (G_EDU_MIN),HL
6832   4609 3E 01               LD A,1
6833   460B 32 D0 8A            LD (G_EDU_MODE),A
6834   460E CD 84 46            CALL G_EF_EDU_SEARCH
6835   4611 22 28 89            LD (AST_SET),HL
6836   4614             
6837   4614 CD 37 46            CALL G_EF_RISE_FROM_SET
6838   4617 22 26 89            LD (AST_RISE),HL
6839   461A             
6840   461A                     ; V11d11q: TRANSIT removed.  Rise and set are the only timed events.
6841   461A C9                  RET
6842   461B             
6843   461B             ; Return NOW as local minute-of-day in HL.
6844   461B             G_EF_NOW_MIN:
6845   461B 3A 04 89            LD A,(AST_HOUR)
6846   461E 26 00               LD H,0
6847   4620 6F                  LD L,A
6848   4621 E5                  PUSH HL
6849   4622 29                  ADD HL,HL
6850   4623 29                  ADD HL,HL
6851   4624 EB                  EX DE,HL
6852   4625 E1                  POP HL
6853   4626 29                  ADD HL,HL
6854   4627 29                  ADD HL,HL
6855   4628 29                  ADD HL,HL
6856   4629 29                  ADD HL,HL
6857   462A 29                  ADD HL,HL
6858   462B 29                  ADD HL,HL
6859   462C B7                  OR A
6860   462D ED 52               SBC HL,DE                  ; hour*60
6861   462F 3A 05 89            LD A,(AST_MINUTE)
6862   4632 5F                  LD E,A
6863   4633 16 00               LD D,0
6864   4635 19                  ADD HL,DE
6865   4636 C9                  RET
6866   4637             
6867   4637             ; Find RISE from the SET time already calculated above.
6868   4637             ; First sample is SET+10 hours.  If still below the horizon, advance in
6869   4637             ; one-hour steps: +11h, +12h, ... until the sign changes.  On the crossing,
6870   4637             ; reuse the V11d11n 30/15/5/1-minute refinement path.
6871   4637             ; Return HL = local minute of RISE.
6872   4637             G_EF_RISE_FROM_SET:
6873   4637 2A 28 89            LD HL,(AST_SET)
6874   463A 7C                  LD A,H
6875   463B FE FF               CP $FF
6876   463D 28 37               JR Z,G_EF_RFS_FALLBACK
6877   463F             
6878   463F                     ; SET + 10 hours, wrapped into the local 0..1439 minute day.
6879   463F 11 58 02            LD DE,600
6880   4642 19                  ADD HL,DE
6881   4643 11 A0 05            LD DE,1440
6882   4646 B7                  OR A
6883   4647 ED 52               SBC HL,DE
6884   4649 30 01               JR NC,G_EF_RFS_SEED_OK
6885   464B 19                  ADD HL,DE
6886   464C             G_EF_RFS_SEED_OK:
6887   464C 22 CB 8A            LD (G_EDU_MIN),HL
6888   464F                     ; Only above/below is needed at this seed.  Use the fast UP-only
6889   464F                     ; path rather than computing east/north, sqrt and atan elevation.
6890   464F CD 00 48            CALL G_EF_SIGN_AT_MIN
6891   4652 B7                  OR A
6892   4653 20 21               JR NZ,G_EF_RFS_FALLBACK     ; rise happened before SET+10: use safe path
6893   4655             
6894   4655                     ; We are below the horizon at SET+10.  Lock forward direction and
6895   4655                     ; walk one hour at a time until negative -> nonnegative crossing.
6896   4655 AF                  XOR A
6897   4656 32 D6 8A            LD (G_EDU_PREV_SIGN),A
6898   4659 32 D3 8A            LD (G_EDU_DIR),A             ; forward/add
6899   465C 21 3C 00            LD HL,60
6900   465F 22 D1 8A            LD (G_EDU_STEP),HL
6901   4662 3E 0E               LD A,14                      ; +11 through +24 hours maximum guard
6902   4664 32 CF 8A            LD (G_EDU_COUNT),A
6903   4667             G_EF_RFS_HOUR_LOOP:
6904   4667 CD 70 47            CALL G_EF_TRY_STEP_FAST
6905   466A DA FC 46            JP C,G_EF_BIG_CROSSED        ; bracketed: refine 30/15/5/1 minutes
6906   466D 3A CF 8A            LD A,(G_EDU_COUNT)
6907   4670 3D                  DEC A
6908   4671 32 CF 8A            LD (G_EDU_COUNT),A
6909   4674 20 F1               JR NZ,G_EF_RFS_HOUR_LOOP
6910   4676             
6911   4676                     ; Defensive fallback if no rise was bracketed within a full day.
6912   4676             G_EF_RFS_FALLBACK:
6913   4676 CD 1B 46            CALL G_EF_NOW_MIN
6914   4679 22 CB 8A            LD (G_EDU_MIN),HL
6915   467C AF                  XOR A
6916   467D 32 D0 8A            LD (G_EDU_MODE),A            ; RISE
6917   4680 CD 84 46            CALL G_EF_EDU_SEARCH
6918   4683 C9                  RET
6919   4684             
6920   4684             ; Coarse-to-fine horizon search. G_EDU_MODE: 0 rise, 1 set.
6921   4684             ; Direction is chosen ONCE from the initial elevation and never changes:
6922   4684             ;   RISE: EL<0 forward (WILL RISE), EL>=0 backward (HAS RISEN)
6923   4684             ;   SET : EL>=0 forward (WILL SET), EL<0 backward (HAS SET)
6924   4684             ;
6925   4684             ; Search sequence requested for V11d11n:
6926   4684             ;   >=15 deg : educated |EL|/15-hour jump(s)
6927   4684             ;   inside +/-15 deg: one 30-minute check
6928   4684             ;   if no crossing: one 15-minute check
6929   4684             ;   if no crossing: one 5-minute check
6930   4684             ;   then 1-minute checks until polarity changes.
6931   4684             ; A polarity change is tested after EVERY trial. If a coarse trial crosses,
6932   4684             ; restore the pre-crossing minute and continue with the next finer step.
6933   4684             G_EF_EDU_SEARCH:
6934   4684 3E 60               LD A,96                    ; hard safety guard, mainly for 1-min tail
6935   4686 32 CF 8A            LD (G_EDU_COUNT),A
6936   4689             
6937   4689                     ; Evaluate starting point and save its polarity.
6938   4689 2A CB 8A            LD HL,(G_EDU_MIN)
6939   468C CD 58 48            CALL G_EF_ELEV_AT_MIN
6940   468F 22 CD 8A            LD (G_EDU_EL10),HL
6941   4692 CD 67 47            CALL G_EF_SIGN_HL
6942   4695 32 D6 8A            LD (G_EDU_PREV_SIGN),A
6943   4698             
6944   4698                     ; Lock search direction from MODE + initial sign.
6945   4698                     ; DIR 0=forward/add, 1=backward/subtract.
6946   4698 47                  LD B,A                     ; B = initial sign: 0 neg, 1 nonneg
6947   4699 3A D0 8A            LD A,(G_EDU_MODE)
6948   469C B7                  OR A
6949   469D 20 06               JR NZ,G_EF_DIR_SET
6950   469F                     ; rise: negative -> forward, nonnegative -> backward
6951   469F 78                  LD A,B
6952   46A0 B7                  OR A
6953   46A1 28 0D               JR Z,G_EF_DIR_FWD
6954   46A3 18 04               JR G_EF_DIR_BACK
6955   46A5             G_EF_DIR_SET:
6956   46A5                     ; set: nonnegative -> forward, negative -> backward
6957   46A5 78                  LD A,B
6958   46A6 B7                  OR A
6959   46A7 20 07               JR NZ,G_EF_DIR_FWD
6960   46A9             G_EF_DIR_BACK:
6961   46A9 3E 01               LD A,1
6962   46AB 32 D3 8A            LD (G_EDU_DIR),A
6963   46AE 18 04               JR G_EF_BIG_TEST
6964   46B0             G_EF_DIR_FWD:
6965   46B0 AF                  XOR A
6966   46B1 32 D3 8A            LD (G_EDU_DIR),A
6967   46B4             
6968   46B4             G_EF_BIG_TEST:
6969   46B4                     ; If abs(EL) < 15 degrees, begin the fixed 30/15/5/1 sequence.
6970   46B4 2A CD 8A            LD HL,(G_EDU_EL10)
6971   46B7 CB 7C               BIT 7,H
6972   46B9 28 03               JR Z,G_EF_BIG_ABS_OK
6973   46BB CD CF 19            CALL ASTRO_NEG_HL
6974   46BE             G_EF_BIG_ABS_OK:
6975   46BE 11 96 00            LD DE,150
6976   46C1 B7                  OR A
6977   46C2 ED 52               SBC HL,DE
6978   46C4 DA 1C 47            JP C,G_EF_PHASE30
6979   46C7             
6980   46C7                     ; Educated jump = round(abs(EL)/15) whole hours, minimum one hour.
6981   46C7 2A CD 8A            LD HL,(G_EDU_EL10)
6982   46CA CB 7C               BIT 7,H
6983   46CC 28 03               JR Z,G_EF_BIG_ABS2
6984   46CE CD CF 19            CALL ASTRO_NEG_HL
6985   46D1             G_EF_BIG_ABS2:
6986   46D1 11 4B 00            LD DE,75
6987   46D4 19                  ADD HL,DE
6988   46D5 06 00               LD B,0
6989   46D7             G_EF_BIG_DIV150:
6990   46D7 11 96 00            LD DE,150
6991   46DA B7                  OR A
6992   46DB ED 52               SBC HL,DE
6993   46DD 38 03               JR C,G_EF_BIG_DIV_DONE
6994   46DF 04                  INC B
6995   46E0 18 F5               JR G_EF_BIG_DIV150
6996   46E2             G_EF_BIG_DIV_DONE:
6997   46E2 78                  LD A,B
6998   46E3 B7                  OR A
6999   46E4 20 01               JR NZ,G_EF_BIG_HOURS_OK
7000   46E6 04                  INC B
7001   46E7             G_EF_BIG_HOURS_OK:
7002   46E7 21 00 00            LD HL,0
7003   46EA 11 3C 00            LD DE,60
7004   46ED             G_EF_BIG_MUL60:
7005   46ED 19                  ADD HL,DE
7006   46EE 10 FD               DJNZ G_EF_BIG_MUL60
7007   46F0 22 D1 8A            LD (G_EDU_STEP),HL
7008   46F3                     ; The educated-jump loop still needs the actual elevation magnitude
7009   46F3                     ; to choose its next |EL|/15-hour jump, so keep the full calculation.
7010   46F3 CD B5 47            CALL G_EF_TRY_STEP_FULL
7011   46F6 DA FC 46            JP C,G_EF_BIG_CROSSED
7012   46F9 C3 B4 46            JP G_EF_BIG_TEST
7013   46FC             
7014   46FC             G_EF_BIG_CROSSED:
7015   46FC                     ; The large jump bracketed the horizon. Go back to the old side and
7016   46FC                     ; approach it in 30-minute increments before the finer checks.
7017   46FC 2A D4 8A            LD HL,(G_EDU_PREV_MIN)
7018   46FF 22 CB 8A            LD (G_EDU_MIN),HL
7019   4702 3A D6 8A            LD A,(G_EDU_PREV_SIGN)
7020   4705 32 D6 8A            LD (G_EDU_PREV_SIGN),A
7021   4708             G_EF_BIG_30_LOOP:
7022   4708 21 1E 00            LD HL,30
7023   470B 22 D1 8A            LD (G_EDU_STEP),HL
7024   470E CD 70 47            CALL G_EF_TRY_STEP_FAST
7025   4711 30 F5               JR NC,G_EF_BIG_30_LOOP
7026   4713 2A D4 8A            LD HL,(G_EDU_PREV_MIN)
7027   4716 22 CB 8A            LD (G_EDU_MIN),HL
7028   4719 C3 2D 47            JP G_EF_PHASE15
7029   471C             
7030   471C             G_EF_PHASE30:
7031   471C 21 1E 00            LD HL,30
7032   471F 22 D1 8A            LD (G_EDU_STEP),HL
7033   4722 CD 70 47            CALL G_EF_TRY_STEP_FAST
7034   4725 30 06               JR NC,G_EF_PHASE15
7035   4727 2A D4 8A            LD HL,(G_EDU_PREV_MIN)
7036   472A 22 CB 8A            LD (G_EDU_MIN),HL
7037   472D             
7038   472D             G_EF_PHASE15:
7039   472D 21 0F 00            LD HL,15
7040   4730 22 D1 8A            LD (G_EDU_STEP),HL
7041   4733 CD 70 47            CALL G_EF_TRY_STEP_FAST
7042   4736 30 06               JR NC,G_EF_PHASE5
7043   4738 2A D4 8A            LD HL,(G_EDU_PREV_MIN)
7044   473B 22 CB 8A            LD (G_EDU_MIN),HL
7045   473E             
7046   473E             G_EF_PHASE5:
7047   473E 21 05 00            LD HL,5
7048   4741 22 D1 8A            LD (G_EDU_STEP),HL
7049   4744 CD 70 47            CALL G_EF_TRY_STEP_FAST
7050   4747 30 06               JR NC,G_EF_PHASE1
7051   4749 2A D4 8A            LD HL,(G_EDU_PREV_MIN)
7052   474C 22 CB 8A            LD (G_EDU_MIN),HL
7053   474F             
7054   474F             G_EF_PHASE1:
7055   474F 21 01 00            LD HL,1
7056   4752 22 D1 8A            LD (G_EDU_STEP),HL
7057   4755             G_EF_ONE_LOOP:
7058   4755 CD 70 47            CALL G_EF_TRY_STEP_FAST
7059   4758 38 09               JR C,G_EF_ES_DONE
7060   475A 3A CF 8A            LD A,(G_EDU_COUNT)
7061   475D 3D                  DEC A
7062   475E 32 CF 8A            LD (G_EDU_COUNT),A
7063   4761 20 F2               JR NZ,G_EF_ONE_LOOP
7064   4763                     ; Defensive safety exit if no crossing appeared in the 1-minute tail.
7065   4763             G_EF_ES_DONE:
7066   4763 2A CB 8A            LD HL,(G_EDU_MIN)
7067   4766 C9                  RET
7068   4767             
7069   4767             ; Return A=0 for negative HL, A=1 for zero/positive HL.
7070   4767             G_EF_SIGN_HL:
7071   4767 CB 7C               BIT 7,H
7072   4769 28 02               JR Z,G_EF_SIGN_POS
7073   476B AF                  XOR A
7074   476C C9                  RET
7075   476D             G_EF_SIGN_POS:
7076   476D 3E 01               LD A,1
7077   476F C9                  RET
7078   4770             
7079   4770             ; Fast trial used once a crossing search only needs polarity.  This is
7080   4770             ; mathematically equivalent to testing the sign of elevation because
7081   4770             ; atan2(UP,horizontal) has the same sign as UP.  It deliberately avoids
7082   4770             ; EAST, NORTH, squares, integer square root, and atan2.
7083   4770             G_EF_TRY_STEP_FAST:
7084   4770 2A CB 8A            LD HL,(G_EDU_MIN)
7085   4773 22 D4 8A            LD (G_EDU_PREV_MIN),HL
7086   4776 3A D6 8A            LD A,(G_EDU_PREV_SIGN)
7087   4779 F5                  PUSH AF
7088   477A             
7089   477A 3A D3 8A            LD A,(G_EDU_DIR)
7090   477D B7                  OR A
7091   477E 20 12               JR NZ,G_EF_FAST_SUB
7092   4780             G_EF_FAST_ADD:
7093   4780 ED 5B D1 8A         LD DE,(G_EDU_STEP)
7094   4784 19                  ADD HL,DE
7095   4785 11 A0 05            LD DE,1440
7096   4788 B7                  OR A
7097   4789 ED 52               SBC HL,DE
7098   478B 38 02               JR C,G_EF_FAST_ADD_RESTORE
7099   478D 18 10               JR G_EF_FAST_STORE
7100   478F             G_EF_FAST_ADD_RESTORE:
7101   478F 19                  ADD HL,DE
7102   4790 18 0D               JR G_EF_FAST_STORE
7103   4792             G_EF_FAST_SUB:
