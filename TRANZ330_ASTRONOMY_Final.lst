3775   180F             ; ATAN2
3776   180F             ; ============================================================================
3777   180F             
3778   180F             ; HL=y signed, DE=x signed.
3779   180F             ; Return HL=0..3599, 0=N/+x axis in mathematical atan2 convention.
3780   180F             ; Caller passes east as y, north as x, therefore result is azimuth from north.
3781   180F             ASTRO_ATAN2_10:
3782   180F 22 3F 89            LD (AST_TMP0),HL           ; y
3783   1812 ED 53 41 89         LD (AST_TMP1),DE           ; x
