7221   484F 2A 8F 89            LD HL,(G_TMPW1)
7222   4852 19                  ADD HL,DE
7223   4853 22 3B 89            LD (AST_UP),HL
7224   4856 E1                  POP HL
7225   4857 C9                  RET
7226   4858             
7227   4858             ; HL=local minute, fixed AST_X/Y/Z vector.  Return signed elevation in
7228   4858             ; tenths of a degree.  Used only where the educated coarse jump needs |EL|.
7229   4858             G_EF_ELEV_AT_MIN:
7230   4858 CD 82 49            CALL G_HORIZONTAL_FOR_VECTOR
