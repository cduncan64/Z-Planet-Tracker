6558   43AC 2A 8D 89            LD HL,(G_TMPW0)
6559   43AF B7                  OR A
6560   43B0 ED 52               SBC HL,DE
6561   43B2 22 C6 89            LD (G_SX),HL
6562   43B5 2A CA 89            LD HL,(G_XV)
6563   43B8 ED 5B 93 89         LD DE,(G_TMPW3)
6564   43BC CD 34 16            CALL ASTRO_MUL_Q15
6565   43BF 22 8D 89            LD (G_TMPW0),HL
6566   43C2 2A CC 89            LD HL,(G_YV)
6567   43C5 ED 5B 91 89         LD DE,(G_TMPW2)
6568   43C9 CD 34 16            CALL ASTRO_MUL_Q15
6569   43CC EB                  EX DE,HL
6570   43CD 2A 8D 89            LD HL,(G_TMPW0)
6571   43D0 19                  ADD HL,DE
6572   43D1 22 C8 89            LD (G_SY),HL
