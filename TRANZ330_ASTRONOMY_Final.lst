3603   1706             ; 32-BIT DIVISION / SQUARE ROOT
3604   1706             ; ============================================================================
3605   1706             
3606   1706             ; Divide unsigned 32-bit M32_ACC by unsigned HL.
3607   1706             ; Returns 16-bit quotient HL.  Used where quotient is known to fit 16 bits.
3608   1706             ASTRO_DIV32_BY_16:
3609   1706                     ; PURE Z80 FAST exact 32/16 divide for the existing contract that the
3610   1706                     ; quotient fits in 16 bits.  In that case numerator high word < divisor,
3611   1706                     ; so seed the remainder with the high word and process only the low 16 bits.
3612   1706 22 3F 89            LD (AST_TMP0),HL           ; divisor
3613   1709 ED 5B 60 89         LD DE,(M32_ACC+2)          ; initial remainder = numerator high word
3614   170D 2A 5E 89            LD HL,(M32_ACC)            ; low numerator; becomes quotient in-place
3615   1710 3E 10               LD A,16
3616   1712             AD3216_FAST_LOOP:
3617   1712 29                  ADD HL,HL                  ; next numerator bit -> carry; quotient <<= 1
3618   1713 CB 13               RL E
3619   1715 CB 12               RL D                       ; remainder = remainder*2 + input bit
3620   1717 E5                  PUSH HL
3621   1718 62                  LD H,D
3622   1719 6B                  LD L,E
3623   171A ED 4B 3F 89         LD BC,(AST_TMP0)
3624   171E B7                  OR A
3625   171F ED 42               SBC HL,BC
3626   1721 38 06               JR C,AD3216_FAST_NOSUB
3627   1723 54                  LD D,H
3628   1724 5D                  LD E,L
3629   1725 E1                  POP HL
3630   1726 2C                  INC L                      ; set quotient bit 0 (shift made it zero)
3631   1727 18 01               JR AD3216_FAST_NEXT
3632   1729             AD3216_FAST_NOSUB:
3633   1729 E1                  POP HL
3634   172A             AD3216_FAST_NEXT:
3635   172A 3D                  DEC A
3636   172B 20 E5               JR NZ,AD3216_FAST_LOOP
3637   172D C9                  RET
3638   172E             
3639   172E             ; Square signed HL. Returns unsigned square in M32_ACC.
