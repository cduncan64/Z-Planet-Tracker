5298   3B01 CD 48 06            CALL DISPLAY_PRINT_Z
5299   3B04 21 80 1A            LD HL,MSG_START_TIME_MASK
5300   3B07             G_PRS_FORMAT:
5301   3B07 11 50 89            LD DE,AST_INPUT
5302   3B0A 3A 56 89            LD A,(AST_INCOUNT)
5303   3B0D 32 49 89            LD (AST_TMP5),A
5304   3B10 06 08               LD B,8
