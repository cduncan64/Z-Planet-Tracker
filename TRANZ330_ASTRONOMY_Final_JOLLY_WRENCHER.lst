2759   1167 22 41 89            LD (AST_TMP1),HL           ; xh
2760   116A             
2761   116A                     ; yh = x1*sinN + y1*cosi*cosN
2762   116A 2A 43 89            LD HL,(AST_TMP2)
2763   116D ED 5B 49 89         LD DE,(AST_TMP5)
2764   1171 CD 34 16            CALL ASTRO_MUL_Q15
2765   1174 22 3F 89            LD (AST_TMP0),HL
2766   1177 2A 45 89            LD HL,(AST_TMP3)
2767   117A ED 5B 4B 89         LD DE,(AST_TMP6)
2768   117E CD 34 16            CALL ASTRO_MUL_Q15
2769   1181 ED 5B 47 89         LD DE,(AST_TMP4)
2770   1185 CD 34 16            CALL ASTRO_MUL_Q15
2771   1188 EB                  EX DE,HL
2772   1189 2A 3F 89            LD HL,(AST_TMP0)
2773   118C 19                  ADD HL,DE
2774   118D 22 3F 89            LD (AST_TMP0),HL           ; yh
2775   1190             
2776   1190                     ; zh = y1*sin i
2777   1190 2A 45 89            LD HL,(AST_TMP3)
2778   1193 ED 5B 4D 89         LD DE,(AST_TMP7)
2779   1197 CD 34 16            CALL ASTRO_MUL_Q15
2780   119A 22 24 89            LD (AST_Z),HL              ; zh; preserve across perturbation scratch
2781   119D             
2782   119D                     ; Apply Jupiter/Saturn longitude perturbation.
2783   119D                     ; Returns HL = signed perturbation in tenths degree.
2784   119D CD 5E 12            CALL ASTRO_JUP_PERTURB
2785   11A0 CD FC 11            CALL ASTRO_ROTATE_PERTURB_SAFE
2786   11A3             
2787   11A3                     ; Geocentric ecliptic = Jupiter heliocentric + Sun geocentric.
2788   11A3 2A 20 89            LD HL,(AST_X)              ; xs
2789   11A6 ED 5B 41 89         LD DE,(AST_TMP1)           ; xh
2790   11AA 19                  ADD HL,DE
2791   11AB 22 41 89            LD (AST_TMP1),HL           ; xg
2792   11AE 2A 22 89            LD HL,(AST_Y)              ; ys
2793   11B1 ED 5B 3F 89         LD DE,(AST_TMP0)           ; yh
2794   11B5 19                  ADD HL,DE
2795   11B6 22 3F 89            LD (AST_TMP0),HL           ; yg
2796   11B9                     ; zg = zh already preserved in AST_Z
2797   11B9             
2798   11B9                     ; Ecliptic -> equatorial.
2799   11B9 2A 41 89            LD HL,(AST_TMP1)
2800   11BC 22 20 89            LD (AST_X),HL
2801   11BF             
2802   11BF 2A 3F 89            LD HL,(AST_TMP0)
2803   11C2 11 6F 75            LD DE,OBL_COS_Q15
2804   11C5 CD 34 16            CALL ASTRO_MUL_Q15
2805   11C8 22 47 89            LD (AST_TMP4),HL
2806   11CB 2A 24 89            LD HL,(AST_Z)
2807   11CE 11 EA 32            LD DE,OBL_SIN_Q15
2808   11D1 CD 34 16            CALL ASTRO_MUL_Q15
2809   11D4 EB                  EX DE,HL
2810   11D5 2A 47 89            LD HL,(AST_TMP4)
2811   11D8 B7                  OR A
2812   11D9 ED 52               SBC HL,DE
2813   11DB 22 22 89            LD (AST_Y),HL
2814   11DE             
2815   11DE 2A 3F 89            LD HL,(AST_TMP0)
2816   11E1 11 EA 32            LD DE,OBL_SIN_Q15
2817   11E4 CD 34 16            CALL ASTRO_MUL_Q15
2818   11E7 22 47 89            LD (AST_TMP4),HL
2819   11EA 2A 24 89            LD HL,(AST_Z)
2820   11ED 11 6F 75            LD DE,OBL_COS_Q15
2821   11F0 CD 34 16            CALL ASTRO_MUL_Q15
2822   11F3 EB                  EX DE,HL
2823   11F4 2A 47 89            LD HL,(AST_TMP4)
2824   11F7 19                  ADD HL,DE
2825   11F8 22 24 89            LD (AST_Z),HL
2826   11FB C9                  RET
