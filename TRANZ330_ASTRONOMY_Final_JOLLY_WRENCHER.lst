5215   3A87 32 A3 8A            LD (G_PRINT_UTC_MONTH),A
5216   3A8A 3A 03 89            LD A,(AST_DAY)
5217   3A8D 32 A4 8A            LD (G_PRINT_UTC_DAY),A
5218   3A90             
5219   3A90             G_PF_TIME:
5220   3A90 3E 01               LD A,1
5221   3A92 32 4F 89            LD (AST_INPUT_MODE),A
5222   3A95 CD E6 3A            CALL G_PRINT_READ_SIX
5223   3A98 38 43               JR C,G_PF_CANCEL
5224   3A9A CD 86 0A            CALL ASI_PARSE_TIME
5225   3A9D 38 F1               JR C,G_PF_TIME
5226   3A9F             
