4425   36E3             ; User-facing objects
4426   36E3             G_OBJ_MERCURY   EQU 0
4427   36E3             G_OBJ_VENUS     EQU 1
4428   36E3             G_OBJ_SUN       EQU 2
4429   36E3             G_OBJ_MARS      EQU 3
