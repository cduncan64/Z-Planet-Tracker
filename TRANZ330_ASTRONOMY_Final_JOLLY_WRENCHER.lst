5481   3C8B             
5482   3C8B             ; ---------------------------------------------------------------------------
5483   3C8B             ; Printer serial layer.
5484   3C8B             ;
5485   3C8B             ; IMPORTANT: the rear TRANZ serial connector used by our proven GPS/PC bridge
5486   3C8B             ; is DART B ($22 data / $23 control).  DART A is the internal modem/debug path
5487   3C8B             ; and must NOT be used for the external Printer 250.
5488   3C8B             ;
5489   3C8B             ; DART B is already initialized at startup for the hardware-proven 9600 8-N-1
5490   3C8B             ; GPS link.  Printing therefore uses only the DART-B transmitter; no baud-rate
5491   3C8B             ; or CTC reconfiguration is needed.  GPS acquisition is complete before the
5492   3C8B             ; print UI can be reached, so transmitting a report cannot disturb an active
5493   3C8B             ; startup acquisition.
5494   3C8B             ;
5495   3C8B             ; A short inter-character delay is provided so a report remains conservative
5496   3C8B             ; even if hardware flow control is not present in the particular printer cable.
5497   3C8B             ; ---------------------------------------------------------------------------
5498   3C8B             ; ===========================================================================
5499   3C8B             ; r22: Centered Jolly Wrencher 113x56 at start of astronomy report.
5500   3C8B             ; Original PC-tested transmission protocol: CAN, FS, ESC g; 13 blanks + 10 odd + $24,
5501   3C8B             ; 13 blanks + 10 even + $21 per row, 150ms after each pass, CAN to exit.
5502   3C8B             ; Bitmap rows are bottom-up to match the PC-tested BMP sender.
5503   3C8B             ; G_PRN_TX_CHAR already paces every byte by approximately 12ms.
5504   3C8B             ; ===========================================================================
5505   3C8B             G_PRN_JOLLY_WRENCHER:
5506   3C8B F5                  PUSH AF
5507   3C8C C5                  PUSH BC
5508   3C8D D5                  PUSH DE
5509   3C8E E5                  PUSH HL
5510   3C8F 3E 18               LD A,$18
5511   3C91 CD 55 41            CALL G_PRN_TX_CHAR
5512   3C94 3E 1C               LD A,$1C
5513   3C96 CD 55 41            CALL G_PRN_TX_CHAR
5514   3C99 3E 1B               LD A,$1B
5515   3C9B CD 55 41            CALL G_PRN_TX_CHAR
5516   3C9E 3E 67               LD A,$67
5517   3CA0 CD 55 41            CALL G_PRN_TX_CHAR
5518   3CA3 21 F3 3C            LD HL,G_JW_BITMAP
5519   3CA6 0E 38               LD C,56
5520   3CA8             G_JW_ROW:
5521   3CA8 CD DD 3C            CALL G_JW_LEFT_MARGIN
5522   3CAB 06 0A               LD B,10
5523   3CAD             G_JW_ODD:
5524   3CAD 7E                  LD A,(HL)
5525   3CAE CD 55 41            CALL G_PRN_TX_CHAR
5526   3CB1 23                  INC HL
5527   3CB2 10 F9               DJNZ G_JW_ODD
5528   3CB4 3E 24               LD A,$24
5529   3CB6 CD 55 41            CALL G_PRN_TX_CHAR
5530   3CB9 CD E9 3C            CALL G_JW_PASS_PAUSE
5531   3CBC CD DD 3C            CALL G_JW_LEFT_MARGIN
5532   3CBF 06 0A               LD B,10
5533   3CC1             G_JW_EVEN:
5534   3CC1 7E                  LD A,(HL)
5535   3CC2 CD 55 41            CALL G_PRN_TX_CHAR
5536   3CC5 23                  INC HL
5537   3CC6 10 F9               DJNZ G_JW_EVEN
5538   3CC8 3E 21               LD A,$21
5539   3CCA CD 55 41            CALL G_PRN_TX_CHAR
5540   3CCD CD E9 3C            CALL G_JW_PASS_PAUSE
5541   3CD0 0D                  DEC C
5542   3CD1 20 D5               JR NZ,G_JW_ROW
5543   3CD3 3E 18               LD A,$18
5544   3CD5 CD 55 41            CALL G_PRN_TX_CHAR
5545   3CD8 E1                  POP HL
5546   3CD9 D1                  POP DE
5547   3CDA C1                  POP BC
5548   3CDB F1                  POP AF
5549   3CDC C9                  RET
5550   3CDD             
5551   3CDD             ; 13 blank six-dot characters per pass = 78 positions per pass,
5552   3CDD             ; or 156 horizontal dots across the interleaved 420-dot print width.
5553   3CDD             ; 113-pixel image: left 156 dots, right 151 dots (within 2.5 dots of center).
5554   3CDD             ; Uses $40 as blank graphics data; no bitmap expansion required.
5555   3CDD             G_JW_LEFT_MARGIN:
5556   3CDD C5                  PUSH BC
5557   3CDE 06 0D               LD B,13
5558   3CE0             G_JW_MARGIN_LOOP:
5559   3CE0 3E 40               LD A,$40
5560   3CE2 CD 55 41            CALL G_PRN_TX_CHAR
5561   3CE5 10 F9               DJNZ G_JW_MARGIN_LOOP
5562   3CE7 C1                  POP BC
5563   3CE8 C9                  RET
5564   3CE9             
5565   3CE9             G_JW_PASS_PAUSE:
5566   3CE9 C5                  PUSH BC
5567   3CEA 06 4B               LD B,75
5568   3CEC             G_JW_PAUSE_LOOP:
5569   3CEC CD B2 06            CALL DELAY_2MS
5570   3CEF 10 FB               DJNZ G_JW_PAUSE_LOOP
5571   3CF1 C1                  POP BC
5572   3CF2 C9                  RET
