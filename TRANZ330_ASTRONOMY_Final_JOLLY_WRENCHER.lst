3728   17BD             ; Compare M32_ACC with M32_N.
3729   17BD             ; Carry set if ACC > N; carry clear otherwise.
3730   17BD             ASTRO_CMP_ACC_N:
3731   17BD 3A 65 89            LD A,(M32_N+3)
