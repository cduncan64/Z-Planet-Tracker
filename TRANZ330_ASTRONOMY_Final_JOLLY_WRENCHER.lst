4525   36E3             G_SITE_LAT_SIN_Q15    EQU G_RAM+148
4526   36E3             G_SITE_LAT_COS_Q15    EQU G_RAM+150
4527   36E3             GPS_UTC_YEAR          EQU G_RAM+152
4528   36E3             GPS_UTC_MONTH         EQU G_RAM+153
4529   36E3             GPS_UTC_DAY           EQU G_RAM+154
4530   36E3             GPS_UTC_HOUR          EQU G_RAM+155
4531   36E3             GPS_UTC_MINUTE        EQU G_RAM+156
4532   36E3             GPS_UTC_SECOND        EQU G_RAM+157
4533   36E3             GPS_SITE_LAT_DEG      EQU G_RAM+158
4534   36E3             GPS_SITE_LAT_FRAC3    EQU G_RAM+159  ; word 000..999
4535   36E3             GPS_SITE_LAT_HEMI     EQU G_RAM+161
4536   36E3             GPS_SITE_LON_DEG      EQU G_RAM+162
4537   36E3             GPS_SITE_LON_FRAC3    EQU G_RAM+163  ; word 000..999
4538   36E3             GPS_SITE_LON_HEMI     EQU G_RAM+165
4539   36E3             GPS_COLLECTING        EQU G_RAM+166
4540   36E3             GPS_INDEX             EQU G_RAM+167
4541   36E3             GPS_FIX_READY         EQU G_RAM+168
4542   36E3             GPS_RX_SAVED          EQU G_RAM+169
4543   36E3             GPS_FIELD_PTR         EQU G_RAM+170  ; word
4544   36E3             GPS_TMP_UTC_YEAR      EQU G_RAM+172
4545   36E3             GPS_TMP_UTC_MONTH     EQU G_RAM+173
4546   36E3             GPS_TMP_UTC_DAY       EQU G_RAM+174
4547   36E3             GPS_TMP_UTC_HOUR      EQU G_RAM+175
4548   36E3             GPS_TMP_UTC_MIN       EQU G_RAM+176
4549   36E3             GPS_TMP_UTC_SEC       EQU G_RAM+177
4550   36E3             GPS_TMP_LAT_DEG       EQU G_RAM+178
4551   36E3             GPS_TMP_LAT_FRAC3     EQU G_RAM+179  ; word
4552   36E3             GPS_TMP_LAT_HEMI      EQU G_RAM+181
4553   36E3             GPS_TMP_LON_DEG       EQU G_RAM+182
4554   36E3             GPS_TMP_LON_FRAC3     EQU G_RAM+183  ; word
4555   36E3             GPS_TMP_LON_HEMI      EQU G_RAM+185
4556   36E3             GPS_TMP_LAT10         EQU G_RAM+186  ; word
4557   36E3             GPS_TMP_LON10         EQU G_RAM+188  ; word
4558   36E3             GPS_TMP_COORD_DEG     EQU G_RAM+190
4559   36E3             GPS_TMP_COORD_FRAC3   EQU G_RAM+191  ; word
4560   36E3             GPS_TMP_COORD_ANGLE10 EQU G_RAM+193  ; word
4561   36E3             GPS_TMP_MINUTES       EQU G_RAM+195
4562   36E3             GPS_TMP_F1            EQU G_RAM+196
4563   36E3             GPS_TMP_F2            EQU G_RAM+197
4564   36E3             GPS_TMP_F3            EQU G_RAM+198
4565   36E3             GPS_TMP_MIN_MILLI     EQU G_RAM+199  ; word
4566   36E3             GPS_TMP_COORD_ORIG_DEG EQU G_RAM+201
4567   36E3             ; RTC read staging uses the six-byte gap immediately before GPS_BUFFER.
4568   36E3             ; Values are committed to AST_* only after the complete RTC snapshot validates.
4569   36E3             RTC_TMP_YEAR          EQU G_RAM+202
4570   36E3             RTC_TMP_MONTH         EQU G_RAM+203
4571   36E3             RTC_TMP_DAY           EQU G_RAM+204
4572   36E3             RTC_TMP_HOUR          EQU G_RAM+205
4573   36E3             RTC_TMP_MINUTE        EQU G_RAM+206
4574   36E3             RTC_TMP_SECOND        EQU G_RAM+207
4575   36E3             GPS_BUFFER            EQU G_RAM+208  ; 80-byte sentence buffer through +287
4576   36E3             
4577   36E3             ; V11d11 print workflow state.  This starts immediately after the 80-byte
4578   36E3             ; GPS sentence buffer, so it does not overlap any existing V11d10b RAM.
4579   36E3             G_PRINT_CHOICE        EQU G_RAM+288  ; 0=NO, 1=YES
4580   36E3             G_PRINT_NOW           EQU G_RAM+289  ; 0=future entered UTC, 1=current result
4581   36E3             G_PRINT_UTC_YEAR      EQU G_RAM+290
4582   36E3             G_PRINT_UTC_MONTH     EQU G_RAM+291
4583   36E3             G_PRINT_UTC_DAY       EQU G_RAM+292
4584   36E3             G_PRINT_UTC_HOUR      EQU G_RAM+293
4585   36E3             G_PRINT_UTC_MINUTE    EQU G_RAM+294
4586   36E3             G_PRINT_UTC_SECOND    EQU G_RAM+295
4587   36E3             
4588   36E3             ; Timestamp captured at the instant the normal object calculation completes.
4589   36E3             ; This lets a later CURRENT printout report the time that actually belongs to
4590   36E3             ; the displayed AZ/EL result even if the user has since visited the live clock
4591   36E3             ; screens, which refresh AST_* from the RTC.
4592   36E3             G_CALC_YEAR           EQU G_RAM+296
4593   36E3             G_CALC_MONTH          EQU G_RAM+297
4594   36E3             G_CALC_DAY            EQU G_RAM+298
4595   36E3             G_CALC_HOUR           EQU G_RAM+299
4596   36E3             G_CALC_MINUTE         EQU G_RAM+300
4597   36E3             G_CALC_SECOND         EQU G_RAM+301
4598   36E3             
4599   36E3             ; Save area used only while a future-time print calculation is in progress.
4600   36E3             G_PR_SAVE_YEAR        EQU G_RAM+302
4601   36E3             G_PR_SAVE_MONTH       EQU G_RAM+303
4602   36E3             G_PR_SAVE_DAY         EQU G_RAM+304
4603   36E3             G_PR_SAVE_HOUR        EQU G_RAM+305
4604   36E3             G_SAVE_MINUTE         EQU G_RAM+306
4605   36E3             G_SAVE_SECOND         EQU G_RAM+307
4606   36E3             G_SAVE_RISE           EQU G_RAM+308  ; word
4607   36E3             G_SAVE_SET            EQU G_RAM+310  ; word
4608   36E3             G_SAVE_AZ10           EQU G_RAM+312  ; word
4609   36E3             G_SAVE_EL10           EQU G_RAM+314  ; word
4610   36E3             G_SAVE_VISIBLE        EQU G_RAM+316
4611   36E3             G_SAVE_TRANSIT        EQU G_RAM+317  ; word
4612   36E3             G_SAVE_PHASE          EQU G_RAM+319
4613   36E3             G_SAVE_PHASE_DIR      EQU G_RAM+320
4614   36E3             G_SAVE_MOON_LON       EQU G_RAM+321  ; word
4615   36E3             G_SAVE_SUN_LON        EQU G_RAM+323  ; word
4616   36E3             
4617   36E3             ; Temporary AST clock save used when converting the captured calculation
4618   36E3             ; timestamp from local civil time back to UTC for a CURRENT print report.
4619   36E3             G_TMP_YEAR            EQU G_RAM+325
4620   36E3             G_TMP_MONTH           EQU G_RAM+326
4621   36E3             G_TMP_DAY             EQU G_RAM+327
4622   36E3             G_TMP_HOUR            EQU G_RAM+328
4623   36E3             G_TMP_MINUTE          EQU G_RAM+329
4624   36E3             G_TMP_SECOND          EQU G_RAM+330
4625   36E3             
4626   36E3             ; V11d11n coarse-to-fine rise/set search scratch.
4627   36E3             G_EDU_MIN             EQU G_RAM+331  ; word: current guessed local minute
4628   36E3             G_EDU_EL10            EQU G_RAM+333  ; word: signed elevation, tenths deg
4629   36E3             G_EDU_COUNT           EQU G_RAM+335  ; byte: safety iteration counter
4630   36E3             G_EDU_MODE            EQU G_RAM+336  ; 0=rise, 1=set
4631   36E3             G_EDU_STEP            EQU G_RAM+337  ; word: step in minutes
4632   36E3             G_EDU_DIR             EQU G_RAM+339  ; 0=forward/add, 1=backward/subtract
4633   36E3             G_EDU_PREV_MIN        EQU G_RAM+340  ; word: minute before last trial step
4634   36E3             G_EDU_PREV_SIGN       EQU G_RAM+342  ; byte: 0=negative, 1=nonnegative
4635   36E3             
4636   36E3             ; Sun constants at 512 coordinate units/AU
4637   36E3             G_SUN_AQ        EQU 512
4638   36E3             G_SUN_AEQ       EQU 9
4639   36E3             G_SUN_BQ        EQU 512
4640   36E3             G_SUN_M0        EQU 3560
4641   36E3             G_SUN_MI        EQU 9
4642   36E3             G_SUN_MF        EQU 8560
4643   36E3             G_SUN_MX100     EQU 986
4644   36E3             G_SUN_W0        EQU 2829
4645   36E3             G_SUN_WR        EQU 5             ; 1e-4 tenth/day
4646   36E3             
4647   36E3             G_H0_PLANET     EQU -324          ; sin(-0.5667 deg) Q15
4648   36E3             G_H0_SUN        EQU -476          ; sin(-0.833 deg) Q15
4649   36E3             G_H0_MOON       EQU 71            ; sin(+0.125 deg) Q15
4650   36E3             
4651   36E3             ; ---------------------------------------------------------------------------
4652   36E3             ; MAIN USER INTERFACE
4653   36E3             ; ---------------------------------------------------------------------------
4654   36E3             G_ASTRO_MAIN:
4655   36E3             G_OBJECT_MENU:
4656   36E3 F3                  DI
4657   36E4 AF                  XOR A
4658   36E5 32 0B 8A            LD (G_PROGRESS),A
4659   36E8 21 94 5D            LD HL,GMSG_OPTION
4660   36EB CD 2E 06            CALL DISPLAY_SHOW
4661   36EE             G_OBJECT_WAIT:
4662   36EE CD 3E 02            CALL KEY_GET
4663   36F1 FE 0C               CP KEY_ALPHA
4664   36F3 CA F3 37            JP Z,G_FULL_RESET
4665   36F6 FE 04               CP KEY_CLEAR
4666   36F8 CA E3 36            JP Z,G_OBJECT_MENU
4667   36FB CD 59 02            CALL KEYCODE_TO_DIGIT
4668   36FE DA E3 36            JP C,G_OBJECT_MENU
4669   3701             
4670   3701                     ; 1 Mercury, 2 Venus, 3 Sun, 4 Mars, 5 Jupiter,
4671   3701                     ; 6 Saturn, 7 Uranus, 8 Neptune, 9 Pluto, 0 Moon.
4672   3701 B7                  OR A
4673   3702 CA 35 37            JP Z,G_SELECT_MOON
4674   3705 FE 01               CP 1
4675   3707 CA 39 37            JP Z,G_SELECT_MERCURY
4676   370A FE 02               CP 2
4677   370C CA 45 37            JP Z,G_SELECT_VENUS
4678   370F FE 03               CP 3
4679   3711 CA 41 37            JP Z,G_SELECT_SUN
4680   3714 FE 04               CP 4
4681   3716 CA 3D 37            JP Z,G_SELECT_MARS
4682   3719 FE 05               CP 5
4683   371B CA 49 37            JP Z,G_SELECT_JUPITER
4684   371E FE 06               CP 6
4685   3720 CA 4D 37            JP Z,G_SELECT_SATURN
4686   3723 FE 07               CP 7
4687   3725 CA 51 37            JP Z,G_SELECT_URANUS
4688   3728 FE 08               CP 8
4689   372A CA 55 37            JP Z,G_SELECT_NEPTUNE
4690   372D FE 09               CP 9
4691   372F CA 59 37            JP Z,G_SELECT_PLUTO
4692   3732 C3 E3 36            JP G_OBJECT_MENU
4693   3735             
4694   3735 3E 09       G_SELECT_MOON:     LD A,G_OBJ_MOON
4695   3737 18 22                          JR G_STORE_OBJECT
4696   3739 3E 00       G_SELECT_MERCURY:  LD A,G_OBJ_MERCURY
4697   373B 18 1E                          JR G_STORE_OBJECT
4698   373D 3E 03       G_SELECT_MARS:     LD A,G_OBJ_MARS
4699   373F 18 1A                          JR G_STORE_OBJECT
4700   3741 3E 02       G_SELECT_SUN:      LD A,G_OBJ_SUN
4701   3743 18 16                          JR G_STORE_OBJECT
4702   3745 3E 01       G_SELECT_VENUS:    LD A,G_OBJ_VENUS
4703   3747 18 12                          JR G_STORE_OBJECT
4704   3749 3E 04       G_SELECT_JUPITER:  LD A,G_OBJ_JUPITER
4705   374B 18 0E                          JR G_STORE_OBJECT
4706   374D 3E 05       G_SELECT_SATURN:   LD A,G_OBJ_SATURN
4707   374F 18 0A                          JR G_STORE_OBJECT
4708   3751 3E 06       G_SELECT_URANUS:   LD A,G_OBJ_URANUS
4709   3753 18 06                          JR G_STORE_OBJECT
4710   3755 3E 07       G_SELECT_NEPTUNE:  LD A,G_OBJ_NEPTUNE
4711   3757 18 02                          JR G_STORE_OBJECT
4712   3759 3E 08       G_SELECT_PLUTO:    LD A,G_OBJ_PLUTO
4713   375B             
4714   375B             G_STORE_OBJECT:
4715   375B 32 80 89            LD (G_OBJECT),A
4716   375E             
4717   375E                     ; q2: One-key calculation.  Selecting 0-9 immediately starts the
4718   375E                     ; selected object's calculation; the redundant <OBJECT> ENTER
4719   375E                     ; confirmation screen has been removed.  Keep one stable status
4720   375E                     ; message on the VFD for the entire calculation.
4721   375E CD 1A 06            CALL DISPLAY_CLEAR
4722   3761 CD 37 46            CALL G_PRINT_OBJECT
4723   3764 21 A9 5D            LD HL,GMSG_CALC_SUFFIX
4724   3767 CD 48 06            CALL DISPLAY_PRINT_Z
4725   376A             
4726   376A                     ; Refresh the clock and perform common preparation while the stable
4727   376A                     ; <OBJECT> CALC message remains displayed.
4728   376A             
4729   376A                     ; Refresh the local civil clock from the battery-backed RTC immediately
4730   376A                     ; before calculating the selected object.  GPS synchronized this RTC
4731   376A                     ; after acquisition, so elapsed time since startup is reflected here.
4732   376A                     ; If the RTC read fails, ASTRO_CLOCK_INIT leaves AST_CLOCK_OK=0 and the
4733   376A                     ; existing in-RAM time remains available; do not abort a GPS-valid run.
4734   376A CD BE 06            CALL ASTRO_CLOCK_INIT
4735   376D CD 2E 38            CALL G_CALC_COMMON
4736   3770             
4737   3770                     ; Object-specific work now starts.  Progress dots are added at real
4738   3770                     ; checkpoints, including the midpoint of the event scan.
4739   3770                     ; q2: Progress-star redraws removed.  They added no useful astronomy
4740   3770                     ; information and repeatedly cleared/redrew the VFD.
4741   3770 AF                  XOR A
4742   3771 32 0B 8A            LD (G_PROGRESS),A
4743   3774 CD BE 47            CALL G_CALCULATE_SELECTED
4744   3777             
4745   3777                     ; Capture the local civil timestamp that belongs to the newly
4746   3777                     ; calculated AZ/EL result before any live RTC display screen can
4747   3777                     ; refresh AST_* later.
4748   3777 CD FE 39            CALL G_CAPTURE_CALC_TIMESTAMP
4749   377A             
4750   377A                     ; Audible completion indication.  The timestamp above is captured
4751   377A                     ; first so the roughly half-second chime cannot shift the calculation
4752   377A                     ; time associated with this result.
4753   377A CD B0 01            CALL CALC_DONE_TUNE
4754   377D             
4755   377D                     ; Every completed calculation enters the result carousel with
4756   377D                     ; PRINT defaulting to NO.
4757   377D AF                  XOR A
4758   377E 32 A0 8A            LD (G_PRINT_CHOICE),A
4759   3781             
4760   3781                     ; Required completion screen: <OBJECT> VIS / <OBJECT> NOT VIS.
4761   3781 AF                  XOR A
4762   3782 32 81 89            LD (G_SCREEN),A
4763   3785 CD 68 38            CALL G_DRAW_RESULT_SCREEN
4764   3788             
4765   3788             G_RESULT_WAIT:
4766   3788                     ; PRINT is the final screen in every result carousel and accepts
4767   3788                     ; *, # and ENTER rather than ENTER alone.
4768   3788 CD 9D 37            CALL G_IS_PRINT_SCREEN
4769   378B CA B8 37            JP Z,G_PRINT_SCREEN_WAIT
4770   378E             
4771   378E CD E1 37            CALL G_GET_UI_KEY
4772   3791 FE 10               CP KEY_ENTER
4773   3793 20 F3               JR NZ,G_RESULT_WAIT
4774   3795 CD 3E 38            CALL G_ADVANCE_RESULT_SCREEN
4775   3798 CD 68 38            CALL G_DRAW_RESULT_SCREEN
4776   379B 18 EB               JR G_RESULT_WAIT
4777   379D             
4778   379D             ; Z flag set if the current G_SCREEN value is the PRINT screen index for the
4779   379D             ; selected object type.  Normal planets use 8, Sun uses 6, Moon uses 7.
4780   379D             G_IS_PRINT_SCREEN:
4781   379D 3A 81 89            LD A,(G_SCREEN)
4782   37A0 47                  LD B,A
4783   37A1 3A 80 89            LD A,(G_OBJECT)
4784   37A4 FE 02               CP G_OBJ_SUN
4785   37A6 28 08               JR Z,G_IPS_SUN
4786   37A8 FE 09               CP G_OBJ_MOON
4787   37AA 28 08               JR Z,G_IPS_MOON
4788   37AC 78                  LD A,B
4789   37AD FE 08               CP 8
4790   37AF C9                  RET
4791   37B0             G_IPS_SUN:
4792   37B0 78                  LD A,B
4793   37B1 FE 06               CP 6
4794   37B3 C9                  RET
4795   37B4             G_IPS_MOON:
4796   37B4 78                  LD A,B
4797   37B5 FE 07               CP 7
4798   37B7 C9                  RET
4799   37B8             
4800   37B8             G_PRINT_SCREEN_WAIT:
4801   37B8 CD E1 37            CALL G_GET_UI_KEY
4802   37BB FE 0D               CP KEY_UTC_NEG                 ; * toggles NO <-> YES
4803   37BD 28 14               JR Z,G_PRINT_TOGGLE
4804   37BF FE 10               CP KEY_ENTER
4805   37C1 20 F5               JR NZ,G_PRINT_SCREEN_WAIT
4806   37C3             
4807   37C3 3A A0 8A            LD A,(G_PRINT_CHOICE)
4808   37C6 B7                  OR A
4809   37C7 C2 87 39            JP NZ,G_PRINT_NOW_DIALOG
4810   37CA             
4811   37CA                     ; PRINT NO + ENTER resumes the normal carousel at STATUS.
4812   37CA CD 3E 38            CALL G_ADVANCE_RESULT_SCREEN
4813   37CD CD 68 38            CALL G_DRAW_RESULT_SCREEN
4814   37D0 C3 88 37            JP G_RESULT_WAIT
4815   37D3             
4816   37D3             G_PRINT_TOGGLE:
4817   37D3 3A A0 8A            LD A,(G_PRINT_CHOICE)
4818   37D6 EE 01               XOR 1
4819   37D8 32 A0 8A            LD (G_PRINT_CHOICE),A
4820   37DB CD 78 39            CALL G_DRAW_PRINT
4821   37DE C3 B8 37            JP G_PRINT_SCREEN_WAIT
4822   37E1             
4823   37E1             ; CLEAR returns to OPTION menu.  ALPHA is a full software reset.
4824   37E1             G_GET_UI_KEY:
4825   37E1 CD 3E 02            CALL KEY_GET
4826   37E4 FE 0C               CP KEY_ALPHA
4827   37E6 CA F3 37            JP Z,G_FULL_RESET
4828   37E9 FE 04               CP KEY_CLEAR
4829   37EB C0                  RET NZ
4830   37EC F3                  DI
4831   37ED 31 FE FF            LD SP,$FFFE
4832   37F0 C3 E3 36            JP G_OBJECT_MENU
4833   37F3             
4834   37F3             G_FULL_RESET:
4835   37F3 F3                  DI
4836   37F4 31 FE FF            LD SP,$FFFE
4837   37F7 C3 00 00            JP RESET
4838   37FA             
4839   37FA             ; Nonblocking CLEAR/ALPHA check at calculation checkpoints.
4840   37FA             G_CALC_ABORT_CHECK:
4841   37FA CD E8 01            CALL KEY_SCAN
4842   37FD B7                  OR A
4843   37FE C8                  RET Z
4844   37FF 5F                  LD E,A
4845   3800 CD 4A 02            CALL KEY_WAIT_RELEASE
4846   3803 7B                  LD A,E
4847   3804 FE 0C               CP KEY_ALPHA
4848   3806 CA F3 37            JP Z,G_FULL_RESET
4849   3809 FE 04               CP KEY_CLEAR
4850   380B C0                  RET NZ
4851   380C F3                  DI
4852   380D 31 FE FF            LD SP,$FFFE
4853   3810 C3 E3 36            JP G_OBJECT_MENU
4854   3813             
4855   3813             ; CALCULATING, CALCULATING*, ... CALCULATING*****
4856   3813             G_DRAW_PROGRESS:
4857   3813 CD 1A 06            CALL DISPLAY_CLEAR
4858   3816 21 57 5E            LD HL,GMSG_CALCULATING
4859   3819 CD 48 06            CALL DISPLAY_PRINT_Z
4860   381C 3A 0B 8A            LD A,(G_PROGRESS)
4861   381F 47                  LD B,A
4862   3820 B7                  OR A
4863   3821 28 07               JR Z,G_PROGRESS_KEYS
4864   3823             G_PROGRESS_DOTS:
4865   3823 3E 2A               LD A,'*'
4866   3825 CD 51 06            CALL DISPLAY_PUT_ASCII
4867   3828 10 F9               DJNZ G_PROGRESS_DOTS
4868   382A             G_PROGRESS_KEYS:
4869   382A C3 FA 37            JP G_CALC_ABORT_CHECK
4870   382D             
4871   382D             G_PROGRESS_NEXT:
4872   382D                     ; q2: Deliberately no display update.  Retained as a no-op so the
4873   382D                     ; existing calculation checkpoints do not need invasive changes.
4874   382D C9                  RET
4875   382E             
4876   382E             ; Common calculations done while the object name remains on the VFD.
4877   382E             G_CALC_COMMON:
4878   382E CD AD 03            CALL DEBUG_HEADER
4879   3831 CD 6D 46            CALL G_REFRESH_RTC_SAFE
4880   3834 CD E0 0D            CALL ASTRO_DAY_NUMBER
4881   3837 CD 7B 46            CALL G_PREPARE_SUN_BASE
4882   383A CD C0 03            CALL DEBUG_DATE_STAGE
4883   383D C9                  RET
4884   383E             
4885   383E             ; Result-screen sequence.
4886   383E             ; Normal planets: STATUS, RISE, SET, AZ, EL, LOCAL DATE/TIME, UTC DATE/TIME, LAT/LON.
4887   383E             ; Sun:            STATUS, RISE, SET, LOCAL DATE/TIME, UTC DATE/TIME, LAT/LON.
4888   383E             ; Moon:           STATUS, RISE, SET, PHASE, LOCAL DATE/TIME, UTC DATE/TIME, LAT/LON.
4889   383E             G_ADVANCE_RESULT_SCREEN:
4890   383E 3A 81 89            LD A,(G_SCREEN)
4891   3841 3C                  INC A
4892   3842 47                  LD B,A
4893   3843 3A 80 89            LD A,(G_OBJECT)
4894   3846 FE 02               CP G_OBJ_SUN
4895   3848 28 0C               JR Z,G_ADV_SUN
4896   384A FE 09               CP G_OBJ_MOON
4897   384C 28 10               JR Z,G_ADV_MOON
4898   384E 78                  LD A,B
4899   384F FE 09               CP 9                          ; 0..8, PRINT is screen 8
4900   3851 38 11               JR C,G_ADV_STORE
4901   3853 AF                  XOR A
4902   3854 18 0E               JR G_ADV_STORE
4903   3856             G_ADV_SUN:
4904   3856 78                  LD A,B
4905   3857 FE 07               CP 7                          ; 0..6, PRINT is screen 6
4906   3859 38 09               JR C,G_ADV_STORE
4907   385B AF                  XOR A
4908   385C 18 06               JR G_ADV_STORE
4909   385E             G_ADV_MOON:
4910   385E 78                  LD A,B
4911   385F FE 08               CP 8                          ; 0..7, PRINT is screen 7
4912   3861 38 01               JR C,G_ADV_STORE
4913   3863 AF                  XOR A
4914   3864             G_ADV_STORE:
4915   3864 32 81 89            LD (G_SCREEN),A
4916   3867 C9                  RET
4917   3868             
4918   3868             G_DRAW_RESULT_SCREEN:
4919   3868 3A 80 89            LD A,(G_OBJECT)
4920   386B FE 02               CP G_OBJ_SUN
4921   386D 28 31               JR Z,G_DRAW_SUN_RESULT
4922   386F FE 09               CP G_OBJ_MOON
4923   3871 28 50               JR Z,G_DRAW_MOON_RESULT
