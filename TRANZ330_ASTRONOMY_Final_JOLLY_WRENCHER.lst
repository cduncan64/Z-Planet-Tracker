8891   58CF 32 31 8A            LD (GPS_TMP_UTC_SEC),A
8892   58D2 7E                  LD A,(HL)
8893   58D3 FE 2E               CP '.'
8894   58D5 20 0D               JR NZ,GPS_TIME_COMMA
8895   58D7 23                  INC HL
8896   58D8             GPS_TIME_FRAC:
8897   58D8 7E                  LD A,(HL)
8898   58D9 FE 2C               CP ','
8899   58DB 28 0C               JR Z,GPS_TIME_DONE
8900   58DD CD A3 58            CALL GPS_ASCII_DIGIT
8901   58E0 D8                  RET C
8902   58E1 23                  INC HL
8903   58E2 18 F4               JR GPS_TIME_FRAC
8904   58E4             GPS_TIME_COMMA:
8905   58E4 7E                  LD A,(HL)
8906   58E5 FE 2C               CP ','
