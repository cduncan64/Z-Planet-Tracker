5203   3A70             
5204   3A70             G_PF_DATE:
5205   3A70 AF                  XOR A
5206   3A71 32 4F 89            LD (AST_INPUT_MODE),A
5207   3A74 CD E6 3A            CALL G_PRINT_READ_SIX
5208   3A77 38 64               JR C,G_PF_CANCEL
5209   3A79 CD 46 0A            CALL ASI_PARSE_DATE
5210   3A7C 38 F2               JR C,G_PF_DATE
5211   3A7E             
5212   3A7E 3A 01 89            LD A,(AST_YEAR)
5213   3A81 32 A2 8A            LD (G_PRINT_UTC_YEAR),A
