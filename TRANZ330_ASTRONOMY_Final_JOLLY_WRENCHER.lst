8403   554F             ; PLANET TABLES (30 bytes each)
8404   554F             ; N0,NR,I0,IR,W0,WR,M0,MI,MF,MX100,A,AE,B,K1,K2
8405   554F             ; Coordinates use 512 units/AU.
8406   554F             ; ---------------------------------------------------------------------------
8407   554F             G_PLANET_PTRS:
8408   554F 5D 55 7B 55         DW G_TAB_MERCURY,G_TAB_VENUS,G_TAB_MARS,G_TAB_JUPITER
8408   5553 99 55 B7 55 
8409   5557 D5 55 F3 55         DW G_TAB_SATURN,G_TAB_URANUS,G_TAB_NEPTUNE
8409   555B 11 56       
