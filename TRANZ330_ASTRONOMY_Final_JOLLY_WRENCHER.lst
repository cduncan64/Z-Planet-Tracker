5140   39DF 32 03 89            LD (AST_DAY),A
5141   39E2 3A AB 8A            LD A,(G_CALC_HOUR)
5142   39E5 32 04 89            LD (AST_HOUR),A
5143   39E8 3A AC 8A            LD A,(G_CALC_MINUTE)
5144   39EB 32 05 89            LD (AST_MINUTE),A
5145   39EE 3A AD 8A            LD A,(G_CALC_SECOND)
5146   39F1 32 57 89            LD (AST_SECOND),A
5147   39F4             
5148   39F4 CD F9 5B            CALL G_RTC_LOCAL_TO_UTC
5149   39F7 CD 41 3C            CALL G_COPY_GPS_UTC_TO_PRINT
5150   39FA CD 48 3A            CALL G_RESTORE_AST_CLOCK_TEMP
5151   39FD C9                  RET
5152   39FE             
