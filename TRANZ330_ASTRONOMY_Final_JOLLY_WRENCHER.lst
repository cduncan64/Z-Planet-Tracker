3603   1706             ; ============================================================================
3604   1706             ; 32-BIT DIVISION / SQUARE ROOT
3605   1706             ; ============================================================================
3606   1706             
3607   1706             ; Divide unsigned 32-bit M32_ACC by unsigned HL.
3608   1706             ; Returns 16-bit quotient HL.  Used where quotient is known to fit 16 bits.
3609   1706             ASTRO_DIV32_BY_16:
3610   1706                     ; PURE Z80 FAST exact 32/16 divide for the existing contract that the
3611   1706                     ; quotient fits in 16 bits.  In that case numerator high word < divisor,
3612   1706                     ; so seed the remainder with the high word and process only the low 16 bits.
3613   1706 22 3F 89            LD (AST_TMP0),HL           ; divisor
3614   1709 ED 5B 60 89         LD DE,(M32_ACC+2)          ; initial remainder = numerator high word
3615   170D 2A 5E 89            LD HL,(M32_ACC)            ; low numerator; becomes quotient in-place
3616   1710 3E 10               LD A,16
3617   1712             AD3216_FAST_LOOP:
3618   1712 29                  ADD HL,HL                  ; next numerator bit -> carry; quotient <<= 1
3619   1713 CB 13               RL E
3620   1715 CB 12               RL D                       ; remainder = remainder*2 + input bit
3621   1717 E5                  PUSH HL
3622   1718 62                  LD H,D
3623   1719 6B                  LD L,E
3624   171A ED 4B 3F 89         LD BC,(AST_TMP0)
3625   171E B7                  OR A
3626   171F ED 42               SBC HL,BC
3627   1721 38 06               JR C,AD3216_FAST_NOSUB
3628   1723 54                  LD D,H
3629   1724 5D                  LD E,L
3630   1725 E1                  POP HL
3631   1726 2C                  INC L                      ; set quotient bit 0 (shift made it zero)
3632   1727 18 01               JR AD3216_FAST_NEXT
3633   1729             AD3216_FAST_NOSUB:
3634   1729 E1                  POP HL
3635   172A             AD3216_FAST_NEXT:
3636   172A 3D                  DEC A
3637   172B 20 E5               JR NZ,AD3216_FAST_LOOP
3638   172D C9                  RET
3639   172E             
