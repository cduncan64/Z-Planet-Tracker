8982   5947 32 3E 8A            LD (GPS_TMP_COORD_DEG),A
8983   594A 32 49 8A            LD (GPS_TMP_COORD_ORIG_DEG),A
8984   594D CD C7 59            CALL GPS_PARSE_MINUTES
8985   5950 D8                  RET C
