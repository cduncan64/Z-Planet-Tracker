2828   11FC             ; ----------------------------------------------------------------------------
2829   11FC             ; Safe perturbation implementation.
2830   11FC             ;
2831   11FC             ; NOTE FOR INTEGRATION:
2832   11FC             ; The vector routine above is intentionally verbose for educational visibility.
2833   11FC             ; The actual callable perturbation used by the corrected block below stores the
2834   11FC             ; original xh/yh before rotation.  Replace the marked perturbation block in
2835   11FC             ; ASTRO_VECTOR with ASTRO_ROTATE_PERTURB_SAFE when merging.
2836   11FC             ; ----------------------------------------------------------------------------
2837   11FC             ASTRO_ROTATE_PERTURB_SAFE:
2838   11FC                     ; Input:
2839   11FC                     ;   AST_TMP1 = xh
2840   11FC                     ;   AST_TMP0 = yh
2841   11FC                     ;   HL       = signed p10
2842   11FC                     ; Output:
2843   11FC                     ;   AST_TMP1 = rotated xh
2844   11FC                     ;   AST_TMP0 = rotated yh
2845   11FC 22 4D 89            LD (AST_TMP7),HL
2846   11FF 2A 41 89            LD HL,(AST_TMP1)
2847   1202 22 43 89            LD (AST_TMP2),HL          ; old xh
2848   1205 2A 3F 89            LD HL,(AST_TMP0)
2849   1208 22 45 89            LD (AST_TMP3),HL          ; old yh
2850   120B             
2851   120B 2A 4D 89            LD HL,(AST_TMP7)
2852   120E CD 21 16            CALL ASTRO_COS10_SIGNED
2853   1211 22 47 89            LD (AST_TMP4),HL
2854   1214 2A 4D 89            LD HL,(AST_TMP7)
2855   1217 CD 11 16            CALL ASTRO_SIN10_SIGNED
2856   121A 22 49 89            LD (AST_TMP5),HL
2857   121D             
2858   121D 2A 43 89            LD HL,(AST_TMP2)
2859   1220 ED 5B 47 89         LD DE,(AST_TMP4)
2860   1224 CD 34 16            CALL ASTRO_MUL_Q15
2861   1227 22 4B 89            LD (AST_TMP6),HL
2862   122A 2A 45 89            LD HL,(AST_TMP3)
2863   122D ED 5B 49 89         LD DE,(AST_TMP5)
2864   1231 CD 34 16            CALL ASTRO_MUL_Q15
2865   1234 EB                  EX DE,HL
2866   1235 2A 4B 89            LD HL,(AST_TMP6)
2867   1238 B7                  OR A
2868   1239 ED 52               SBC HL,DE
2869   123B 22 41 89            LD (AST_TMP1),HL
2870   123E             
2871   123E 2A 45 89            LD HL,(AST_TMP3)
2872   1241 ED 5B 47 89         LD DE,(AST_TMP4)
2873   1245 CD 34 16            CALL ASTRO_MUL_Q15
2874   1248 22 4B 89            LD (AST_TMP6),HL
2875   124B 2A 43 89            LD HL,(AST_TMP2)
2876   124E ED 5B 49 89         LD DE,(AST_TMP5)
2877   1252 CD 34 16            CALL ASTRO_MUL_Q15
2878   1255 EB                  EX DE,HL
2879   1256 2A 4B 89            LD HL,(AST_TMP6)
2880   1259 19                  ADD HL,DE
2881   125A 22 3F 89            LD (AST_TMP0),HL
2882   125D C9                  RET
2883   125E             
2884   125E             ; ----------------------------------------------------------------------------
2885   125E             ; Jupiter longitude perturbation.
2886   125E             ; Returns signed HL in tenths degree.
2887   125E             ; Uses the standard Jupiter/Saturn short-period terms, coefficients in
2888   125E             ; hundredths of a degree, then divides the sum by 10.
2889   125E             ; ----------------------------------------------------------------------------
2890   125E             ASTRO_JUP_PERTURB:
2891   125E AF                  XOR A
2892   125F 67                  LD H,A
2893   1260 6F                  LD L,A
2894   1261 22 4B 89            LD (AST_TMP6),HL          ; sum hundredths deg
2895   1264 2A 18 89            LD HL,(AST_JM)
2896   1267 29                  ADD HL,HL
2897   1268 ED 5B 1C 89         LD DE,(AST_SATM)
2898   126C CD 46 13            CALL ASTRO_SUB_5DE
2899   126F 11 5C FD            LD DE,-676
2900   1272 19                  ADD HL,DE
2901   1273 CD 86 0F            CALL ASTRO_NORM3600_SIGNED
2902   1276 CD 14 16            CALL ASTRO_SIN10
2903   1279 3E 21               LD A,33
2904   127B CD 2E 16            CALL ASTRO_SCALE_Q15_U8
2905   127E CD CF 19            CALL ASTRO_NEG_HL
2906   1281 22 4B 89            LD (AST_TMP6),HL
2907   1284             
2908   1284                     ; -6 sin(2Mj - 2Ms + 21.0)
2909   1284 2A 18 89            LD HL,(AST_JM)
2910   1287 29                  ADD HL,HL
2911   1288 ED 5B 1C 89         LD DE,(AST_SATM)
2912   128C B7                  OR A
2913   128D ED 52               SBC HL,DE
2914   128F B7                  OR A
2915   1290 ED 52               SBC HL,DE
2916   1292 11 D2 00            LD DE,210
2917   1295 19                  ADD HL,DE
2918   1296 CD 86 0F            CALL ASTRO_NORM3600_SIGNED
2919   1299 CD 14 16            CALL ASTRO_SIN10
2920   129C 3E 06               LD A,6
2921   129E CD 2E 16            CALL ASTRO_SCALE_Q15_U8
2922   12A1 CD CF 19            CALL ASTRO_NEG_HL
2923   12A4 CD 56 13            CALL ASTRO_ADD_PSUM
2924   12A7             
2925   12A7                     ; +4 sin(3Mj - 5Ms + 21.0)
2926   12A7 2A 18 89            LD HL,(AST_JM)
2927   12AA E5                  PUSH HL
2928   12AB 29                  ADD HL,HL
2929   12AC D1                  POP DE
2930   12AD 19                  ADD HL,DE
2931   12AE ED 5B 1C 89         LD DE,(AST_SATM)
2932   12B2 CD 46 13            CALL ASTRO_SUB_5DE
2933   12B5 11 D2 00            LD DE,210
2934   12B8 19                  ADD HL,DE
2935   12B9 CD 86 0F            CALL ASTRO_NORM3600_SIGNED
2936   12BC CD 14 16            CALL ASTRO_SIN10
2937   12BF 3E 04               LD A,4
2938   12C1 CD 2E 16            CALL ASTRO_SCALE_Q15_U8
2939   12C4 CD 56 13            CALL ASTRO_ADD_PSUM
2940   12C7             
2941   12C7                     ; -4 sin(Mj - 2Ms)
2942   12C7 2A 18 89            LD HL,(AST_JM)
2943   12CA ED 5B 1C 89         LD DE,(AST_SATM)
2944   12CE B7                  OR A
2945   12CF ED 52               SBC HL,DE
2946   12D1 B7                  OR A
2947   12D2 ED 52               SBC HL,DE
2948   12D4 CD 86 0F            CALL ASTRO_NORM3600_SIGNED
2949   12D7 CD 14 16            CALL ASTRO_SIN10
2950   12DA 3E 04               LD A,4
2951   12DC CD 2E 16            CALL ASTRO_SCALE_Q15_U8
2952   12DF CD CF 19            CALL ASTRO_NEG_HL
2953   12E2 CD 56 13            CALL ASTRO_ADD_PSUM
2954   12E5             
2955   12E5                     ; +2 cos(Mj - Ms)
2956   12E5 2A 18 89            LD HL,(AST_JM)
2957   12E8 ED 5B 1C 89         LD DE,(AST_SATM)
2958   12EC B7                  OR A
2959   12ED ED 52               SBC HL,DE
2960   12EF CD 86 0F            CALL ASTRO_NORM3600_SIGNED
2961   12F2 CD 24 16            CALL ASTRO_COS10
2962   12F5 3E 02               LD A,2
2963   12F7 CD 2E 16            CALL ASTRO_SCALE_Q15_U8
2964   12FA CD 56 13            CALL ASTRO_ADD_PSUM
2965   12FD             
2966   12FD                     ; +2 sin(2Mj - 3Ms + 52.0)
2967   12FD 2A 18 89            LD HL,(AST_JM)
2968   1300 29                  ADD HL,HL
2969   1301 ED 5B 1C 89         LD DE,(AST_SATM)
2970   1305 B7                  OR A
2971   1306 ED 52               SBC HL,DE
2972   1308 B7                  OR A
2973   1309 ED 52               SBC HL,DE
2974   130B B7                  OR A
2975   130C ED 52               SBC HL,DE
2976   130E 11 08 02            LD DE,520
2977   1311 19                  ADD HL,DE
2978   1312 CD 86 0F            CALL ASTRO_NORM3600_SIGNED
2979   1315 CD 14 16            CALL ASTRO_SIN10
2980   1318 3E 02               LD A,2
2981   131A CD 2E 16            CALL ASTRO_SCALE_Q15_U8
2982   131D CD 56 13            CALL ASTRO_ADD_PSUM
2983   1320             
2984   1320                     ; -2 sin(Mj - 5Ms - 69.0)
2985   1320 2A 18 89            LD HL,(AST_JM)
2986   1323 ED 5B 1C 89         LD DE,(AST_SATM)
2987   1327 CD 46 13            CALL ASTRO_SUB_5DE
2988   132A 11 4E FD            LD DE,-690
2989   132D 19                  ADD HL,DE
2990   132E CD 86 0F            CALL ASTRO_NORM3600_SIGNED
2991   1331 CD 14 16            CALL ASTRO_SIN10
2992   1334 3E 02               LD A,2
2993   1336 CD 2E 16            CALL ASTRO_SCALE_Q15_U8
2994   1339 CD CF 19            CALL ASTRO_NEG_HL
2995   133C CD 56 13            CALL ASTRO_ADD_PSUM
2996   133F             
2997   133F 2A 4B 89            LD HL,(AST_TMP6)
2998   1342 CD 5F 13            CALL ASTRO_DIVS10
2999   1345 C9                  RET
3000   1346             
3001   1346             ; HL -= 5*DE.
3002   1346             ASTRO_SUB_5DE:
3003   1346 B7                  OR A
3004   1347 ED 52               SBC HL,DE
3005   1349 B7                  OR A
3006   134A ED 52               SBC HL,DE
3007   134C B7                  OR A
3008   134D ED 52               SBC HL,DE
3009   134F B7                  OR A
3010   1350 ED 52               SBC HL,DE
3011   1352 B7                  OR A
3012   1353 ED 52               SBC HL,DE
3013   1355 C9                  RET
3014   1356             
3015   1356             ASTRO_ADD_PSUM:
3016   1356 EB                  EX DE,HL
3017   1357 2A 4B 89            LD HL,(AST_TMP6)
3018   135A 19                  ADD HL,DE
3019   135B 22 4B 89            LD (AST_TMP6),HL
3020   135E C9                  RET
3021   135F             
3022   135F             ; Signed HL / 10, truncating toward zero.
3023   135F             ASTRO_DIVS10:
3024   135F CB 7C               BIT 7,H
3025   1361 28 09               JR Z,ADS10_POS
3026   1363 CD CF 19            CALL ASTRO_NEG_HL
3027   1366 CD 6F 13            CALL ASTRO_DIVU10
3028   1369 C3 CF 19            JP ASTRO_NEG_HL
3029   136C             ADS10_POS:
3030   136C C3 6F 13            JP ASTRO_DIVU10
3031   136F             
3032   136F             ASTRO_DIVU10:
3033   136F                     ; PURE Z80 FAST unsigned HL / 10. Exact 16-step binary division.
3034   136F                     ; Quotient returned in HL; remainder discarded.
3035   136F 11 00 00            LD DE,0                    ; quotient
3036   1372 01 00 00            LD BC,0                    ; remainder (0..9)
3037   1375 3E 10               LD A,16
3038   1377             ADU10_FAST_LOOP:
3039   1377 29                  ADD HL,HL                  ; next dividend bit -> carry
3040   1378 CB 11               RL C                       ; remainder = remainder*2 + bit
3041   137A CB 10               RL B
3042   137C CB 23               SLA E                      ; quotient <<= 1
3043   137E CB 12               RL D
3044   1380 E5                  PUSH HL
3045   1381 60                  LD H,B
3046   1382 69                  LD L,C
3047   1383 D5                  PUSH DE
3048   1384 11 0A 00            LD DE,10
3049   1387 B7                  OR A
3050   1388 ED 52               SBC HL,DE
3051   138A D1                  POP DE
3052   138B 38 03               JR C,ADU10_FAST_NOSUB
3053   138D 44                  LD B,H
3054   138E 4D                  LD C,L
3055   138F 1C                  INC E                      ; set quotient bit 0
3056   1390             ADU10_FAST_NOSUB:
3057   1390 E1                  POP HL
3058   1391 3D                  DEC A
3059   1392 20 E3               JR NZ,ADU10_FAST_LOOP
3060   1394 EB                  EX DE,HL
3061   1395 C9                  RET
3062   1396             
3063   1396             ; ============================================================================
3064   1396             ; RISE / SET
3065   1396             ; ============================================================================
3066   1396             
3067   1396             ASTRO_RISE_SET:
3068   1396 21 FF FF            LD HL,$FFFF
3069   1399 22 26 89            LD (AST_RISE),HL
3070   139C 22 28 89            LD (AST_SET),HL
3071   139F             
3072   139F                     ; Planet vector at local noon using runtime UTC offset.
3073   139F 21 D0 02            LD HL,720
3074   13A2 CD 97 4D            CALL G_LOCAL_TO_UTC_MIN
3075   13A5 CD 95 0F            CALL ASTRO_VECTOR
3076   13A8             
3077   13A8                     ; Distance r = sqrt(x^2+y^2+z^2).
3078   13A8 CD F1 17            CALL ASTRO_VECTOR_DISTANCE
3079   13AB 22 33 89            LD (AST_DIST_Q),HL
3080   13AE             
3081   13AE                     ; horizon coordinate threshold = r * sin(-0.5667)
3082   13AE 11 BC FE            LD DE,H0_SIN_Q15
3083   13B1 CD 34 16            CALL ASTRO_MUL_Q15
3084   13B4 22 31 89            LD (AST_HORIZON_Q),HL
3085   13B7             
3086   13B7                     ; LST at local 00:00 = GMST0 + longitude + runtime UTC-offset advance.
3087   13B7 CD E6 15            CALL ASTRO_GMST0
3088   13BA ED 5B 10 8A         LD DE,(G_SITE_LON10)
3089   13BE 19                  ADD HL,DE
3090   13BF E5                  PUSH HL                  ; preserve GMST0+longitude across SID_ADV
3091   13C0 21 00 00            LD HL,0
3092   13C3 CD 97 4D            CALL G_LOCAL_TO_UTC_MIN   ; UTC minute corresponding to local midnight
3093   13C6 CD F5 15            CALL ASTRO_SID_ADV10
3094   13C9 D1                  POP DE
3095   13CA 19                  ADD HL,DE
3096   13CB CD 86 0F            CALL ASTRO_NORM3600_SIGNED
3097   13CE 22 2F 89            LD (AST_LST0),HL
3098   13D1             
3099   13D1                     ; state at minute 0
3100   13D1 21 00 00            LD HL,0
3101   13D4 CD 32 14            CALL ASTRO_UP_AT_LOCAL_MIN
3102   13D7 CD 7E 14            CALL ASTRO_ABOVE_HORIZON
3103   13DA 32 73 89            LD (AST_PREV),A
3104   13DD             
3105   13DD 21 01 00            LD HL,1
3106   13E0 22 6C 89            LD (AST_SCAN_MIN),HL
3107   13E3             
3108   13E3             ARS_LOOP:
3109   13E3 2A 6C 89            LD HL,(AST_SCAN_MIN)
3110   13E6 CD 32 14            CALL ASTRO_UP_AT_LOCAL_MIN
3111   13E9 CD 7E 14            CALL ASTRO_ABOVE_HORIZON
3112   13EC 57                  LD D,A                    ; current state
3113   13ED 3A 73 89            LD A,(AST_PREV)
3114   13F0 BA                  CP D
3115   13F1 28 2F               JR Z,ARS_NEXT
3116   13F3             
3117   13F3 B7                  OR A
3118   13F4 20 15               JR NZ,ARS_WAS_ABOVE
3119   13F6                     ; below -> above = rise
3120   13F6 2A 26 89            LD HL,(AST_RISE)
3121   13F9 7C                  LD A,H
3122   13FA FE FF               CP $FF
3123   13FC 20 20               JR NZ,ARS_STORE_STATE
3124   13FE 7D                  LD A,L
3125   13FF FE FF               CP $FF
3126   1401 20 1B               JR NZ,ARS_STORE_STATE
3127   1403 2A 6C 89            LD HL,(AST_SCAN_MIN)
3128   1406 22 26 89            LD (AST_RISE),HL
3129   1409 18 13               JR ARS_STORE_STATE
3130   140B             
3131   140B             ARS_WAS_ABOVE:
3132   140B                     ; above -> below = set
3133   140B 2A 28 89            LD HL,(AST_SET)
3134   140E 7C                  LD A,H
3135   140F FE FF               CP $FF
3136   1411 20 0B               JR NZ,ARS_STORE_STATE
3137   1413 7D                  LD A,L
3138   1414 FE FF               CP $FF
3139   1416 20 06               JR NZ,ARS_STORE_STATE
3140   1418 2A 6C 89            LD HL,(AST_SCAN_MIN)
3141   141B 22 28 89            LD (AST_SET),HL
3142   141E             
3143   141E             ARS_STORE_STATE:
3144   141E 7A                  LD A,D
3145   141F 32 73 89            LD (AST_PREV),A
3146   1422             
3147   1422             ARS_NEXT:
3148   1422 2A 6C 89            LD HL,(AST_SCAN_MIN)
3149   1425 23                  INC HL
3150   1426 22 6C 89            LD (AST_SCAN_MIN),HL
3151   1429 11 A0 05            LD DE,1440
3152   142C B7                  OR A
3153   142D ED 52               SBC HL,DE
3154   142F 38 B2               JR C,ARS_LOOP
3155   1431 C9                  RET
3156   1432             
3157   1432             ; HL=local minute.  Returns signed HL=UP coordinate.
3158   1432             ASTRO_UP_AT_LOCAL_MIN:
3159   1432 E5                  PUSH HL
3160   1433 CD F5 15            CALL ASTRO_SID_ADV10
3161   1436 EB                  EX DE,HL
3162   1437 2A 2F 89            LD HL,(AST_LST0)
3163   143A 19                  ADD HL,DE
3164   143B CD 86 0F            CALL ASTRO_NORM3600_SIGNED
3165   143E 22 3F 89            LD (AST_TMP0),HL          ; LST
3166   1441             
3167   1441                     ; q = x*cosLST + y*sinLST
3168   1441 CD 24 16            CALL ASTRO_COS10
3169   1444 EB                  EX DE,HL
3170   1445 2A 20 89            LD HL,(AST_X)
3171   1448 CD 34 16            CALL ASTRO_MUL_Q15
3172   144B 22 41 89            LD (AST_TMP1),HL
3173   144E             
3174   144E 2A 3F 89            LD HL,(AST_TMP0)
3175   1451 CD 14 16            CALL ASTRO_SIN10
3176   1454 EB                  EX DE,HL
3177   1455 2A 22 89            LD HL,(AST_Y)
3178   1458 CD 34 16            CALL ASTRO_MUL_Q15
3179   145B EB                  EX DE,HL
3180   145C 2A 41 89            LD HL,(AST_TMP1)
3181   145F 19                  ADD HL,DE                 ; q
3182   1460 22 35 89            LD (AST_Q),HL
3183   1463             
3184   1463                     ; up = q*coslat + z*sinlat
3185   1463 ED 5B 16 8A         LD DE,(G_SITE_LAT_COS_Q15)
3186   1467 CD 34 16            CALL ASTRO_MUL_Q15
3187   146A 22 41 89            LD (AST_TMP1),HL
3188   146D 2A 24 89            LD HL,(AST_Z)
3189   1470 ED 5B 14 8A         LD DE,(G_SITE_LAT_SIN_Q15)
3190   1474 CD 34 16            CALL ASTRO_MUL_Q15
3191   1477 EB                  EX DE,HL
3192   1478 2A 41 89            LD HL,(AST_TMP1)
3193   147B 19                  ADD HL,DE
3194   147C D1                  POP DE                    ; discard saved minute into DE
3195   147D C9                  RET
3196   147E             
3197   147E             ; Input HL=signed up. Output A=1 if >= threshold else 0.
3198   147E             ASTRO_ABOVE_HORIZON:
3199   147E ED 5B 31 89         LD DE,(AST_HORIZON_Q)
3200   1482                     ; signed compare HL >= DE via biasing sign bit
3201   1482 7C                  LD A,H
3202   1483 EE 80               XOR $80
3203   1485 47                  LD B,A
3204   1486 7A                  LD A,D
3205   1487 EE 80               XOR $80
3206   1489 B8                  CP B
3207   148A 38 0A               JR C,AAH_YES              ; biased DE < biased HL
3208   148C 20 06               JR NZ,AAH_NO
3209   148E 7B                  LD A,E
3210   148F BD                  CP L
3211   1490 38 04               JR C,AAH_YES
3212   1492 28 02               JR Z,AAH_YES
3213   1494             AAH_NO:
3214   1494 AF                  XOR A
3215   1495 C9                  RET
3216   1496             AAH_YES:
3217   1496 3E 01               LD A,1
3218   1498 C9                  RET
3219   1499             
3220   1499             ; ============================================================================
3221   1499             ; CURRENT AZIMUTH / ELEVATION
3222   1499             ; ============================================================================
3223   1499             
3224   1499             ASTRO_CURRENT_HORIZONTAL:
3225   1499                     ; Local minute
