6427   4637             ; ---------------------------------------------------------------------------
6428   4637             G_PRINT_OBJECT:
6429   4637 3A 80 89            LD A,(G_OBJECT)
6430   463A 87                  ADD A,A
6431   463B 5F                  LD E,A
6432   463C 16 00               LD D,0
6433   463E 21 9C 60            LD HL,G_OBJECT_PTRS
6434   4641 19                  ADD HL,DE
6435   4642 5E                  LD E,(HL)
6436   4643 23                  INC HL
6437   4644 56                  LD D,(HL)
6438   4645 EB                  EX DE,HL
6439   4646 C3 48 06            JP DISPLAY_PRINT_Z
6440   4649             
6441   4649             G_PRINT_COMPASS16:
6442   4649 11 70 00            LD DE,112
6443   464C 19                  ADD HL,DE
6444   464D CD 7C 0F            CALL ASTRO_NORM3600
6445   4650 06 00               LD B,0
6446   4652 11 E1 00            LD DE,225
6447   4655             G_COMP_DIV:
6448   4655 B7                  OR A
6449   4656 ED 52               SBC HL,DE
6450   4658 38 03               JR C,G_COMP_DONE
6451   465A 04                  INC B
6452   465B 18 F8               JR G_COMP_DIV
6453   465D             G_COMP_DONE:
6454   465D 78                  LD A,B
6455   465E 87                  ADD A,A
6456   465F 5F                  LD E,A
6457   4660 16 00               LD D,0
6458   4662 21 38 61            LD HL,G_COMPASS_PTRS
6459   4665 19                  ADD HL,DE
6460   4666 5E                  LD E,(HL)
6461   4667 23                  INC HL
6462   4668 56                  LD D,(HL)
6463   4669 EB                  EX DE,HL
6464   466A C3 48 06            JP DISPLAY_PRINT_Z
6465   466D             
6466   466D             ; Safe RTC refresh. ASTRO_RTC_READ writes candidate fields before it
6467   466D             ; validates them, so save the current valid/manual clock and restore on error.
6468   466D             G_REFRESH_RTC_SAFE:
6469   466D                     ; V1H: Manual-clock mode.
6470   466D                     ; Preserve the date/time entered at startup and do not overwrite it
6471   466D                     ; with the hardware RTC during object selection/calculation.
6472   466D 37                  SCF
6473   466E C9                  RET
6474   466F             
6475   466F             ; ---------------------------------------------------------------------------
6476   466F             ; DATE PREPARATION AND FAST LINEAR ELEMENT EVOLUTION
6477   466F             ; ---------------------------------------------------------------------------
6478   466F             G_PREPARE_DATE:
6479   466F CD 6D 46            CALL G_REFRESH_RTC_SAFE
6480   4672 38 00               JR C,G_PD_KEEP_MANUAL
6481   4674                     ; RTC valid -> AST_* refreshed.
6482   4674             G_PD_KEEP_MANUAL:
6483   4674 CD E0 0D            CALL ASTRO_DAY_NUMBER
6484   4677 CD 7B 46            CALL G_PREPARE_SUN_BASE
6485   467A C9                  RET
6486   467B             
6487   467B             G_PREPARE_SUN_BASE:
6488   467B                     ; Sun mean anomaly at UTC 00:00
6489   467B 21 E8 0D            LD HL,G_SUN_M0
6490   467E 22 96 89            LD (G_CALC_BASE),HL
6491   4681 21 09 00            LD HL,G_SUN_MI
6492   4684 22 9A 89            LD (G_CALC_INT),HL
6493   4687 21 70 21            LD HL,G_SUN_MF
6494   468A 22 9C 89            LD (G_CALC_FRAC),HL
6495   468D CD E0 46            CALL G_CALC_MEAN
6496   4690 22 08 89            LD (AST_SM),HL
6497   4693                     ; Sun longitude of perihelion
6498   4693 21 0D 0B            LD HL,G_SUN_W0
6499   4696 22 96 89            LD (G_CALC_BASE),HL
6500   4699 21 05 00            LD HL,G_SUN_WR
6501   469C 22 98 89            LD (G_CALC_RATE),HL
6502   469F CD A6 46            CALL G_CALC_SMALL
6503   46A2 22 0C 89            LD (AST_SW),HL
6504   46A5 C9                  RET
6505   46A6             
6506   46A6             ; G_CALC_SMALL: base angle + signed small drift.
6507   46A6             ; rate units = 1/10000 of a tenth-degree per day.
6508   46A6             G_CALC_SMALL:
6509   46A6 2A 98 89            LD HL,(G_CALC_RATE)
6510   46A9 AF                  XOR A
6511   46AA 32 9E 89            LD (G_CALC_SIGN),A
6512   46AD CB 7C               BIT 7,H
6513   46AF 28 08               JR Z,G_CS_POS
6514   46B1 CD CF 19            CALL ASTRO_NEG_HL
6515   46B4 3E 01               LD A,1
6516   46B6 32 9E 89            LD (G_CALC_SIGN),A
6517   46B9             G_CS_POS:
6518   46B9 EB                  EX DE,HL
6519   46BA 2A 06 89            LD HL,(AST_DAYS)
6520   46BD CD 7C 16            CALL ASTRO_UMUL16
6521   46C0 21 88 13            LD HL,5000
6522   46C3 CD 17 47            CALL G_M32_ADD16
6523   46C6 21 10 27            LD HL,10000
6524   46C9 CD 06 17            CALL ASTRO_DIV32_BY_16
6525   46CC EB                  EX DE,HL                   ; DE=correction
6526   46CD 2A 96 89            LD HL,(G_CALC_BASE)
6527   46D0 3A 9E 89            LD A,(G_CALC_SIGN)
6528   46D3 B7                  OR A
6529   46D4 28 06               JR Z,G_CS_ADD
6530   46D6 B7                  OR A
6531   46D7 ED 52               SBC HL,DE
6532   46D9 C3 86 0F            JP ASTRO_NORM3600_SIGNED
6533   46DC             G_CS_ADD:
6534   46DC 19                  ADD HL,DE
6535   46DD C3 7C 0F            JP ASTRO_NORM3600
6536   46E0             
6537   46E0             ; G_CALC_MEAN: base + days*(integer + frac/10000), modulo 3600.
6538   46E0             G_CALC_MEAN:
6539   46E0                     ; fractional contribution, rounded
6540   46E0 2A 06 89            LD HL,(AST_DAYS)
6541   46E3 ED 5B 9C 89         LD DE,(G_CALC_FRAC)
6542   46E7 CD 7C 16            CALL ASTRO_UMUL16
6543   46EA 21 88 13            LD HL,5000
6544   46ED CD 17 47            CALL G_M32_ADD16
6545   46F0 21 10 27            LD HL,10000
6546   46F3 CD 06 17            CALL ASTRO_DIV32_BY_16
6547   46F6 22 8D 89            LD (G_TMPW0),HL
6548   46F9                     ; integer contribution
6549   46F9 2A 06 89            LD HL,(AST_DAYS)
6550   46FC ED 5B 9A 89         LD DE,(G_CALC_INT)
6551   4700 CD 7C 16            CALL ASTRO_UMUL16
6552   4703 2A 8D 89            LD HL,(G_TMPW0)
6553   4706 CD 17 47            CALL G_M32_ADD16
6554   4709 2A 96 89            LD HL,(G_CALC_BASE)
6555   470C CD 17 47            CALL G_M32_ADD16
6556   470F 21 10 0E            LD HL,3600
6557   4712 CD 06 17            CALL ASTRO_DIV32_BY_16
6558   4715 EB                  EX DE,HL                   ; divider leaves remainder in DE
6559   4716 C9                  RET
6560   4717             
6561   4717             ; Add unsigned HL to little-endian M32_ACC.
6562   4717             G_M32_ADD16:
6563   4717 3A 5E 89            LD A,(M32_ACC)
6564   471A 85                  ADD A,L
6565   471B 32 5E 89            LD (M32_ACC),A
6566   471E 3A 5F 89            LD A,(M32_ACC+1)
6567   4721 8C                  ADC A,H
6568   4722 32 5F 89            LD (M32_ACC+1),A
6569   4725 3A 60 89            LD A,(M32_ACC+2)
6570   4728 CE 00               ADC A,0
6571   472A 32 60 89            LD (M32_ACC+2),A
6572   472D 3A 61 89            LD A,(M32_ACC+3)
6573   4730 CE 00               ADC A,0
6574   4732 32 61 89            LD (M32_ACC+3),A
6575   4735 C9                  RET
6576   4736             
6577   4736             ; Fractional-day correction: input HL=UTC minutes (may be up to 1739),
6578   4736             ; DE=mean motion in hundredths of a tenth-degree/day. Returns HL=angle10 delta.
6579   4736             G_MINUTE_MDELTA:
6580   4736 CD 7C 16            CALL ASTRO_UMUL16
6581   4739 21 A0 05            LD HL,1440
6582   473C CD 06 17            CALL ASTRO_DIV32_BY_16     ; hundredths of tenth in HL
6583   473F 11 32 00            LD DE,50
6584   4742 19                  ADD HL,DE
6585   4743 CD 6F 13            CALL ASTRO_DIVU10
6586   4746 C3 6F 13            JP ASTRO_DIVU10
6587   4749             
6588   4749             ; Load normal planet table for current object and evolve date elements.
6589   4749             G_PREPARE_NORMAL:
6590   4749 3A 80 89            LD A,(G_OBJECT)
6591   474C                     ; map user object id to normal table 0..6; Sun/Pluto/Moon never call here.
6592   474C FE 03               CP G_OBJ_MARS
