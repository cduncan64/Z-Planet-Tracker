8611   5762             ; A = received byte. '$' always re-synchronizes. CR/LF terminates a sentence.
8612   5762             GPS_RX_BYTE:
8613   5762 32 29 8A            LD (GPS_RX_SAVED),A
8614   5765 FE 24               CP '$'
8615   5767 28 29               JR Z,GPS_RX_DOLLAR
8616   5769 57                  LD D,A
8617   576A 3A 26 8A            LD A,(GPS_COLLECTING)
8618   576D B7                  OR A
8619   576E C8                  RET Z
8620   576F 7A                  LD A,D
8621   5770 FE 0D               CP 13
8622   5772 28 2E               JR Z,GPS_RX_END
8623   5774 FE 0A               CP 10
8624   5776 28 2A               JR Z,GPS_RX_END
