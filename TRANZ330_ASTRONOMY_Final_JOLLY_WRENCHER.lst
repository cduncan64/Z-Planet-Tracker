8024   522D             ; ---------------------------------------------------------------------------
8025   522D             ; DYNAMIC MOON EVENTS: 10-minute coarse scan + 1-minute refinement.
8026   522D             ; ---------------------------------------------------------------------------
8027   522D             G_EVENTS_MOON:
8028   522D 21 FF FF            LD HL,$FFFF
8029   5230 22 26 89            LD (AST_RISE),HL
8030   5233 22 28 89            LD (AST_SET),HL
