6698   4801             ; SUN ECLIPTIC VECTOR, input HL=UTC minutes 0..1739
6699   4801             ; returns G_SX/G_SY, and G_SUN_LON
6700   4801             ; ---------------------------------------------------------------------------
6701   4801             G_SUN_VECTOR:
6702   4801 22 8B 89            LD (G_UTC_MIN),HL
6703   4804 11 DA 03            LD DE,G_SUN_MX100
6704   4807 CD 36 47            CALL G_MINUTE_MDELTA
6705   480A EB                  EX DE,HL
6706   480B 2A 08 89            LD HL,(AST_SM)
6707   480E 19                  ADD HL,DE
