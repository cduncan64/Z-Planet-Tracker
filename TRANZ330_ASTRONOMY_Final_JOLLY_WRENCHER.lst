8670   57C0             ; ---------------------------------------------------------------------------
8671   57C0             ; Checksum-valid RMC parser. All required fields are first parsed into
8672   57C0             ; temporary RAM. Astronomy-visible state is committed only after the complete
8673   57C0             ; sentence validates, so a malformed sentence cannot partially update time/site.
8674   57C0             ; ---------------------------------------------------------------------------
8675   57C0             GPS_PARSE_RMC:
8676   57C0 CD 31 58            CALL GPS_VALIDATE_CHECKSUM
8677   57C3 D8                  RET C
8678   57C4             
8679   57C4 21 51 8A            LD HL,GPS_BUFFER+1
8680   57C7 7E                  LD A,(HL)
8681   57C8 FE 47               CP 'G'
8682   57CA C0                  RET NZ
8683   57CB 23                  INC HL
8684   57CC 7E                  LD A,(HL)
8685   57CD FE 50               CP 'P'
8686   57CF 28 03               JR Z,GPS_PR_TALKER_OK
8687   57D1 FE 4E               CP 'N'
8688   57D3 C0                  RET NZ
8689   57D4             GPS_PR_TALKER_OK:
8690   57D4 23                  INC HL
8691   57D5 7E                  LD A,(HL)
8692   57D6 FE 52               CP 'R'
8693   57D8 C0                  RET NZ
8694   57D9 23                  INC HL
8695   57DA 7E                  LD A,(HL)
8696   57DB FE 4D               CP 'M'
8697   57DD C0                  RET NZ
8698   57DE 23                  INC HL
8699   57DF 7E                  LD A,(HL)
8700   57E0 FE 43               CP 'C'
8701   57E2 C0                  RET NZ
8702   57E3 23                  INC HL
8703   57E4 7E                  LD A,(HL)
8704   57E5 FE 2C               CP ','
8705   57E7 C0                  RET NZ
8706   57E8 23                  INC HL
8707   57E9             
8708   57E9                     ; UTC hhmmss[.ss]
8709   57E9 CD B1 58            CALL GPS_PARSE_TIME
8710   57EC D8                  RET C
8711   57ED             
8712   57ED                     ; Status must be A and field must be exactly one character.
8713   57ED 7E                  LD A,(HL)
8714   57EE FE 41               CP 'A'
8715   57F0 C0                  RET NZ
8716   57F1 23                  INC HL
8717   57F2 7E                  LD A,(HL)
8718   57F3 FE 2C               CP ','
8719   57F5 C0                  RET NZ
8720   57F6 23                  INC HL
8721   57F7             
8722   57F7                     ; Latitude ddmm.mmmmm
8723   57F7 CD 3E 59            CALL GPS_PARSE_LAT_FIELD
8724   57FA D8                  RET C
8725   57FB 7E                  LD A,(HL)
8726   57FC FE 4E               CP 'N'
8727   57FE 28 03               JR Z,GPS_LAT_HEMI_OK
8728   5800 FE 53               CP 'S'
8729   5802 C0                  RET NZ
8730   5803             GPS_LAT_HEMI_OK:
8731   5803 32 35 8A            LD (GPS_TMP_LAT_HEMI),A
8732   5806 23                  INC HL
8733   5807 7E                  LD A,(HL)
8734   5808 FE 2C               CP ','
8735   580A C0                  RET NZ
8736   580B 23                  INC HL
8737   580C             
8738   580C                     ; Longitude dddmm.mmmmm
8739   580C CD 76 59            CALL GPS_PARSE_LON_FIELD
8740   580F D8                  RET C
8741   5810 7E                  LD A,(HL)
8742   5811 FE 45               CP 'E'
8743   5813 28 03               JR Z,GPS_LON_HEMI_OK
8744   5815 FE 57               CP 'W'
8745   5817 C0                  RET NZ
8746   5818             GPS_LON_HEMI_OK:
8747   5818 32 39 8A            LD (GPS_TMP_LON_HEMI),A
8748   581B 23                  INC HL
8749   581C 7E                  LD A,(HL)
8750   581D FE 2C               CP ','
8751   581F C0                  RET NZ
8752   5820 23                  INC HL
8753   5821             
8754   5821                     ; Skip speed and course fields.
8755   5821 CD 2A 59            CALL GPS_SKIP_FIELD
8756   5824 D8                  RET C
8757   5825 CD 2A 59            CALL GPS_SKIP_FIELD
