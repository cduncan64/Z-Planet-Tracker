9338   5B96 3A 02 89            LD A,(AST_MONTH)
9339   5B99 3C                  INC A
9340   5B9A FE 0D               CP 13
9341   5B9C 38 12               JR C,GPS_LND_STORE_MONTH
9342   5B9E 3E 01               LD A,1
9343   5BA0 32 02 89            LD (AST_MONTH),A
