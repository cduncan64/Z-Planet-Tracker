8876   58B1             GPS_PARSE_TIME:
8877   58B1 CD 8C 58            CALL GPS_PARSE_2DIG
8878   58B4 D8                  RET C
8879   58B5 FE 18               CP 24
8880   58B7 30 33               JR NC,GPS_TIME_BAD
8881   58B9 32 2F 8A            LD (GPS_TMP_UTC_HOUR),A
8882   58BC CD 8C 58            CALL GPS_PARSE_2DIG
8883   58BF D8                  RET C
8884   58C0 FE 3C               CP 60
8885   58C2 30 28               JR NC,GPS_TIME_BAD
8886   58C4 32 30 8A            LD (GPS_TMP_UTC_MIN),A
8887   58C7 CD 8C 58            CALL GPS_PARSE_2DIG
8888   58CA D8                  RET C
8889   58CB FE 3C               CP 60
