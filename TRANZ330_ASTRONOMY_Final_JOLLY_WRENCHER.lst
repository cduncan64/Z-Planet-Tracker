5046   3978             
5047   3978             ; ===========================================================================
5048   3978             ; V11d11i PRINT WORKFLOW
5049   3978             ; ===========================================================================
5050   3978             ; The PRINT screen is the last screen in every result carousel.
5051   3978             ;
5052   3978             ;   PRINT NO
5053   3978             ;       * -> PRINT YES
5054   3978             ;       # -> PRINT NO
5055   3978             ;       ENTER on NO returns to STATUS
5056   3978             ;       ENTER on YES enters NOW selection
5057   3978             ;
5058   3978             ;   NOW YES
5059   3978             ;       * -> NOW YES
5060   3978             ;       # -> NOW NO
5061   3978             ;       ENTER on YES prints the already calculated/current result
5062   3978             ;       ENTER on NO asks for a UTC date and time, calculates that instant
5063   3978             ;       temporarily, and prints it without permanently replacing the current
5064   3978             ;       displayed result.
5065   3978             ;
5066   3978             ; CLEAR remains globally meaningful while in the yes/no screens because they
5067   3978             ; use G_GET_UI_KEY.  Future DATE/TIME entry explicitly returns C on CLEAR so
5068   3978             ; the print workflow can be cancelled back to the PRINT screen.
5069   3978             ; ---------------------------------------------------------------------------
5070   3978             
5071   3978             G_DRAW_PRINT:
5072   3978 3A A0 8A            LD A,(G_PRINT_CHOICE)
5073   397B B7                  OR A
5074   397C 21 63 5E            LD HL,GMSG_PRINT_NO_HELP
5075   397F 28 03               JR Z,G_DP_SHOW
5076   3981 21 74 5E            LD HL,GMSG_PRINT_YES_HELP
5077   3984             G_DP_SHOW:
5078   3984 C3 2E 06            JP DISPLAY_SHOW
5079   3987             
5080   3987             G_PRINT_NOW_DIALOG:
5081   3987 3E 01               LD A,1
5082   3989 32 A1 8A            LD (G_PRINT_NOW),A
5083   398C             G_PRINT_NOW_REDRAW:
5084   398C 3A A1 8A            LD A,(G_PRINT_NOW)
5085   398F B7                  OR A
5086   3990 21 85 5E            LD HL,GMSG_NOW_NO_HELP
5087   3993 28 03               JR Z,G_PND_SHOW
5088   3995 21 96 5E            LD HL,GMSG_NOW_YES_HELP
5089   3998             G_PND_SHOW:
5090   3998 CD 2E 06            CALL DISPLAY_SHOW
5091   399B             
5092   399B             G_PRINT_NOW_WAIT:
5093   399B CD E1 37            CALL G_GET_UI_KEY
5094   399E FE 0D               CP KEY_UTC_NEG                 ; * toggles NO <-> YES
5095   39A0 28 0E               JR Z,G_PND_TOGGLE
5096   39A2 FE 10               CP KEY_ENTER
5097   39A4 20 F5               JR NZ,G_PRINT_NOW_WAIT
5098   39A6             
