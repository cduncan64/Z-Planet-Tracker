3796   182A CB 7C               BIT 7,H
3797   182C 28 0B               JR Z,AAT_XABS
3798   182E CD CF 19            CALL ASTRO_NEG_HL
3799   1831 3A 74 89            LD A,(AST_QUAD)
3800   1834 F6 02               OR 2
3801   1836 32 74 89            LD (AST_QUAD),A
3802   1839             AAT_XABS:
