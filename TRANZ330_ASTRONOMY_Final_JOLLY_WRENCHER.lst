3524   167C             ; Unsigned HL * DE -> 32-bit M32_ACC.
3525   167C             ASTRO_UMUL16:
3526   167C                     ; PURE Z80 FAST unsigned HL * DE -> 32-bit M32_ACC.
3527   167C                     ; Product is accumulated in HL:IX, avoiding four-byte RAM shifts and
3528   167C                     ; helper CALLs for every multiplier bit. No Z180 MLT is used.
3529   167C DD E5               PUSH IX
3530   167E E5                  PUSH HL
3531   167F C1                  POP BC                     ; BC = multiplicand
3532   1680 21 00 00            LD HL,0                    ; high product
3533   1683 DD 21 00 00         LD IX,0                    ; low product
3534   1687 3E 10               LD A,16
3535   1689             AUM16_FAST_LOOP:
3536   1689 DD 29               ADD IX,IX                  ; 32-bit product <<= 1
3537   168B ED 6A               ADC HL,HL
3538   168D CB 7A               BIT 7,D                    ; consume multiplier MSB first
3539   168F 28 05               JR Z,AUM16_FAST_NOADD
3540   1691 DD 09               ADD IX,BC
3541   1693 30 01               JR NC,AUM16_FAST_NOADD
3542   1695 23                  INC HL                     ; carry into high word
3543   1696             AUM16_FAST_NOADD:
