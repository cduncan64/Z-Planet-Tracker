5338   3B3D 3E 55               LD A,'U'
5339   3B3F CD 51 06            CALL DISPLAY_PUT_ASCII
5340   3B42             
5341   3B42             G_PRS_KEY:
5342   3B42 CD 3E 02            CALL KEY_GET
5343   3B45 FE 0C               CP KEY_ALPHA
5344   3B47 CA F3 37            JP Z,G_FULL_RESET
5345   3B4A FE 04               CP KEY_CLEAR
