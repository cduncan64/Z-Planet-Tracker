6757   4883 2A CA 89            LD HL,(G_XV)
6758   4886 ED 5B 93 89         LD DE,(G_TMPW3)
6759   488A CD 34 16            CALL ASTRO_MUL_Q15
6760   488D 22 8D 89            LD (G_TMPW0),HL
6761   4890 2A CC 89            LD HL,(G_YV)
6762   4893 ED 5B 91 89         LD DE,(G_TMPW2)
6763   4897 CD 34 16            CALL ASTRO_MUL_Q15
6764   489A EB                  EX DE,HL
6765   489B 2A 8D 89            LD HL,(G_TMPW0)
6766   489E 19                  ADD HL,DE
6767   489F 22 C8 89            LD (G_SY),HL
