9323   5B82             GPS_LPD_STORE_DAY:
9324   5B82 32 03 89            LD (AST_DAY),A
9325   5B85 C9                  RET
9326   5B86             
9327   5B86             
9328   5B86             ; Advance AST local calendar by one day (2000..2099).
9329   5B86             GPS_LOCAL_NEXT_DAY:
9330   5B86 3A 03 89            LD A,(AST_DAY)
9331   5B89 3C                  INC A
9332   5B8A 47                  LD B,A
9333   5B8B CD 21 0E            CALL ASTRO_DAYS_IN_MONTH
9334   5B8E B8                  CP B
