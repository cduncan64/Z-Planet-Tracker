9360   5BB9             ; ---------------------------------------------------------------------------
9361   5BB9             ; Dynamic result displays.
9362   5BB9             ; ---------------------------------------------------------------------------
9363   5BB9             G_DRAW_UTC_DATE_TIME:
9364   5BB9                     ; Refresh local civil time from the battery-backed RTC every time this
9365   5BB9                     ; result screen is entered, then derive UTC using the one-time offset
9366   5BB9                     ; selected immediately after GPS acquisition.
9367   5BB9 CD BE 06            CALL ASTRO_CLOCK_INIT
9368   5BBC CD F9 5B            CALL G_RTC_LOCAL_TO_UTC
9369   5BBF CD 1A 06            CALL DISPLAY_CLEAR
9370   5BC2 3A 19 8A            LD A,(GPS_UTC_MONTH)
9371   5BC5 CD 9A 06            CALL DISPLAY_DEC2
9372   5BC8 3E 2F               LD A,'/'
9373   5BCA CD 51 06            CALL DISPLAY_PUT_ASCII
9374   5BCD 3A 1A 8A            LD A,(GPS_UTC_DAY)
9375   5BD0 CD 9A 06            CALL DISPLAY_DEC2
9376   5BD3 3E 2F               LD A,'/'
9377   5BD5 CD 51 06            CALL DISPLAY_PUT_ASCII
9378   5BD8 3A 18 8A            LD A,(GPS_UTC_YEAR)
9379   5BDB CD 9A 06            CALL DISPLAY_DEC2
9380   5BDE 3E 20               LD A,' '
9381   5BE0 CD 51 06            CALL DISPLAY_PUT_ASCII
9382   5BE3 3A 1B 8A            LD A,(GPS_UTC_HOUR)
9383   5BE6 CD 9A 06            CALL DISPLAY_DEC2
9384   5BE9 3E 3A               LD A,':'
9385   5BEB CD 51 06            CALL DISPLAY_PUT_ASCII
9386   5BEE 3A 1C 8A            LD A,(GPS_UTC_MINUTE)
9387   5BF1 CD 9A 06            CALL DISPLAY_DEC2
9388   5BF4 3E 55               LD A,'U'
9389   5BF6 C3 51 06            JP DISPLAY_PUT_ASCII
9390   5BF9             
9391   5BF9             ; Build dynamic UTC display fields from current RTC local time.
9392   5BF9             ; UTC = local - selected signed whole-hour offset.  Because the supported
9393   5BF9             ; range is +/-12 hours, at most one date rollover is required.
9394   5BF9             G_RTC_LOCAL_TO_UTC:
9395   5BF9 3A 01 89            LD A,(AST_YEAR)
9396   5BFC 32 18 8A            LD (GPS_UTC_YEAR),A
9397   5BFF 3A 02 89            LD A,(AST_MONTH)
9398   5C02 32 19 8A            LD (GPS_UTC_MONTH),A
9399   5C05 3A 03 89            LD A,(AST_DAY)
9400   5C08 32 1A 8A            LD (GPS_UTC_DAY),A
9401   5C0B 3A 05 89            LD A,(AST_MINUTE)
9402   5C0E 32 1C 8A            LD (GPS_UTC_MINUTE),A
9403   5C11 3A 57 89            LD A,(AST_SECOND)
9404   5C14 32 1D 8A            LD (GPS_UTC_SECOND),A
9405   5C17             
9406   5C17 3A 04 89            LD A,(AST_HOUR)
9407   5C1A 6F                  LD L,A
9408   5C1B 26 00               LD H,0
9409   5C1D 3A 7B 89            LD A,(AST_UTC_OFFSET_HR)
9410   5C20 5F                  LD E,A
9411   5C21 16 00               LD D,0
9412   5C23 CB 7F               BIT 7,A
9413   5C25 28 02               JR Z,G_RTC_UTC_OFFSET_EXTENDED
9414   5C27 16 FF               LD D,$FF
9415   5C29             G_RTC_UTC_OFFSET_EXTENDED:
9416   5C29 B7                  OR A
9417   5C2A ED 52               SBC HL,DE                 ; UTC hour = local hour - offset
9418   5C2C CB 7C               BIT 7,H
9419   5C2E 28 0C               JR Z,G_RTC_UTC_NONNEG
9420   5C30 11 18 00            LD DE,24
9421   5C33 19                  ADD HL,DE
9422   5C34 7D                  LD A,L
9423   5C35 32 1B 8A            LD (GPS_UTC_HOUR),A
9424   5C38 CD 57 5C            CALL G_RTC_UTC_PREVIOUS_DAY
9425   5C3B C9                  RET
9426   5C3C             G_RTC_UTC_NONNEG:
9427   5C3C 7C                  LD A,H
