5329   3B33 E5                  PUSH HL
5330   3B34 CD 51 06            CALL DISPLAY_PUT_ASCII
5331   3B37 E1                  POP HL
5332   3B38 D1                  POP DE
5333   3B39 C1                  POP BC
5334   3B3A 23                  INC HL
5335   3B3B 10 D5               DJNZ G_PRS_CHAR
5336   3B3D             
