8647   57A1 C9                  RET
8648   57A2             
8649   57A2             GPS_RX_END:
8650   57A2 AF                  XOR A
8651   57A3 32 26 8A            LD (GPS_COLLECTING),A
8652   57A6 3A 27 8A            LD A,(GPS_INDEX)
8653   57A9 B7                  OR A
8654   57AA C8                  RET Z
8655   57AB 5F                  LD E,A
8656   57AC 16 00               LD D,0
