3776   180F             ; ATAN2
3777   180F             ; ============================================================================
3778   180F             
3779   180F             ; HL=y signed, DE=x signed.
3780   180F             ; Return HL=0..3599, 0=N/+x axis in mathematical atan2 convention.
3781   180F             ; Caller passes east as y, north as x, therefore result is azimuth from north.
3782   180F             ASTRO_ATAN2_10:
3783   180F 22 3F 89            LD (AST_TMP0),HL           ; y
3784   1812 ED 53 41 89         LD (AST_TMP1),DE           ; x
3785   1816 AF                  XOR A
3786   1817 32 74 89            LD (AST_QUAD),A            ; quadrant flags
3787   181A             
3788   181A CB 7C               BIT 7,H
3789   181C 28 0B               JR Z,AAT_YABS
3790   181E CD CF 19            CALL ASTRO_NEG_HL
3791   1821 3A 74 89            LD A,(AST_QUAD)
3792   1824 F6 01               OR 1
3793   1826 32 74 89            LD (AST_QUAD),A
3794   1829             AAT_YABS:
