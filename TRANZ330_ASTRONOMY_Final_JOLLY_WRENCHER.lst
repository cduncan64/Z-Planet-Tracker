8426   562F             ; ============================================================================
8427   562F             ; V11 GPS RMC INPUT
8428   562F             ; Wait for checksum-valid $GPRMC/$GNRMC status A, capture UTC and site, then
8429   562F             ; ask once for the local UTC offset.  * decrements one hour, # increments one
8430   562F             ; hour, ENTER accepts.  The selected offset is then applied to the GPS UTC,
8431   562F             ; and the resulting local civil time is written to the battery-backed RTC.
8432   562F             ; ============================================================================
8433   562F             
8434   562F             GPS_STARTUP_WAIT:
8435   562F CD BE 06            CALL ASTRO_CLOCK_INIT
8436   5632 21 00 00            LD HL,0
8437   5635 22 77 89            LD (AST_UTC_OFFSET_MIN),HL
8438   5638 AF                  XOR A
8439   5639 32 7B 89            LD (AST_UTC_OFFSET_HR),A
8440   563C 32 26 8A            LD (GPS_COLLECTING),A
8441   563F 32 27 8A            LD (GPS_INDEX),A
8442   5642 32 28 8A            LD (GPS_FIX_READY),A
8443   5645 21 7B 5D            LD HL,GMSG_ACQUIRING_GPS
8444   5648 CD 2E 06            CALL DISPLAY_SHOW
8445   564B             GPS_WAIT_LOOP:
8446   564B                     ; Allow ALPHA to restart while waiting for GPS.
8447   564B CD E8 01            CALL KEY_SCAN
8448   564E FE 0C               CP KEY_ALPHA
8449   5650 CA F3 37            JP Z,G_FULL_RESET
8450   5653             
8451   5653 DB 23               IN A,(DART_B_CTRL)
8452   5655 E6 01               AND $01
8453   5657 28 F2               JR Z,GPS_WAIT_LOOP
8454   5659 DB 22               IN A,(DART_B_DATA)
8455   565B CD 62 57            CALL GPS_RX_BYTE
8456   565E 3A 28 8A            LD A,(GPS_FIX_READY)
8457   5661 B7                  OR A
8458   5662 28 E7               JR Z,GPS_WAIT_LOOP
8459   5664             
8460   5664 21 8C 5D            LD HL,GMSG_GPS_FIX
8461   5667 CD 2E 06            CALL DISPLAY_SHOW
8462   566A CD 53 57            CALL GPS_DELAY_1S
8463   566D CD 7C 56            CALL GPS_SELECT_UTC_OFFSET
8464   5670 CD F7 56            CALL GPS_APPLY_OFFSET_TO_LOCAL
8465   5673 CD A0 07            CALL RTC_WRITE_LOCAL
8466   5676 3E 01               LD A,1
8467   5678 32 00 89            LD (AST_CLOCK_OK),A
8468   567B C9                  RET
8469   567C             
8470   567C             ; Select one whole-hour local offset from UTC, once after each fresh GPS fix.
8471   567C             ; Starts at UTC+00.  * moves west/down one hour; # moves east/up one hour.
8472   567C             ; Range is UTC-12 through UTC+12.  CLEAR resets the choice to UTC+00.
8473   567C             GPS_SELECT_UTC_OFFSET:
8474   567C AF                  XOR A
8475   567D 32 7B 89            LD (AST_UTC_OFFSET_HR),A
8476   5680             GPS_UTC_OFFSET_DRAW:
8477   5680 CD 1A 06            CALL DISPLAY_CLEAR
8478   5683 21 92 1A            LD HL,GMSG_UTC_SELECT
8479   5686 CD 48 06            CALL DISPLAY_PRINT_Z
8480   5689 3A 7B 89            LD A,(AST_UTC_OFFSET_HR)
8481   568C CB 7F               BIT 7,A
8482   568E 20 09               JR NZ,GPS_UTC_OFFSET_NEG_DRAW
8483   5690 F5                  PUSH AF
8484   5691 3E 2B               LD A,'+'
8485   5693 CD 51 06            CALL DISPLAY_PUT_ASCII
8486   5696 F1                  POP AF
8487   5697 18 09               JR GPS_UTC_OFFSET_MAG_DRAW
8488   5699             GPS_UTC_OFFSET_NEG_DRAW:
8489   5699 F5                  PUSH AF
8490   569A 3E 2D               LD A,'-'
8491   569C CD 51 06            CALL DISPLAY_PUT_ASCII
8492   569F F1                  POP AF
8493   56A0 2F                  CPL
8494   56A1 3C                  INC A
8495   56A2             GPS_UTC_OFFSET_MAG_DRAW:
8496   56A2 CD 9A 06            CALL DISPLAY_DEC2
8497   56A5             GPS_UTC_OFFSET_KEY:
8498   56A5 CD 3E 02            CALL KEY_GET
8499   56A8 FE 0C               CP KEY_ALPHA
8500   56AA CA F3 37            JP Z,G_FULL_RESET
8501   56AD FE 04               CP KEY_CLEAR
8502   56AF 28 CB               JR Z,GPS_SELECT_UTC_OFFSET
8503   56B1 FE 10               CP KEY_ENTER
8504   56B3 28 24               JR Z,GPS_UTC_OFFSET_ACCEPT
8505   56B5 FE 0D               CP KEY_UTC_NEG             ; * = one hour more negative
8506   56B7 28 06               JR Z,GPS_UTC_OFFSET_DEC
8507   56B9 FE 0F               CP KEY_UTC_POS             ; # = one hour more positive
8508   56BB 28 0F               JR Z,GPS_UTC_OFFSET_INC
8509   56BD 18 E6               JR GPS_UTC_OFFSET_KEY
8510   56BF             GPS_UTC_OFFSET_DEC:
8511   56BF 3A 7B 89            LD A,(AST_UTC_OFFSET_HR)
8512   56C2 FE F4               CP $F4                     ; -12 in 8-bit two's complement
8513   56C4 28 BA               JR Z,GPS_UTC_OFFSET_DRAW
8514   56C6 3D                  DEC A
8515   56C7 32 7B 89            LD (AST_UTC_OFFSET_HR),A
8516   56CA 18 B4               JR GPS_UTC_OFFSET_DRAW
8517   56CC             GPS_UTC_OFFSET_INC:
8518   56CC 3A 7B 89            LD A,(AST_UTC_OFFSET_HR)
8519   56CF FE 0C               CP 12
8520   56D1 28 AD               JR Z,GPS_UTC_OFFSET_DRAW
8521   56D3 3C                  INC A
8522   56D4 32 7B 89            LD (AST_UTC_OFFSET_HR),A
8523   56D7 18 A7               JR GPS_UTC_OFFSET_DRAW
8524   56D9             GPS_UTC_OFFSET_ACCEPT:
8525   56D9                     ; Convert signed whole hours to signed minutes for all astronomy math.
8526   56D9 3A 7B 89            LD A,(AST_UTC_OFFSET_HR)
8527   56DC 6F                  LD L,A
8528   56DD 26 00               LD H,0
8529   56DF CB 7F               BIT 7,A
8530   56E1 28 02               JR Z,GPS_UTC_OFFSET_EXTENDED
8531   56E3 26 FF               LD H,$FF
8532   56E5             GPS_UTC_OFFSET_EXTENDED:
8533   56E5 E5                  PUSH HL                    ; x1
8534   56E6 29                  ADD HL,HL                 ; x2
8535   56E7 29                  ADD HL,HL                 ; x4
8536   56E8 EB                  EX DE,HL                  ; DE=x4
8537   56E9 E1                  POP HL                    ; HL=x1
8538   56EA 29                  ADD HL,HL                 ; x2
8539   56EB 29                  ADD HL,HL                 ; x4
8540   56EC 29                  ADD HL,HL                 ; x8
8541   56ED 29                  ADD HL,HL                 ; x16
8542   56EE 29                  ADD HL,HL                 ; x32
8543   56EF 29                  ADD HL,HL                 ; x64
8544   56F0 B7                  OR A
8545   56F1 ED 52               SBC HL,DE                 ; x60
8546   56F3 22 77 89            LD (AST_UTC_OFFSET_MIN),HL
8547   56F6 C9                  RET
8548   56F7             
8549   56F7             ; Convert the just-received GPS UTC date/time to selected local civil time.
8550   56F7             ; Offset range is only +/-12h, so at most one calendar-day adjustment occurs.
8551   56F7             GPS_APPLY_OFFSET_TO_LOCAL:
8552   56F7 3A 18 8A            LD A,(GPS_UTC_YEAR)
8553   56FA 32 01 89            LD (AST_YEAR),A
8554   56FD 3A 19 8A            LD A,(GPS_UTC_MONTH)
8555   5700 32 02 89            LD (AST_MONTH),A
8556   5703 3A 1A 8A            LD A,(GPS_UTC_DAY)
8557   5706 32 03 89            LD (AST_DAY),A
8558   5709 3A 1C 8A            LD A,(GPS_UTC_MINUTE)
8559   570C 32 05 89            LD (AST_MINUTE),A
8560   570F 3A 1D 8A            LD A,(GPS_UTC_SECOND)
8561   5712 32 57 89            LD (AST_SECOND),A
8562   5715             
8563   5715 3A 1B 8A            LD A,(GPS_UTC_HOUR)
8564   5718 6F                  LD L,A
8565   5719 26 00               LD H,0
8566   571B 3A 7B 89            LD A,(AST_UTC_OFFSET_HR)
8567   571E 5F                  LD E,A
8568   571F 16 00               LD D,0
8569   5721 CB 7F               BIT 7,A
8570   5723 28 02               JR Z,GPS_APPLY_OFFSET_EXTENDED
8571   5725 16 FF               LD D,$FF
8572   5727             GPS_APPLY_OFFSET_EXTENDED:
8573   5727 19                  ADD HL,DE
8574   5728 CB 7C               BIT 7,H
8575   572A 28 0C               JR Z,GPS_APPLY_OFFSET_NONNEG
8576   572C 11 18 00            LD DE,24
8577   572F 19                  ADD HL,DE
8578   5730 7D                  LD A,L
8579   5731 32 04 89            LD (AST_HOUR),A
8580   5734 CD 5C 5B            CALL GPS_LOCAL_PREVIOUS_DAY
8581   5737 C9                  RET
8582   5738             GPS_APPLY_OFFSET_NONNEG:
8583   5738 7C                  LD A,H
8584   5739 B7                  OR A
8585   573A 20 09               JR NZ,GPS_APPLY_OFFSET_NEXT
8586   573C 7D                  LD A,L
8587   573D FE 18               CP 24
8588   573F 30 04               JR NC,GPS_APPLY_OFFSET_NEXT
8589   5741 32 04 89            LD (AST_HOUR),A
8590   5744 C9                  RET
8591   5745             GPS_APPLY_OFFSET_NEXT:
