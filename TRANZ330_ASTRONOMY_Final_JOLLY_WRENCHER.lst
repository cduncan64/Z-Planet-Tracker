8991   595B 7C                  LD A,H
8992   595C B5                  OR L
8993   595D 20 66               JR NZ,GPS_COORD_BAD
8994   595F             GPS_LAT_RANGE_OK:
8995   595F 3A 3E 8A            LD A,(GPS_TMP_COORD_DEG)
8996   5962 32 32 8A            LD (GPS_TMP_LAT_DEG),A
8997   5965 2A 3F 8A            LD HL,(GPS_TMP_COORD_FRAC3)
8998   5968 22 33 8A            LD (GPS_TMP_LAT_FRAC3),HL
8999   596B 2A 41 8A            LD HL,(GPS_TMP_COORD_ANGLE10)
9000   596E 22 3A 8A            LD (GPS_TMP_LAT10),HL
9001   5971 2A 2A 8A            LD HL,(GPS_FIELD_PTR)
9002   5974 B7                  OR A
9003   5975 C9                  RET
9004   5976             
9005   5976             GPS_PARSE_LON_FIELD:
9006   5976                     ; Three degree digits, 000..180.
9007   5976 7E                  LD A,(HL)
9008   5977 CD A3 58            CALL GPS_ASCII_DIGIT
9009   597A D8                  RET C
9010   597B F5                  PUSH AF                       ; preserve hundreds digit
9011   597C 23                  INC HL
9012   597D CD 8C 58            CALL GPS_PARSE_2DIG
9013   5980 38 42               JR C,GPS_LON_POP_BAD
9014   5982 4F                  LD C,A                        ; low two degree digits
9015   5983 F1                  POP AF
9016   5984 B7                  OR A
9017   5985 28 09               JR Z,GPS_LON_DEG_HAVE
9018   5987                     ; 1xx only; 2xx is outside longitude range.
9019   5987 FE 01               CP 1
9020   5989 20 3A               JR NZ,GPS_COORD_BAD
9021   598B 79                  LD A,C
9022   598C C6 64               ADD A,100
9023   598E 18 01               JR GPS_LON_DEG_STORE
9024   5990             GPS_LON_DEG_HAVE:
9025   5990 79                  LD A,C
9026   5991             GPS_LON_DEG_STORE:
9027   5991 FE B5               CP 181
9028   5993 30 30               JR NC,GPS_COORD_BAD
9029   5995 32 3E 8A            LD (GPS_TMP_COORD_DEG),A
9030   5998 32 49 8A            LD (GPS_TMP_COORD_ORIG_DEG),A
9031   599B CD C7 59            CALL GPS_PARSE_MINUTES
9032   599E D8                  RET C
9033   599F                     ; 180 degrees is valid only with 00.000 minutes.
9034   599F 3A 49 8A            LD A,(GPS_TMP_COORD_ORIG_DEG)
9035   59A2 FE B4               CP 180
9036   59A4 20 07               JR NZ,GPS_LON_RANGE_OK
9037   59A6 2A 47 8A            LD HL,(GPS_TMP_MIN_MILLI)
9038   59A9 7C                  LD A,H
9039   59AA B5                  OR L
9040   59AB 20 18               JR NZ,GPS_COORD_BAD
9041   59AD             GPS_LON_RANGE_OK:
9042   59AD 3A 3E 8A            LD A,(GPS_TMP_COORD_DEG)
9043   59B0 32 36 8A            LD (GPS_TMP_LON_DEG),A
9044   59B3 2A 3F 8A            LD HL,(GPS_TMP_COORD_FRAC3)
9045   59B6 22 37 8A            LD (GPS_TMP_LON_FRAC3),HL
9046   59B9 2A 41 8A            LD HL,(GPS_TMP_COORD_ANGLE10)
9047   59BC 22 3C 8A            LD (GPS_TMP_LON10),HL
9048   59BF 2A 2A 8A            LD HL,(GPS_FIELD_PTR)
9049   59C2 B7                  OR A
9050   59C3 C9                  RET
9051   59C4             GPS_LON_POP_BAD:
9052   59C4 F1                  POP AF
9053   59C5             GPS_COORD_BAD:
9054   59C5 37                  SCF
9055   59C6 C9                  RET
9056   59C7             
9057   59C7             ; Input HL points at MM.m... of a coordinate. Requires at least one
9058   59C7             ; fractional digit. Returns through GPS_FIELD_PTR with HL after the comma.
9059   59C7             ; Uses the first three fractional minute digits (zero-padded) for display
9060   59C7             ; rounding; later digits are syntactically validated and ignored.
9061   59C7             GPS_PARSE_MINUTES:
9062   59C7 CD 8C 58            CALL GPS_PARSE_2DIG
9063   59CA D8                  RET C
9064   59CB FE 3C               CP 60
9065   59CD D2 9B 5A            JP NC,GPS_MIN_BAD
9066   59D0 32 43 8A            LD (GPS_TMP_MINUTES),A
9067   59D3 7E                  LD A,(HL)
9068   59D4 FE 2E               CP '.'
9069   59D6 C2 9B 5A            JP NZ,GPS_MIN_BAD
9070   59D9 23                  INC HL
9071   59DA AF                  XOR A
9072   59DB 32 44 8A            LD (GPS_TMP_F1),A
9073   59DE 32 45 8A            LD (GPS_TMP_F2),A
9074   59E1 32 46 8A            LD (GPS_TMP_F3),A
9075   59E4 06 00               LD B,0
9076   59E6             GPS_MIN_FRAC_LOOP:
9077   59E6 7E                  LD A,(HL)
9078   59E7 FE 2C               CP ','
9079   59E9 28 27               JR Z,GPS_MIN_FRAC_DONE
9080   59EB CD A3 58            CALL GPS_ASCII_DIGIT
9081   59EE DA 9B 5A            JP C,GPS_MIN_BAD
9082   59F1 4F                  LD C,A
9083   59F2 78                  LD A,B
9084   59F3 B7                  OR A
9085   59F4 20 06               JR NZ,GPS_MIN_NOT_F1
9086   59F6 79                  LD A,C
9087   59F7 32 44 8A            LD (GPS_TMP_F1),A
9088   59FA 18 12               JR GPS_MIN_NEXT
9089   59FC             GPS_MIN_NOT_F1:
9090   59FC FE 01               CP 1
9091   59FE 20 06               JR NZ,GPS_MIN_NOT_F2
9092   5A00 79                  LD A,C
9093   5A01 32 45 8A            LD (GPS_TMP_F2),A
9094   5A04 18 08               JR GPS_MIN_NEXT
9095   5A06             GPS_MIN_NOT_F2:
9096   5A06 FE 02               CP 2
9097   5A08 20 04               JR NZ,GPS_MIN_NEXT
9098   5A0A 79                  LD A,C
9099   5A0B 32 46 8A            LD (GPS_TMP_F3),A
9100   5A0E             GPS_MIN_NEXT:
9101   5A0E 04                  INC B
9102   5A0F 23                  INC HL
9103   5A10 18 D4               JR GPS_MIN_FRAC_LOOP
9104   5A12             GPS_MIN_FRAC_DONE:
9105   5A12 78                  LD A,B
9106   5A13 B7                  OR A
9107   5A14 CA 9B 5A            JP Z,GPS_MIN_BAD
9108   5A17 23                  INC HL
9109   5A18 22 2A 8A            LD (GPS_FIELD_PTR),HL
9110   5A1B             
9111   5A1B                     ; minute_milli = minutes*1000 + first three fractional digits.
9112   5A1B 3A 43 8A            LD A,(GPS_TMP_MINUTES)
9113   5A1E 6F                  LD L,A
9114   5A1F 26 00               LD H,0
9115   5A21 CD AE 5A            CALL GPS_MUL10_HL
9116   5A24 CD AE 5A            CALL GPS_MUL10_HL
9117   5A27 CD AE 5A            CALL GPS_MUL10_HL
9118   5A2A E5                  PUSH HL
9119   5A2B 3A 44 8A            LD A,(GPS_TMP_F1)
9120   5A2E 6F                  LD L,A
9121   5A2F 26 00               LD H,0
9122   5A31 CD AE 5A            CALL GPS_MUL10_HL
9123   5A34 CD AE 5A            CALL GPS_MUL10_HL
9124   5A37 54                  LD D,H
9125   5A38 5D                  LD E,L
9126   5A39 3A 45 8A            LD A,(GPS_TMP_F2)
9127   5A3C 6F                  LD L,A
9128   5A3D 26 00               LD H,0
9129   5A3F CD AE 5A            CALL GPS_MUL10_HL
9130   5A42 19                  ADD HL,DE
9131   5A43 3A 46 8A            LD A,(GPS_TMP_F3)
9132   5A46 5F                  LD E,A
9133   5A47 16 00               LD D,0
9134   5A49 19                  ADD HL,DE
9135   5A4A EB                  EX DE,HL
9136   5A4B E1                  POP HL
9137   5A4C 19                  ADD HL,DE
9138   5A4D 22 47 8A            LD (GPS_TMP_MIN_MILLI),HL
9139   5A50             
9140   5A50                     ; angle10 = original degree*10 + round(minute_milli / 6000).
9141   5A50                     ; Do this BEFORE display rounding, because 59.999 minutes may carry
9142   5A50                     ; the displayed coordinate into the next whole degree.
9143   5A50 2A 47 8A            LD HL,(GPS_TMP_MIN_MILLI)
9144   5A53 11 B8 0B            LD DE,3000
9145   5A56 19                  ADD HL,DE
9146   5A57 11 70 17            LD DE,6000
9147   5A5A 06 00               LD B,0
9148   5A5C             GPS_DIV6000_LOOP:
9149   5A5C B7                  OR A
9150   5A5D ED 52               SBC HL,DE
9151   5A5F 38 03               JR C,GPS_DIV6000_DONE
9152   5A61 04                  INC B
9153   5A62 18 F8               JR GPS_DIV6000_LOOP
9154   5A64             GPS_DIV6000_DONE:
9155   5A64 3A 3E 8A            LD A,(GPS_TMP_COORD_DEG)
9156   5A67 6F                  LD L,A
9157   5A68 26 00               LD H,0
9158   5A6A CD AE 5A            CALL GPS_MUL10_HL
9159   5A6D 58                  LD E,B
9160   5A6E 16 00               LD D,0
9161   5A70 19                  ADD HL,DE
9162   5A71 22 41 8A            LD (GPS_TMP_COORD_ANGLE10),HL
9163   5A74             
9164   5A74                     ; frac3 degrees = round(minute_milli / 60), 0..1000.
9165   5A74 2A 47 8A            LD HL,(GPS_TMP_MIN_MILLI)
9166   5A77 11 1E 00            LD DE,30
9167   5A7A 19                  ADD HL,DE
9168   5A7B CD 9D 5A            CALL GPS_DIV60_16
9169   5A7E 11 E8 03            LD DE,1000
9170   5A81 B7                  OR A
9171   5A82 ED 52               SBC HL,DE
9172   5A84 38 0C               JR C,GPS_FRAC_LT1000
9173   5A86                     ; Rounded 59.999 minutes carries into the displayed next degree.
9174   5A86 21 00 00            LD HL,0
9175   5A89 3A 3E 8A            LD A,(GPS_TMP_COORD_DEG)
9176   5A8C 3C                  INC A
9177   5A8D 32 3E 8A            LD (GPS_TMP_COORD_DEG),A
9178   5A90 18 01               JR GPS_FRAC_STORE
9179   5A92             GPS_FRAC_LT1000:
9180   5A92 19                  ADD HL,DE
9181   5A93             GPS_FRAC_STORE:
9182   5A93 22 3F 8A            LD (GPS_TMP_COORD_FRAC3),HL
9183   5A96 2A 2A 8A            LD HL,(GPS_FIELD_PTR)
9184   5A99 B7                  OR A
9185   5A9A C9                  RET
9186   5A9B             GPS_MIN_BAD:
9187   5A9B 37                  SCF
9188   5A9C C9                  RET
9189   5A9D             
9190   5A9D             ; 16-bit unsigned divide by 60 for values <= 60029. HL=quotient.
9191   5A9D             GPS_DIV60_16:
9192   5A9D 01 00 00            LD BC,0
9193   5AA0 11 3C 00            LD DE,60
9194   5AA3             GPS_D60_16_LOOP:
9195   5AA3 B7                  OR A
9196   5AA4 ED 52               SBC HL,DE
9197   5AA6 38 03               JR C,GPS_D60_16_DONE
9198   5AA8 03                  INC BC
9199   5AA9 18 F8               JR GPS_D60_16_LOOP
9200   5AAB             GPS_D60_16_DONE:
9201   5AAB 60                  LD H,B
9202   5AAC 69                  LD L,C
9203   5AAD C9                  RET
9204   5AAE             
9205   5AAE             GPS_MUL10_HL:
9206   5AAE 29                  ADD HL,HL
9207   5AAF 54                  LD D,H
9208   5AB0 5D                  LD E,L
9209   5AB1 29                  ADD HL,HL
9210   5AB2 29                  ADD HL,HL
9211   5AB3 19                  ADD HL,DE
9212   5AB4 C9                  RET
9213   5AB5             
9214   5AB5             ; Days in GPS temporary UTC month/year. 2000..2099 leap rule.
9215   5AB5             GPS_TMP_DAYS_IN_MONTH:
9216   5AB5 3A 2D 8A            LD A,(GPS_TMP_UTC_MONTH)
9217   5AB8 FE 02               CP 2
9218   5ABA 28 16               JR Z,GPS_TDIM_FEB
9219   5ABC FE 04               CP 4
9220   5ABE 28 0F               JR Z,GPS_TDIM_30
9221   5AC0 FE 06               CP 6
9222   5AC2 28 0B               JR Z,GPS_TDIM_30
9223   5AC4 FE 09               CP 9
9224   5AC6 28 07               JR Z,GPS_TDIM_30
9225   5AC8 FE 0B               CP 11
9226   5ACA 28 03               JR Z,GPS_TDIM_30
9227   5ACC 3E 1F               LD A,31
9228   5ACE C9                  RET
9229   5ACF             GPS_TDIM_30:
9230   5ACF 3E 1E               LD A,30
9231   5AD1 C9                  RET
9232   5AD2             GPS_TDIM_FEB:
9233   5AD2 3A 2C 8A            LD A,(GPS_TMP_UTC_YEAR)
9234   5AD5 E6 03               AND 3
9235   5AD7 3E 1C               LD A,28
9236   5AD9 C0                  RET NZ
9237   5ADA 3C                  INC A
9238   5ADB C9                  RET
9239   5ADC             
9240   5ADC             GPS_COMMIT_FIX:
9241   5ADC                     ; Save UTC components exactly as received from RMC.
9242   5ADC 3A 2C 8A            LD A,(GPS_TMP_UTC_YEAR)
9243   5ADF 32 18 8A            LD (GPS_UTC_YEAR),A
9244   5AE2 3A 2D 8A            LD A,(GPS_TMP_UTC_MONTH)
9245   5AE5 32 19 8A            LD (GPS_UTC_MONTH),A
9246   5AE8 3A 2E 8A            LD A,(GPS_TMP_UTC_DAY)
9247   5AEB 32 1A 8A            LD (GPS_UTC_DAY),A
9248   5AEE 3A 2F 8A            LD A,(GPS_TMP_UTC_HOUR)
9249   5AF1 32 1B 8A            LD (GPS_UTC_HOUR),A
9250   5AF4 3A 30 8A            LD A,(GPS_TMP_UTC_MIN)
9251   5AF7 32 1C 8A            LD (GPS_UTC_MINUTE),A
9252   5AFA 3A 31 8A            LD A,(GPS_TMP_UTC_SEC)
9253   5AFD 32 1D 8A            LD (GPS_UTC_SECOND),A
9254   5B00             
9255   5B00                     ; Save display coordinates and hemispheres.
9256   5B00 3A 32 8A            LD A,(GPS_TMP_LAT_DEG)
9257   5B03 32 1E 8A            LD (GPS_SITE_LAT_DEG),A
9258   5B06 2A 33 8A            LD HL,(GPS_TMP_LAT_FRAC3)
9259   5B09 22 1F 8A            LD (GPS_SITE_LAT_FRAC3),HL
9260   5B0C 3A 35 8A            LD A,(GPS_TMP_LAT_HEMI)
9261   5B0F 32 21 8A            LD (GPS_SITE_LAT_HEMI),A
9262   5B12 3A 36 8A            LD A,(GPS_TMP_LON_DEG)
9263   5B15 32 22 8A            LD (GPS_SITE_LON_DEG),A
9264   5B18 2A 37 8A            LD HL,(GPS_TMP_LON_FRAC3)
9265   5B1B 22 23 8A            LD (GPS_SITE_LON_FRAC3),HL
9266   5B1E 3A 39 8A            LD A,(GPS_TMP_LON_HEMI)
9267   5B21 32 25 8A            LD (GPS_SITE_LON_HEMI),A
9268   5B24             
9269   5B24                     ; Signed latitude angle10.
9270   5B24 2A 3A 8A            LD HL,(GPS_TMP_LAT10)
9271   5B27 3A 35 8A            LD A,(GPS_TMP_LAT_HEMI)
9272   5B2A FE 53               CP 'S'
9273   5B2C 20 03               JR NZ,GPS_LAT10_SIGNED
9274   5B2E CD CF 19            CALL ASTRO_NEG_HL
9275   5B31             GPS_LAT10_SIGNED:
9276   5B31 22 12 8A            LD (G_SITE_LAT10),HL
9277   5B34             
9278   5B34                     ; Signed longitude angle10: west negative, east positive.
9279   5B34 2A 3C 8A            LD HL,(GPS_TMP_LON10)
9280   5B37 3A 39 8A            LD A,(GPS_TMP_LON_HEMI)
9281   5B3A FE 57               CP 'W'
9282   5B3C 20 03               JR NZ,GPS_LON10_SIGNED
9283   5B3E CD CF 19            CALL ASTRO_NEG_HL
9284   5B41             GPS_LON10_SIGNED:
9285   5B41 22 10 8A            LD (G_SITE_LON10),HL
9286   5B44             
9287   5B44                     ; Runtime latitude trig used by every old and new horizontal path.
9288   5B44 2A 12 8A            LD HL,(G_SITE_LAT10)
9289   5B47 CD 11 16            CALL ASTRO_SIN10_SIGNED
9290   5B4A 22 14 8A            LD (G_SITE_LAT_SIN_Q15),HL
9291   5B4D 2A 12 8A            LD HL,(G_SITE_LAT10)
9292   5B50 CD 21 16            CALL ASTRO_COS10_SIGNED
9293   5B53 22 16 8A            LD (G_SITE_LAT_COS_Q15),HL
9294   5B56             
9295   5B56                     ; A valid fix only captures GPS UTC/site here.  The startup path now
9296   5B56                     ; asks for the local UTC offset exactly once before converting time
9297   5B56                     ; or touching the RTC.
9298   5B56 3E 01               LD A,1
9299   5B58 32 28 8A            LD (GPS_FIX_READY),A
9300   5B5B C9                  RET
9301   5B5C             
9302   5B5C             GPS_LOCAL_PREVIOUS_DAY:
9303   5B5C 3A 03 89            LD A,(AST_DAY)
9304   5B5F 3D                  DEC A
9305   5B60 20 20               JR NZ,GPS_LPD_STORE_DAY
9306   5B62 3A 02 89            LD A,(AST_MONTH)
9307   5B65 3D                  DEC A
9308   5B66 20 14               JR NZ,GPS_LPD_HAVE_MONTH
9309   5B68 3E 0C               LD A,12
9310   5B6A 32 02 89            LD (AST_MONTH),A
9311   5B6D 3A 01 89            LD A,(AST_YEAR)
9312   5B70 3D                  DEC A
9313   5B71 FE FF               CP $FF
9314   5B73 20 02               JR NZ,GPS_LPD_STORE_YEAR
9315   5B75 3E 63               LD A,99
9316   5B77             GPS_LPD_STORE_YEAR:
9317   5B77 32 01 89            LD (AST_YEAR),A
9318   5B7A 18 03               JR GPS_LPD_GET_LAST
9319   5B7C             GPS_LPD_HAVE_MONTH:
9320   5B7C 32 02 89            LD (AST_MONTH),A
9321   5B7F             GPS_LPD_GET_LAST:
