5232   3AAE 32 A7 8A            LD (G_PRINT_UTC_SECOND),A
5233   3AB1             
5234   3AB1                     ; Convert entered UTC to local civil time using the already selected
5235   3AB1                     ; runtime UTC offset.  GPS_APPLY_OFFSET_TO_LOCAL only changes RAM; it
5236   3AB1                     ; does not write the RTC.
5237   3AB1 CD 66 3C            CALL G_COPY_PRINT_UTC_TO_GPS
5238   3AB4 CD F7 56            CALL GPS_APPLY_OFFSET_TO_LOCAL
5239   3AB7             
5240   3AB7                     ; Calculate the requested future instant using the current GPS site.
5241   3AB7                     ; Do not call G_CAPTURE_CALC_TIMESTAMP here: the normal current result
5242   3AB7                     ; must retain its original calculation timestamp.
5243   3AB7 AF                  XOR A
5244   3AB8 32 0B 8A            LD (G_PROGRESS),A
5245   3ABB CD 13 38            CALL G_DRAW_PROGRESS
5246   3ABE CD 2E 38            CALL G_CALC_COMMON
5247   3AC1 CD BE 47            CALL G_CALCULATE_SELECTED
5248   3AC4             
5249   3AC4                     ; Future-print calculations get the same audible completion indication
5250   3AC4                     ; as normal/current calculations.
5251   3AC4 CD B0 01            CALL CALC_DONE_TUNE
5252   3AC7             
5253   3AC7                     ; Future calculation is complete: print immediately.  There is no
5254   3AC7                     ; intermediate ENTER 2 PRINT confirmation screen.
5255   3AC7                     ; Reassert the entered UTC timestamp in case the calculation used
5256   3AC7                     ; GPS_UTC_* as scratch.
5257   3AC7 CD 66 3C            CALL G_COPY_PRINT_UTC_TO_GPS
5258   3ACA CD F0 42            CALL G_PRINT_REPORT_AND_FINISH
5259   3ACD             
5260   3ACD                     ; Put the original current result back exactly as it was before the
5261   3ACD                     ; temporary future calculation, then return to its first STATUS screen
5262   3ACD                     ; (for example "JUPITER VIS").
5263   3ACD CD E6 3B            CALL G_RESTORE_CURRENT_RESULT
5264   3AD0             
5265   3AD0                     ; Just like a CURRENT print, a completed FUTURE print must not leave
5266   3AD0                     ; the next PRINT screen defaulting to YES.
5267   3AD0 AF                  XOR A
5268   3AD1 32 A0 8A            LD (G_PRINT_CHOICE),A
5269   3AD4 32 81 89            LD (G_SCREEN),A
5270   3AD7 CD 68 38            CALL G_DRAW_RESULT_SCREEN
5271   3ADA C3 88 37            JP G_RESULT_WAIT
5272   3ADD             
5273   3ADD             G_PF_CANCEL:
5274   3ADD CD E6 3B            CALL G_RESTORE_CURRENT_RESULT
5275   3AE0 CD 78 39            CALL G_DRAW_PRINT
5276   3AE3 C3 B8 37            JP G_PRINT_SCREEN_WAIT
5277   3AE6             
5278   3AE6             ; Print-specific six-digit entry.
5279   3AE6             ; Uses DATE MM/DD/YY U or TIME HH/MM/SS U presentation.
5280   3AE6             ; ENTER is accepted only after six digits.
5281   3AE6             ; BACKSPACE removes a digit.
5282   3AE6             ; CLEAR cancels the print workflow and returns with carry set.
5283   3AE6             G_PRINT_READ_SIX:
5284   3AE6 AF                  XOR A
5285   3AE7 32 56 89            LD (AST_INCOUNT),A
5286   3AEA             
5287   3AEA             G_PRS_REDRAW:
