5918   4281 11 65 04            LD DE,1125
5919   4284 B7                  OR A
5920   4285 ED 52               SBC HL,DE
5921   4287 38 43               JR C,G_PMP_FIRST
5922   4289             
5923   4289 2A 8D 89            LD HL,(G_TMPW0)
5924   428C 11 27 06            LD DE,1575
5925   428F B7                  OR A
5926   4290 ED 52               SBC HL,DE
5927   4292 38 3E               JR C,G_PMP_WAX_GIB
5928   4294             
5929   4294 2A 8D 89            LD HL,(G_TMPW0)
5930   4297 11 E9 07            LD DE,2025
5931   429A B7                  OR A
5932   429B ED 52               SBC HL,DE
5933   429D 38 39               JR C,G_PMP_FULL
5934   429F             
5935   429F 2A 8D 89            LD HL,(G_TMPW0)
5936   42A2 11 AB 09            LD DE,2475
5937   42A5 B7                  OR A
