5183   3A48             G_RESTORE_AST_CLOCK_TEMP:
5184   3A48 3A C5 8A            LD A,(G_TMP_YEAR)
5185   3A4B 32 01 89            LD (AST_YEAR),A
5186   3A4E 3A C6 8A            LD A,(G_TMP_MONTH)
5187   3A51 32 02 89            LD (AST_MONTH),A
5188   3A54 3A C7 8A            LD A,(G_TMP_DAY)
5189   3A57 32 03 89            LD (AST_DAY),A
5190   3A5A 3A C8 8A            LD A,(G_TMP_HOUR)
5191   3A5D 32 04 89            LD (AST_HOUR),A
5192   3A60 3A C9 8A            LD A,(G_TMP_MINUTE)
5193   3A63 32 05 89            LD (AST_MINUTE),A
