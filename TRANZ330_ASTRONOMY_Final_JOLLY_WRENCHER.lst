8955   592A             ; HL at field start. Advance through field and comma. Empty fields are allowed.
8956   592A             GPS_SKIP_FIELD:
8957   592A             GPS_SKIP_LOOP:
8958   592A 7E                  LD A,(HL)
8959   592B B7                  OR A
