5687   4153             
5688   4153             G_PRINTER_INIT:
5689   4153                     ; DART B is already 9600 8-N-1 and TX-enabled by DEBUG_DART_INIT.
5690   4153 C9                  RET
5691   4154             
5692   4154             G_PRINTER_RESTORE_DEBUG:
5693   4154                     ; Nothing was reconfigured; leave the proven GPS/DART-B setup intact.
5694   4154 C9                  RET
5695   4155             
5696   4155             G_PRN_TX_CHAR:
5697   4155 C5                  PUSH BC
5698   4156 47                  LD B,A
5699   4157             G_PRN_TX_WAIT:
5700   4157 DB 23               IN A,(DART_B_CTRL)
5701   4159 E6 04               AND $04
5702   415B 28 FA               JR Z,G_PRN_TX_WAIT
5703   415D 78                  LD A,B
5704   415E D3 22               OUT (DART_B_DATA),A
5705   4160             
5706   4160                     ; Approximately 12 ms pacing at the firmware's nominal DELAY_2MS.
5707   4160 06 06               LD B,6
5708   4162             G_PRN_PACE:
5709   4162 CD B2 06            CALL DELAY_2MS
5710   4165 10 FB               DJNZ G_PRN_PACE
5711   4167 C1                  POP BC
5712   4168 C9                  RET
5713   4169             
5714   4169             G_PRN_PRINT_Z:
5715   4169 F5                  PUSH AF
5716   416A E5                  PUSH HL
5717   416B             G_PRN_PZ_LOOP:
5718   416B 7E                  LD A,(HL)
5719   416C B7                  OR A
5720   416D 28 06               JR Z,G_PRN_PZ_DONE
5721   416F CD 55 41            CALL G_PRN_TX_CHAR
5722   4172 23                  INC HL
5723   4173 18 F6               JR G_PRN_PZ_LOOP
5724   4175             G_PRN_PZ_DONE:
5725   4175 E1                  POP HL
5726   4176 F1                  POP AF
5727   4177 C9                  RET
5728   4178             
5729   4178             G_PRN_CRLF:
5730   4178 3E 0D               LD A,13
5731   417A CD 55 41            CALL G_PRN_TX_CHAR
5732   417D 3E 0A               LD A,10
5733   417F CD 55 41            CALL G_PRN_TX_CHAR
5734   4182             
5735   4182                     ; Extra end-of-line settling pause: 200 x nominal 2 ms = ~400 ms.
5736   4182                     ; Existing per-character pacing in G_PRN_TX_CHAR is unchanged.
5737   4182 C5                  PUSH BC
5738   4183 06 C8               LD B,200              ; 200 x nominal 2 ms = ~400 ms
5739   4185             G_PRN_EOL_PAUSE:
5740   4185 CD B2 06            CALL DELAY_2MS
5741   4188 10 FB               DJNZ G_PRN_EOL_PAUSE
5742   418A C1                  POP BC
5743   418B C9                  RET
5744   418C             
5745   418C             ; A=0..99, print exactly two decimal digits.
5746   418C             G_PRN_DEC2:
5747   418C C5                  PUSH BC
5748   418D 06 30               LD B,'0'
5749   418F             G_PD2_LOOP:
5750   418F FE 0A               CP 10
5751   4191 38 05               JR C,G_PD2_DONE
5752   4193 D6 0A               SUB 10
5753   4195 04                  INC B
5754   4196 18 F7               JR G_PD2_LOOP
5755   4198             G_PD2_DONE:
5756   4198 4F                  LD C,A
5757   4199 78                  LD A,B
5758   419A CD 55 41            CALL G_PRN_TX_CHAR
5759   419D 79                  LD A,C
5760   419E C6 30               ADD A,'0'
5761   41A0 CD 55 41            CALL G_PRN_TX_CHAR
5762   41A3 C1                  POP BC
5763   41A4 C9                  RET
5764   41A5             
5765   41A5             ; HL=0..999, print exactly three decimal digits.
5766   41A5             G_PRN_DEC3:
5767   41A5 C5                  PUSH BC
5768   41A6 D5                  PUSH DE
5769   41A7 11 64 00            LD DE,100
5770   41AA CD BC 41            CALL G_PRN_DIGIT
5771   41AD 11 0A 00            LD DE,10
5772   41B0 CD BC 41            CALL G_PRN_DIGIT
5773   41B3 7D                  LD A,L
5774   41B4 C6 30               ADD A,'0'
5775   41B6 CD 55 41            CALL G_PRN_TX_CHAR
5776   41B9 D1                  POP DE
5777   41BA C1                  POP BC
5778   41BB C9                  RET
5779   41BC             
5780   41BC             ; Helper for fixed decimal digit, HL value and DE divisor.
5781   41BC             G_PRN_DIGIT:
5782   41BC 06 30               LD B,'0'
5783   41BE             G_PRN_DIGIT_LOOP:
5784   41BE B7                  OR A
5785   41BF ED 52               SBC HL,DE
5786   41C1 38 03               JR C,G_PRN_DIGIT_DONE
5787   41C3 04                  INC B
5788   41C4 18 F8               JR G_PRN_DIGIT_LOOP
5789   41C6             G_PRN_DIGIT_DONE:
5790   41C6 19                  ADD HL,DE
5791   41C7 78                  LD A,B
5792   41C8 C3 55 41            JP G_PRN_TX_CHAR
5793   41CB             
5794   41CB             ; HL unsigned 0..999, print without leading zeroes.
5795   41CB             G_PRN_U16_TRIM3:
5796   41CB C5                  PUSH BC
5797   41CC D5                  PUSH DE
5798   41CD 06 00               LD B,0
5799   41CF 11 64 00            LD DE,100
5800   41D2             G_PUT3_HUND_LOOP:
5801   41D2 B7                  OR A
5802   41D3 ED 52               SBC HL,DE
5803   41D5 38 03               JR C,G_PUT3_HUND_DONE
5804   41D7 04                  INC B
5805   41D8 18 F8               JR G_PUT3_HUND_LOOP
5806   41DA             G_PUT3_HUND_DONE:
5807   41DA 19                  ADD HL,DE
5808   41DB 78                  LD A,B
5809   41DC B7                  OR A
5810   41DD 28 07               JR Z,G_PUT3_TENS
5811   41DF C6 30               ADD A,'0'
5812   41E1 CD 55 41            CALL G_PRN_TX_CHAR
5813   41E4 06 01               LD B,1                         ; hundreds already emitted
5814   41E6             
5815   41E6             G_PUT3_TENS:
5816   41E6 0E 00               LD C,0
5817   41E8 11 0A 00            LD DE,10
5818   41EB             G_PUT3_TENS_LOOP:
5819   41EB B7                  OR A
5820   41EC ED 52               SBC HL,DE
5821   41EE 38 03               JR C,G_PUT3_TENS_DONE
5822   41F0 0C                  INC C
5823   41F1 18 F8               JR G_PUT3_TENS_LOOP
5824   41F3             G_PUT3_TENS_DONE:
5825   41F3 19                  ADD HL,DE
5826   41F4 78                  LD A,B
5827   41F5 B7                  OR A
5828   41F6 20 04               JR NZ,G_PUT3_EMIT_TENS
5829   41F8 79                  LD A,C
5830   41F9 B7                  OR A
5831   41FA 28 06               JR Z,G_PUT3_ONES
5832   41FC             G_PUT3_EMIT_TENS:
5833   41FC 79                  LD A,C
5834   41FD C6 30               ADD A,'0'
5835   41FF CD 55 41            CALL G_PRN_TX_CHAR
5836   4202             G_PUT3_ONES:
5837   4202 7D                  LD A,L
5838   4203 C6 30               ADD A,'0'
5839   4205 CD 55 41            CALL G_PRN_TX_CHAR
5840   4208 D1                  POP DE
5841   4209 C1                  POP BC
5842   420A C9                  RET
5843   420B             
5844   420B             ; HL=angle in tenths.  Print unsigned degrees with one decimal.
5845   420B             G_PRN_ANGLE10:
5846   420B CD 6F 13            CALL ASTRO_DIVU10              ; HL=integer, DE=remainder 0..9
5847   420E D5                  PUSH DE
5848   420F CD CB 41            CALL G_PRN_U16_TRIM3
5849   4212 3E 2E               LD A,'.'
5850   4214 CD 55 41            CALL G_PRN_TX_CHAR
5851   4217 D1                  POP DE
5852   4218 7B                  LD A,E
5853   4219 C6 30               ADD A,'0'
5854   421B C3 55 41            JP G_PRN_TX_CHAR
5855   421E             
5856   421E             ; HL=signed elevation in tenths.  Print explicit +/- sign and one decimal.
5857   421E             G_PRN_SIGNED_ANGLE10:
5858   421E CB 7C               BIT 7,H
5859   4220 28 0B               JR Z,G_PSA_POS
5860   4222 3E 2D               LD A,'-'
5861   4224 CD 55 41            CALL G_PRN_TX_CHAR
5862   4227 CD CF 19            CALL ASTRO_NEG_HL
5863   422A C3 0B 42            JP G_PRN_ANGLE10
5864   422D             G_PSA_POS:
5865   422D 3E 2B               LD A,'+'
5866   422F CD 55 41            CALL G_PRN_TX_CHAR
5867   4232 C3 0B 42            JP G_PRN_ANGLE10
5868   4235             
5869   4235             ; Print compass sector corresponding to unsigned AZ10 in HL.
5870   4235             G_PRN_COMPASS16:
5871   4235 11 70 00            LD DE,112
5872   4238 19                  ADD HL,DE
5873   4239 CD 7C 0F            CALL ASTRO_NORM3600
5874   423C 06 00               LD B,0
5875   423E 11 E1 00            LD DE,225
5876   4241             G_PCOMP_DIV:
5877   4241 B7                  OR A
5878   4242 ED 52               SBC HL,DE
5879   4244 38 03               JR C,G_PCOMP_DONE
5880   4246 04                  INC B
5881   4247 18 F8               JR G_PCOMP_DIV
5882   4249             G_PCOMP_DONE:
5883   4249 78                  LD A,B
5884   424A E6 0F               AND $0F
5885   424C 87                  ADD A,A
5886   424D 5F                  LD E,A
5887   424E 16 00               LD D,0
5888   4250 21 38 61            LD HL,G_COMPASS_PTRS
5889   4253 19                  ADD HL,DE
5890   4254 5E                  LD E,(HL)
5891   4255 23                  INC HL
5892   4256 56                  LD D,(HL)
5893   4257 EB                  EX DE,HL
5894   4258 C3 69 41            JP G_PRN_PRINT_Z
5895   425B             
5896   425B             ; Select one of the eight traditional phase names from corrected Moon-Sun
5897   425B             ; elongation.  Boundaries are 22.5-degree half-sector points.
5898   425B             G_PRN_MOON_PHASE_NAME:
5899   425B 2A DE 89            LD HL,(G_MOON_LON)
5900   425E ED 5B E0 89         LD DE,(G_SUN_LON)
5901   4262 B7                  OR A
5902   4263 ED 52               SBC HL,DE
5903   4265 CD 7C 0F            CALL ASTRO_NORM3600
5904   4268 22 8D 89            LD (G_TMPW0),HL
5905   426B             
5906   426B 11 E1 00            LD DE,225
5907   426E B7                  OR A
5908   426F ED 52               SBC HL,DE
5909   4271 38 4D               JR C,G_PMP_NEW
5910   4273             
5911   4273 2A 8D 89            LD HL,(G_TMPW0)
5912   4276 11 A3 02            LD DE,675
5913   4279 B7                  OR A
5914   427A ED 52               SBC HL,DE
5915   427C 38 48               JR C,G_PMP_WAX_CRES
