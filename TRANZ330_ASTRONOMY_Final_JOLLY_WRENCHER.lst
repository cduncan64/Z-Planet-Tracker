0066   011E             
0067   011E                 ; V11d10 splash screen.  Show the program title immediately after the
0068   011E                 ; display and keypad PIO have been initialized.  Continue when ENTER is
0069   011E                 ; pressed, or automatically after approximately 10 seconds.
0070   011E CD 2A 01        CALL SPLASH_WAIT_ENTER
0071   0121             
0072   0121                 ; Continue with the previously proven V11d8b startup sequence after
0073   0121                 ; ENTER is pressed or the splash timeout expires.
0074   0121 CD AA 02        CALL DEBUG_DART_INIT
0075   0124 CD 2F 56        CALL GPS_STARTUP_WAIT
0076   0127 C3 E3 36        JP G_ASTRO_MAIN
0077   012A             
0078   012A             ; ---------------------------------------------------------------------------
0079   012A             ; SPLASH_WAIT_ENTER
0080   012A             ; Displays "Z PLANET TRACKER" and plays a short two-note TA-DA on the
0081   012A             ; TRANZ 330 piezo speaker using CTC channel 2.
0082   012A             ;
0083   012A             ; Real-hardware calibration of V11d11f showed that the old count of 5000
0084   012A             ; lasted about 25 seconds.  The splash countdown is therefore 2000 ticks,
0085   012A             ; which should be close to 10 seconds on this actual TRANZ 330.  The TA-DA
0086   012A             ; time is INCLUDED in that 2000-tick total; it does not add extra splash time.
0087   012A             ;
0088   012A             ; TA = C5, about 120 ms, followed by about 70 ms silence.
0089   012A             ; DA = G5, about 350 ms.
0090   012A             ; CTC2 constants 214 and 143 assume the TRANZ speaker flip-flop is clocked by
0091   012A             ; CTC2 with the timer prescaler set to 16 and a CPU clock near 3.58 MHz.
0092   012A             ;
0093   012A             ; ENTER is checked during the notes, the silence, and the remainder of the
0094   012A             ; splash.  Pressing ENTER stops the tone immediately, consumes the keypress,
0095   012A             ; and continues to normal GPS acquisition.
0096   012A             ; ---------------------------------------------------------------------------
0097   012A             SPLASH_WAIT_ENTER:
0098   012A 21 6A 5D        LD HL,MSG_PLANET_TRACKER
0099   012D CD 2E 06        CALL DISPLAY_SHOW
0100   0130             
0101   0130 21 D0 07        LD HL,2000                 ; empirically ~10 seconds on the real hardware
0102   0133             
0103   0133                 ; First note: C5 (TA), about 120 ms = 24 calibrated splash ticks.
0104   0133 0E D6           LD C,214
0105   0135 CD 9F 01        CALL SPLASH_TONE_ON
0106   0138 06 18           LD B,24
0107   013A CD 84 01        CALL SPLASH_WAIT_TICKS
0108   013D FE 01           CP 1
0109   013F 28 3C           JR Z,SPLASH_ENTER
0110   0141 FE 02           CP 2
0111   0143 28 34           JR Z,SPLASH_TIMEOUT
0112   0145 CD AB 01        CALL SPLASH_TONE_OFF
0113   0148             
0114   0148                 ; Short silence between TA and DA, about 70 ms = 14 ticks.
0115   0148 06 0E           LD B,14
0116   014A CD 84 01        CALL SPLASH_WAIT_TICKS
0117   014D FE 01           CP 1
0118   014F 28 2C           JR Z,SPLASH_ENTER
0119   0151 FE 02           CP 2
0120   0153 28 24           JR Z,SPLASH_TIMEOUT
0121   0155             
0122   0155                 ; Second note: G5 (DAAA), about 350 ms = 70 ticks.
0123   0155 0E 8F           LD C,143
0124   0157 CD 9F 01        CALL SPLASH_TONE_ON
0125   015A 06 46           LD B,70
0126   015C CD 84 01        CALL SPLASH_WAIT_TICKS
0127   015F FE 01           CP 1
0128   0161 28 1A           JR Z,SPLASH_ENTER
0129   0163 FE 02           CP 2
0130   0165 28 12           JR Z,SPLASH_TIMEOUT
0131   0167 CD AB 01        CALL SPLASH_TONE_OFF
0132   016A             
0133   016A                 ; The tune has already consumed part of HL, so this loop waits only for
0134   016A                 ; the remainder of the same ~10-second total splash interval.
0135   016A             SPLASH_KEY_LOOP:
0136   016A CD E8 01        CALL KEY_SCAN              ; A=0 if no key, otherwise keypad code
0137   016D FE 10           CP KEY_ENTER
0138   016F 28 0C           JR Z,SPLASH_ENTER
0139   0171             
0140   0171 CD B2 06        CALL DELAY_2MS             ; empirically about 5 ms on this TRANZ 330
0141   0174             
0142   0174 2B              DEC HL                     ; one timeout tick completed
0143   0175 7C              LD A,H
0144   0176 B5              OR L
0145   0177 20 F1           JR NZ,SPLASH_KEY_LOOP
0146   0179             
0147   0179             SPLASH_TIMEOUT:
0148   0179 CD AB 01        CALL SPLASH_TONE_OFF       ; safety: guarantee silence before GPS startup
0149   017C C9              RET
0150   017D             
0151   017D             SPLASH_ENTER:
0152   017D CD AB 01        CALL SPLASH_TONE_OFF       ; ENTER also aborts a note already in progress
0153   0180 CD 4A 02        CALL KEY_WAIT_RELEASE      ; consume the ENTER press cleanly
0154   0183 C9              RET
0155   0184             
0156   0184             ; Wait B splash ticks while preserving the master timeout in HL.
0157   0184             ; Return A=0 when this phase completes normally, A=1 if ENTER is pressed,
0158   0184             ; or A=2 if the master HL timeout reaches zero.
0159   0184             SPLASH_WAIT_TICKS:
0160   0184             SWT_LOOP:
0161   0184 C5              PUSH BC                    ; KEY_SCAN uses B/C/D/E internally
0162   0185 CD E8 01        CALL KEY_SCAN
0163   0188 C1              POP BC
0164   0189 FE 10           CP KEY_ENTER
0165   018B 28 0C           JR Z,SWT_ENTER
0166   018D             
0167   018D CD B2 06        CALL DELAY_2MS
0168   0190 2B              DEC HL
0169   0191 7C              LD A,H
0170   0192 B5              OR L
0171   0193 28 07           JR Z,SWT_TIMEOUT
0172   0195             
0173   0195 10 ED           DJNZ SWT_LOOP
0174   0197 AF              XOR A                      ; A=0: requested phase completed
0175   0198 C9              RET
0176   0199             
0177   0199             SWT_ENTER:
0178   0199 3E 01           LD A,1
0179   019B C9              RET
0180   019C             
0181   019C             SWT_TIMEOUT:
0182   019C 3E 02           LD A,2
0183   019E C9              RET
0184   019F             
0185   019F             ; CTC2 drives the TRANZ speaker flip-flop.  C = 8-bit timer time constant.
0186   019F             SPLASH_TONE_ON:
0187   019F                 ; Reinitialize CTC2 from a known reset state every time a tone starts.
0188   019F                 ; This matters after DEBUG_DART_INIT has touched the CTC channels.
0189   019F 3E 03           LD A,$03                   ; reset/stop channel 2 first
0190   01A1 D3 12           OUT (CTC2),A
0191   01A3 3E 07           LD A,$07                   ; timer, /16 prescale, auto trigger, const follows
0192   01A5 D3 12           OUT (CTC2),A
0193   01A7 79              LD A,C
0194   01A8 D3 12           OUT (CTC2),A
0195   01AA C9              RET
0196   01AB             
0197   01AB             SPLASH_TONE_OFF:
0198   01AB 3E 03           LD A,$03                   ; stop/disable CTC2 speaker timer
0199   01AD D3 12           OUT (CTC2),A
0200   01AF C9              RET
0201   01B0             
0202   01B0             ; ---------------------------------------------------------------------------
0203   01B0             ; CALC_DONE_TUNE
0204   01B0             ; Short calculation-complete chime: C5 - E5 - G5.
0205   01B0             ;
0206   01B0             ; This deliberately uses the same proven CTC2 speaker method as the startup
0207   01B0             ; TA-DA.  The real TRANZ measured DELAY_2MS at roughly 5 ms, so the timing is
0208   01B0             ; approximately:
0209   01B0             ;       C5   90 ms
0210   01B0             ;       gap  40 ms
0211   01B0             ;       E5   90 ms
0212   01B0             ;       gap  40 ms
0213   01B0             ;       G5  250 ms
0214   01B0             ; Total: about 0.51 second.
0215   01B0             ;
0216   01B0             ; Unlike the splash tune, this chime is intentionally allowed to finish: it is
0217   01B0             ; the audible indication that the requested calculation has completed.
0218   01B0             ; ---------------------------------------------------------------------------
0219   01B0             CALC_DONE_TUNE:
0220   01B0 0E D6           LD C,214                    ; C5, same constant proven by startup TA
0221   01B2 CD 9F 01        CALL SPLASH_TONE_ON
0222   01B5 06 12           LD B,18
0223   01B7 CD E2 01        CALL CALC_DONE_DELAY
0224   01BA CD AB 01        CALL SPLASH_TONE_OFF
0225   01BD             
0226   01BD 06 08           LD B,8                      ; short separation between notes
0227   01BF CD E2 01        CALL CALC_DONE_DELAY
0228   01C2             
0229   01C2 0E AA           LD C,170                    ; E5
0230   01C4 CD 9F 01        CALL SPLASH_TONE_ON
0231   01C7 06 12           LD B,18
0232   01C9 CD E2 01        CALL CALC_DONE_DELAY
0233   01CC CD AB 01        CALL SPLASH_TONE_OFF
0234   01CF             
0235   01CF 06 08           LD B,8
0236   01D1 CD E2 01        CALL CALC_DONE_DELAY
0237   01D4             
0238   01D4 0E 8F           LD C,143                    ; G5, same constant proven by startup DAAA
0239   01D6 CD 9F 01        CALL SPLASH_TONE_ON
0240   01D9 06 32           LD B,50
0241   01DB CD E2 01        CALL CALC_DONE_DELAY
0242   01DE CD AB 01        CALL SPLASH_TONE_OFF
0243   01E1 C9              RET
0244   01E2             
0245   01E2             CALC_DONE_DELAY:
0246   01E2 CD B2 06        CALL DELAY_2MS              ; empirically about 5 ms on this TRANZ 330
0247   01E5 10 FB           DJNZ CALC_DONE_DELAY
0248   01E7 C9              RET
0249   01E8             
