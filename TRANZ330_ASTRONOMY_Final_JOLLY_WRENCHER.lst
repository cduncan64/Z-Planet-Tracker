8918   58F1 D8                  RET C
8919   58F2 B7                  OR A
8920   58F3 28 31               JR Z,GPS_DATE_BAD
8921   58F5 FE 20               CP 32
8922   58F7 30 2D               JR NC,GPS_DATE_BAD
8923   58F9 32 2E 8A            LD (GPS_TMP_UTC_DAY),A
8924   58FC CD 8C 58            CALL GPS_PARSE_2DIG
8925   58FF D8                  RET C
8926   5900 B7                  OR A
8927   5901 28 23               JR Z,GPS_DATE_BAD
8928   5903 FE 0D               CP 13
8929   5905 30 1F               JR NC,GPS_DATE_BAD
8930   5907 32 2D 8A            LD (GPS_TMP_UTC_MONTH),A
