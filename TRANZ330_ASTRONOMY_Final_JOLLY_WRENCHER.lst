6709   4812 22 8D 89            LD (G_TMPW0),HL            ; M
6710   4815 22 EC 89            LD (G_SUN_M_CUR),HL
6711   4818                     ; E = M + 10*sin(M)
6712   4818 E5                  PUSH HL
6713   4819 CD 14 16            CALL ASTRO_SIN10
6714   481C 3E 0A               LD A,10
6715   481E CD 2E 16            CALL ASTRO_SCALE_Q15_U8
6716   4821 EB                  EX DE,HL
6717   4822 E1                  POP HL
6718   4823 19                  ADD HL,DE
6719   4824 CD 7C 0F            CALL ASTRO_NORM3600
6720   4827 22 8F 89            LD (G_TMPW1),HL            ; E
6721   482A 22 F4 89            LD (G_DBG_SUN_E),HL
6722   482D                     ; xv
6723   482D CD 24 16            CALL ASTRO_COS10
6724   4830 EB                  EX DE,HL
6725   4831 21 00 02            LD HL,G_SUN_AQ
6726   4834 CD 34 16            CALL ASTRO_MUL_Q15
6727   4837 11 09 00            LD DE,G_SUN_AEQ
6728   483A B7                  OR A
6729   483B ED 52               SBC HL,DE
6730   483D 22 CA 89            LD (G_XV),HL
6731   4840                     ; yv
6732   4840 2A 8F 89            LD HL,(G_TMPW1)
6733   4843 CD 14 16            CALL ASTRO_SIN10
6734   4846 EB                  EX DE,HL
6735   4847 21 00 02            LD HL,G_SUN_BQ
6736   484A CD 34 16            CALL ASTRO_MUL_Q15
6737   484D 22 CC 89            LD (G_YV),HL
6738   4850                     ; rotate by w
6739   4850 2A 0C 89            LD HL,(AST_SW)
6740   4853 CD 24 16            CALL ASTRO_COS10
6741   4856 22 91 89            LD (G_TMPW2),HL
6742   4859 2A 0C 89            LD HL,(AST_SW)
6743   485C CD 14 16            CALL ASTRO_SIN10
