6873   4996 22 8F 89            LD (G_TMPW1),HL            ; sini
6874   4999             
6875   4999                     ; xh = x1 cosN - y1 cosi sinN
6876   4999 2A CE 89            LD HL,(G_X1)
6877   499C ED 5B 91 89         LD DE,(G_TMPW2)
6878   49A0 CD 34 16            CALL ASTRO_MUL_Q15
6879   49A3 22 D2 89            LD (G_XH),HL
6880   49A6 2A D0 89            LD HL,(G_Y1)
6881   49A9 ED 5B 8D 89         LD DE,(G_TMPW0)
6882   49AD CD 34 16            CALL ASTRO_MUL_Q15
6883   49B0 ED 5B 93 89         LD DE,(G_TMPW3)
6884   49B4 CD 34 16            CALL ASTRO_MUL_Q15
6885   49B7 EB                  EX DE,HL
6886   49B8 2A D2 89            LD HL,(G_XH)
6887   49BB B7                  OR A
6888   49BC ED 52               SBC HL,DE
6889   49BE 22 D2 89            LD (G_XH),HL
6890   49C1                     ; yh
6891   49C1 2A CE 89            LD HL,(G_X1)
6892   49C4 ED 5B 93 89         LD DE,(G_TMPW3)
6893   49C8 CD 34 16            CALL ASTRO_MUL_Q15
6894   49CB 22 D4 89            LD (G_YH),HL
6895   49CE 2A D0 89            LD HL,(G_Y1)
6896   49D1 ED 5B 8D 89         LD DE,(G_TMPW0)
6897   49D5 CD 34 16            CALL ASTRO_MUL_Q15
6898   49D8 ED 5B 91 89         LD DE,(G_TMPW2)
6899   49DC CD 34 16            CALL ASTRO_MUL_Q15
6900   49DF EB                  EX DE,HL
6901   49E0 2A D4 89            LD HL,(G_YH)
6902   49E3 19                  ADD HL,DE
6903   49E4 22 D4 89            LD (G_YH),HL
6904   49E7                     ; zh
6905   49E7 2A D0 89            LD HL,(G_Y1)
6906   49EA ED 5B 8F 89         LD DE,(G_TMPW1)
6907   49EE CD 34 16            CALL ASTRO_MUL_Q15
6908   49F1 22 D6 89            LD (G_ZH),HL
6909   49F4 C9                  RET
6910   49F5             
6911   49F5             ; ---------------------------------------------------------------------------
6912   49F5             ; SELECTED OBJECT VECTOR, input HL=UTC minutes from local day's UTC midnight.
6913   49F5             ; Output AST_X/Y/Z = geocentric equatorial vector.
6914   49F5             ; ---------------------------------------------------------------------------
6915   49F5             G_VECTOR_SELECTED:
6916   49F5 22 8B 89            LD (G_UTC_MIN),HL
6917   49F8 CD 01 48            CALL G_SUN_VECTOR
6918   49FB 3A 80 89            LD A,(G_OBJECT)
6919   49FE FE 02               CP G_OBJ_SUN
6920   4A00 28 4C               JR Z,G_VEC_SUN
6921   4A02 FE 09               CP G_OBJ_MOON
6922   4A04 CA 2F 4F            JP Z,G_VECTOR_MOON
6923   4A07 FE 08               CP G_OBJ_PLUTO
6924   4A09 CA 75 53            JP Z,G_VECTOR_PLUTO
6925   4A0C 2A 8B 89            LD HL,(G_UTC_MIN)
6926   4A0F CD B0 48            CALL G_PLANET_HELIO
6927   4A12 2A D2 89            LD HL,(G_XH)
6928   4A15 22 FA 89            LD (G_DBG_HEL_X),HL
6929   4A18 2A D4 89            LD HL,(G_YH)
6930   4A1B 22 FC 89            LD (G_DBG_HEL_Y),HL
6931   4A1E 2A D6 89            LD HL,(G_ZH)
6932   4A21 22 FE 89            LD (G_DBG_HEL_Z),HL
6933   4A24 2A D2 89            LD HL,(G_XH)
6934   4A27 ED 5B C6 89         LD DE,(G_SX)
6935   4A2B 19                  ADD HL,DE
6936   4A2C 22 D2 89            LD (G_XH),HL
6937   4A2F 2A D4 89            LD HL,(G_YH)
6938   4A32 ED 5B C8 89         LD DE,(G_SY)
6939   4A36 19                  ADD HL,DE
6940   4A37 22 D4 89            LD (G_YH),HL
6941   4A3A 2A D2 89            LD HL,(G_XH)
6942   4A3D 22 00 8A            LD (G_DBG_GEO_X),HL
6943   4A40 2A D4 89            LD HL,(G_YH)
6944   4A43 22 02 8A            LD (G_DBG_GEO_Y),HL
6945   4A46 2A D6 89            LD HL,(G_ZH)
6946   4A49 22 04 8A            LD (G_DBG_GEO_Z),HL
6947   4A4C 18 12               JR G_ECL_TO_EQ
6948   4A4E             G_VEC_SUN:
6949   4A4E 2A C6 89            LD HL,(G_SX)
6950   4A51 22 D2 89            LD (G_XH),HL
6951   4A54 2A C8 89            LD HL,(G_SY)
6952   4A57 22 D4 89            LD (G_YH),HL
6953   4A5A 21 00 00            LD HL,0
6954   4A5D 22 D6 89            LD (G_ZH),HL
6955   4A60             
6956   4A60             G_ECL_TO_EQ:
6957   4A60 2A D2 89            LD HL,(G_XH)
6958   4A63 22 20 89            LD (AST_X),HL
6959   4A66 2A D4 89            LD HL,(G_YH)
6960   4A69 11 6F 75            LD DE,OBL_COS_Q15
6961   4A6C CD 34 16            CALL ASTRO_MUL_Q15
6962   4A6F 22 8D 89            LD (G_TMPW0),HL
6963   4A72 2A D6 89            LD HL,(G_ZH)
6964   4A75 11 EA 32            LD DE,OBL_SIN_Q15
6965   4A78 CD 34 16            CALL ASTRO_MUL_Q15
6966   4A7B EB                  EX DE,HL
6967   4A7C 2A 8D 89            LD HL,(G_TMPW0)
6968   4A7F B7                  OR A
6969   4A80 ED 52               SBC HL,DE
6970   4A82 22 22 89            LD (AST_Y),HL
6971   4A85 2A D4 89            LD HL,(G_YH)
6972   4A88 11 EA 32            LD DE,OBL_SIN_Q15
6973   4A8B CD 34 16            CALL ASTRO_MUL_Q15
6974   4A8E 22 8D 89            LD (G_TMPW0),HL
6975   4A91 2A D6 89            LD HL,(G_ZH)
6976   4A94 11 6F 75            LD DE,OBL_COS_Q15
6977   4A97 CD 34 16            CALL ASTRO_MUL_Q15
6978   4A9A EB                  EX DE,HL
6979   4A9B 2A 8D 89            LD HL,(G_TMPW0)
6980   4A9E 19                  ADD HL,DE
6981   4A9F 22 24 89            LD (AST_Z),HL
6982   4AA2 C9                  RET
6983   4AA3             
6984   4AA3             ; ---------------------------------------------------------------------------
6985   4AA3             ; FIXED-VECTOR RISE/SET for Sun/planets/Pluto. Transit intentionally omitted.
6986   4AA3             ; ---------------------------------------------------------------------------
6987   4AA3             G_EVENTS_FIXED:
6988   4AA3 21 FF FF            LD HL,$FFFF
6989   4AA6 22 26 89            LD (AST_RISE),HL
6990   4AA9 22 28 89            LD (AST_SET),HL
6991   4AAC             
6992   4AAC                     ; Fixed vector at local noon, exactly as in V11d11k.
6993   4AAC 21 D0 02            LD HL,720
6994   4AAF CD 97 4D            CALL G_LOCAL_TO_UTC_MIN
6995   4AB2 CD F5 49            CALL G_VECTOR_SELECTED
6996   4AB5 CD F1 17            CALL ASTRO_VECTOR_DISTANCE
6997   4AB8 22 33 89            LD (AST_DIST_Q),HL
6998   4ABB             
6999   4ABB                     ; Preserve the established apparent-horizon threshold for visibility.
7000   4ABB 3A 80 89            LD A,(G_OBJECT)
7001   4ABE FE 02               CP G_OBJ_SUN
7002   4AC0 11 BC FE            LD DE,G_H0_PLANET
7003   4AC3 20 03               JR NZ,G_EF_H0
7004   4AC5 11 24 FE            LD DE,G_H0_SUN
7005   4AC8             G_EF_H0:
7006   4AC8 CD 34 16            CALL ASTRO_MUL_Q15
7007   4ACB 22 31 89            LD (AST_HORIZON_Q),HL
7008   4ACE CD 9F 4D            CALL G_SET_LST0
7009   4AD1             
7010   4AD1                     ; V11d11o: find SET first with the proven V11d11n coarse-to-fine
7011   4AD1                     ; search.  Then use that known SET as the anchor for RISE instead of
7012   4AD1                     ; starting a second independent search from NOW.
7013   4AD1                     ;
7014   4AD1                     ; RISE seed sequence requested after hardware timing tests:
7015   4AD1                     ;       SET + 10 hours
7016   4AD1                     ;       SET + 11 hours
7017   4AD1                     ;       SET + 12 hours ...
7018   4AD1                     ; in one-hour steps until elevation changes from negative to
7019   4AD1                     ; nonnegative.  That brackets RISE inside one hour.  The existing
7020   4AD1                     ; 30/15/5/1-minute polarity refinement then finds the minute.
7021   4AD1                     ;
7022   4AD1                     ; If SET+10 is already nonnegative (unusual geometry) or SET was not
7023   4AD1                     ; found, fall back to the independent V11d11n RISE search so this
7024   4AD1                     ; optimization cannot silently lose an event.
7025   4AD1 CD E9 4A            CALL G_EF_NOW_MIN
7026   4AD4 22 CB 8A            LD (G_EDU_MIN),HL
7027   4AD7 3E 01               LD A,1
7028   4AD9 32 D0 8A            LD (G_EDU_MODE),A
7029   4ADC CD 52 4B            CALL G_EF_EDU_SEARCH
7030   4ADF 22 28 89            LD (AST_SET),HL
7031   4AE2             
7032   4AE2 CD 05 4B            CALL G_EF_RISE_FROM_SET
7033   4AE5 22 26 89            LD (AST_RISE),HL
7034   4AE8             
7035   4AE8                     ; V11d11q: TRANSIT removed.  Rise and set are the only timed events.
7036   4AE8 C9                  RET
7037   4AE9             
7038   4AE9             ; Return NOW as local minute-of-day in HL.
7039   4AE9             G_EF_NOW_MIN:
7040   4AE9 3A 04 89            LD A,(AST_HOUR)
7041   4AEC 26 00               LD H,0
7042   4AEE 6F                  LD L,A
7043   4AEF E5                  PUSH HL
7044   4AF0 29                  ADD HL,HL
7045   4AF1 29                  ADD HL,HL
7046   4AF2 EB                  EX DE,HL
7047   4AF3 E1                  POP HL
7048   4AF4 29                  ADD HL,HL
7049   4AF5 29                  ADD HL,HL
7050   4AF6 29                  ADD HL,HL
7051   4AF7 29                  ADD HL,HL
7052   4AF8 29                  ADD HL,HL
7053   4AF9 29                  ADD HL,HL
7054   4AFA B7                  OR A
7055   4AFB ED 52               SBC HL,DE                  ; hour*60
7056   4AFD 3A 05 89            LD A,(AST_MINUTE)
7057   4B00 5F                  LD E,A
7058   4B01 16 00               LD D,0
7059   4B03 19                  ADD HL,DE
7060   4B04 C9                  RET
7061   4B05             
7062   4B05             ; Find RISE from the SET time already calculated above.
7063   4B05             ; First sample is SET+10 hours.  If still below the horizon, advance in
7064   4B05             ; one-hour steps: +11h, +12h, ... until the sign changes.  On the crossing,
7065   4B05             ; reuse the V11d11n 30/15/5/1-minute refinement path.
7066   4B05             ; Return HL = local minute of RISE.
7067   4B05             G_EF_RISE_FROM_SET:
7068   4B05 2A 28 89            LD HL,(AST_SET)
7069   4B08 7C                  LD A,H
7070   4B09 FE FF               CP $FF
7071   4B0B 28 37               JR Z,G_EF_RFS_FALLBACK
7072   4B0D             
7073   4B0D                     ; SET + 10 hours, wrapped into the local 0..1439 minute day.
7074   4B0D 11 58 02            LD DE,600
7075   4B10 19                  ADD HL,DE
7076   4B11 11 A0 05            LD DE,1440
7077   4B14 B7                  OR A
7078   4B15 ED 52               SBC HL,DE
7079   4B17 30 01               JR NC,G_EF_RFS_SEED_OK
7080   4B19 19                  ADD HL,DE
7081   4B1A             G_EF_RFS_SEED_OK:
7082   4B1A 22 CB 8A            LD (G_EDU_MIN),HL
7083   4B1D                     ; Only above/below is needed at this seed.  Use the fast UP-only
7084   4B1D                     ; path rather than computing east/north, sqrt and atan elevation.
7085   4B1D CD CE 4C            CALL G_EF_SIGN_AT_MIN
7086   4B20 B7                  OR A
7087   4B21 20 21               JR NZ,G_EF_RFS_FALLBACK     ; rise happened before SET+10: use safe path
7088   4B23             
7089   4B23                     ; We are below the horizon at SET+10.  Lock forward direction and
7090   4B23                     ; walk one hour at a time until negative -> nonnegative crossing.
7091   4B23 AF                  XOR A
7092   4B24 32 D6 8A            LD (G_EDU_PREV_SIGN),A
7093   4B27 32 D3 8A            LD (G_EDU_DIR),A             ; forward/add
7094   4B2A 21 3C 00            LD HL,60
7095   4B2D 22 D1 8A            LD (G_EDU_STEP),HL
7096   4B30 3E 0E               LD A,14                      ; +11 through +24 hours maximum guard
7097   4B32 32 CF 8A            LD (G_EDU_COUNT),A
7098   4B35             G_EF_RFS_HOUR_LOOP:
7099   4B35 CD 3E 4C            CALL G_EF_TRY_STEP_FAST
7100   4B38 DA CA 4B            JP C,G_EF_BIG_CROSSED        ; bracketed: refine 30/15/5/1 minutes
7101   4B3B 3A CF 8A            LD A,(G_EDU_COUNT)
7102   4B3E 3D                  DEC A
7103   4B3F 32 CF 8A            LD (G_EDU_COUNT),A
7104   4B42 20 F1               JR NZ,G_EF_RFS_HOUR_LOOP
7105   4B44             
7106   4B44                     ; Defensive fallback if no rise was bracketed within a full day.
7107   4B44             G_EF_RFS_FALLBACK:
7108   4B44 CD E9 4A            CALL G_EF_NOW_MIN
7109   4B47 22 CB 8A            LD (G_EDU_MIN),HL
7110   4B4A AF                  XOR A
7111   4B4B 32 D0 8A            LD (G_EDU_MODE),A            ; RISE
7112   4B4E CD 52 4B            CALL G_EF_EDU_SEARCH
7113   4B51 C9                  RET
7114   4B52             
7115   4B52             ; Coarse-to-fine horizon search. G_EDU_MODE: 0 rise, 1 set.
7116   4B52             ; Direction is chosen ONCE from the initial elevation and never changes:
7117   4B52             ;   RISE: EL<0 forward (WILL RISE), EL>=0 backward (HAS RISEN)
7118   4B52             ;   SET : EL>=0 forward (WILL SET), EL<0 backward (HAS SET)
7119   4B52             ;
7120   4B52             ; Search sequence requested for V11d11n:
7121   4B52             ;   >=15 deg : educated |EL|/15-hour jump(s)
7122   4B52             ;   inside +/-15 deg: one 30-minute check
7123   4B52             ;   if no crossing: one 15-minute check
7124   4B52             ;   if no crossing: one 5-minute check
7125   4B52             ;   then 1-minute checks until polarity changes.
7126   4B52             ; A polarity change is tested after EVERY trial. If a coarse trial crosses,
7127   4B52             ; restore the pre-crossing minute and continue with the next finer step.
7128   4B52             G_EF_EDU_SEARCH:
7129   4B52 3E 60               LD A,96                    ; hard safety guard, mainly for 1-min tail
7130   4B54 32 CF 8A            LD (G_EDU_COUNT),A
7131   4B57             
7132   4B57                     ; Evaluate starting point and save its polarity.
7133   4B57 2A CB 8A            LD HL,(G_EDU_MIN)
7134   4B5A CD 26 4D            CALL G_EF_ELEV_AT_MIN
7135   4B5D 22 CD 8A            LD (G_EDU_EL10),HL
7136   4B60 CD 35 4C            CALL G_EF_SIGN_HL
7137   4B63 32 D6 8A            LD (G_EDU_PREV_SIGN),A
7138   4B66             
7139   4B66                     ; Lock search direction from MODE + initial sign.
7140   4B66                     ; DIR 0=forward/add, 1=backward/subtract.
7141   4B66 47                  LD B,A                     ; B = initial sign: 0 neg, 1 nonneg
7142   4B67 3A D0 8A            LD A,(G_EDU_MODE)
7143   4B6A B7                  OR A
7144   4B6B 20 06               JR NZ,G_EF_DIR_SET
7145   4B6D                     ; rise: negative -> forward, nonnegative -> backward
7146   4B6D 78                  LD A,B
7147   4B6E B7                  OR A
7148   4B6F 28 0D               JR Z,G_EF_DIR_FWD
7149   4B71 18 04               JR G_EF_DIR_BACK
7150   4B73             G_EF_DIR_SET:
7151   4B73                     ; set: nonnegative -> forward, negative -> backward
7152   4B73 78                  LD A,B
7153   4B74 B7                  OR A
7154   4B75 20 07               JR NZ,G_EF_DIR_FWD
7155   4B77             G_EF_DIR_BACK:
7156   4B77 3E 01               LD A,1
7157   4B79 32 D3 8A            LD (G_EDU_DIR),A
7158   4B7C 18 04               JR G_EF_BIG_TEST
7159   4B7E             G_EF_DIR_FWD:
7160   4B7E AF                  XOR A
7161   4B7F 32 D3 8A            LD (G_EDU_DIR),A
7162   4B82             
7163   4B82             G_EF_BIG_TEST:
7164   4B82                     ; If abs(EL) < 15 degrees, begin the fixed 30/15/5/1 sequence.
7165   4B82 2A CD 8A            LD HL,(G_EDU_EL10)
7166   4B85 CB 7C               BIT 7,H
7167   4B87 28 03               JR Z,G_EF_BIG_ABS_OK
7168   4B89 CD CF 19            CALL ASTRO_NEG_HL
7169   4B8C             G_EF_BIG_ABS_OK:
7170   4B8C 11 96 00            LD DE,150
7171   4B8F B7                  OR A
7172   4B90 ED 52               SBC HL,DE
7173   4B92 DA EA 4B            JP C,G_EF_PHASE30
7174   4B95             
7175   4B95                     ; Educated jump = round(abs(EL)/15) whole hours, minimum one hour.
7176   4B95 2A CD 8A            LD HL,(G_EDU_EL10)
7177   4B98 CB 7C               BIT 7,H
7178   4B9A 28 03               JR Z,G_EF_BIG_ABS2
7179   4B9C CD CF 19            CALL ASTRO_NEG_HL
7180   4B9F             G_EF_BIG_ABS2:
7181   4B9F 11 4B 00            LD DE,75
7182   4BA2 19                  ADD HL,DE
7183   4BA3 06 00               LD B,0
7184   4BA5             G_EF_BIG_DIV150:
7185   4BA5 11 96 00            LD DE,150
7186   4BA8 B7                  OR A
7187   4BA9 ED 52               SBC HL,DE
7188   4BAB 38 03               JR C,G_EF_BIG_DIV_DONE
7189   4BAD 04                  INC B
7190   4BAE 18 F5               JR G_EF_BIG_DIV150
7191   4BB0             G_EF_BIG_DIV_DONE:
7192   4BB0 78                  LD A,B
7193   4BB1 B7                  OR A
7194   4BB2 20 01               JR NZ,G_EF_BIG_HOURS_OK
7195   4BB4 04                  INC B
7196   4BB5             G_EF_BIG_HOURS_OK:
7197   4BB5 21 00 00            LD HL,0
7198   4BB8 11 3C 00            LD DE,60
7199   4BBB             G_EF_BIG_MUL60:
7200   4BBB 19                  ADD HL,DE
7201   4BBC 10 FD               DJNZ G_EF_BIG_MUL60
7202   4BBE 22 D1 8A            LD (G_EDU_STEP),HL
7203   4BC1                     ; The educated-jump loop still needs the actual elevation magnitude
7204   4BC1                     ; to choose its next |EL|/15-hour jump, so keep the full calculation.
7205   4BC1 CD 83 4C            CALL G_EF_TRY_STEP_FULL
7206   4BC4 DA CA 4B            JP C,G_EF_BIG_CROSSED
7207   4BC7 C3 82 4B            JP G_EF_BIG_TEST
7208   4BCA             
7209   4BCA             G_EF_BIG_CROSSED:
7210   4BCA                     ; The large jump bracketed the horizon. Go back to the old side and
7211   4BCA                     ; approach it in 30-minute increments before the finer checks.
7212   4BCA 2A D4 8A            LD HL,(G_EDU_PREV_MIN)
7213   4BCD 22 CB 8A            LD (G_EDU_MIN),HL
7214   4BD0 3A D6 8A            LD A,(G_EDU_PREV_SIGN)
7215   4BD3 32 D6 8A            LD (G_EDU_PREV_SIGN),A
7216   4BD6             G_EF_BIG_30_LOOP:
7217   4BD6 21 1E 00            LD HL,30
7218   4BD9 22 D1 8A            LD (G_EDU_STEP),HL
7219   4BDC CD 3E 4C            CALL G_EF_TRY_STEP_FAST
7220   4BDF 30 F5               JR NC,G_EF_BIG_30_LOOP
7221   4BE1 2A D4 8A            LD HL,(G_EDU_PREV_MIN)
7222   4BE4 22 CB 8A            LD (G_EDU_MIN),HL
7223   4BE7 C3 FB 4B            JP G_EF_PHASE15
7224   4BEA             
7225   4BEA             G_EF_PHASE30:
7226   4BEA 21 1E 00            LD HL,30
7227   4BED 22 D1 8A            LD (G_EDU_STEP),HL
7228   4BF0 CD 3E 4C            CALL G_EF_TRY_STEP_FAST
7229   4BF3 30 06               JR NC,G_EF_PHASE15
7230   4BF5 2A D4 8A            LD HL,(G_EDU_PREV_MIN)
7231   4BF8 22 CB 8A            LD (G_EDU_MIN),HL
7232   4BFB             
7233   4BFB             G_EF_PHASE15:
7234   4BFB 21 0F 00            LD HL,15
7235   4BFE 22 D1 8A            LD (G_EDU_STEP),HL
7236   4C01 CD 3E 4C            CALL G_EF_TRY_STEP_FAST
7237   4C04 30 06               JR NC,G_EF_PHASE5
7238   4C06 2A D4 8A            LD HL,(G_EDU_PREV_MIN)
7239   4C09 22 CB 8A            LD (G_EDU_MIN),HL
7240   4C0C             
7241   4C0C             G_EF_PHASE5:
7242   4C0C 21 05 00            LD HL,5
7243   4C0F 22 D1 8A            LD (G_EDU_STEP),HL
7244   4C12 CD 3E 4C            CALL G_EF_TRY_STEP_FAST
7245   4C15 30 06               JR NC,G_EF_PHASE1
7246   4C17 2A D4 8A            LD HL,(G_EDU_PREV_MIN)
7247   4C1A 22 CB 8A            LD (G_EDU_MIN),HL
7248   4C1D             
7249   4C1D             G_EF_PHASE1:
7250   4C1D 21 01 00            LD HL,1
7251   4C20 22 D1 8A            LD (G_EDU_STEP),HL
7252   4C23             G_EF_ONE_LOOP:
7253   4C23 CD 3E 4C            CALL G_EF_TRY_STEP_FAST
7254   4C26 38 09               JR C,G_EF_ES_DONE
7255   4C28 3A CF 8A            LD A,(G_EDU_COUNT)
7256   4C2B 3D                  DEC A
7257   4C2C 32 CF 8A            LD (G_EDU_COUNT),A
7258   4C2F 20 F2               JR NZ,G_EF_ONE_LOOP
7259   4C31                     ; Defensive safety exit if no crossing appeared in the 1-minute tail.
7260   4C31             G_EF_ES_DONE:
7261   4C31 2A CB 8A            LD HL,(G_EDU_MIN)
7262   4C34 C9                  RET
7263   4C35             
7264   4C35             ; Return A=0 for negative HL, A=1 for zero/positive HL.
7265   4C35             G_EF_SIGN_HL:
7266   4C35 CB 7C               BIT 7,H
7267   4C37 28 02               JR Z,G_EF_SIGN_POS
7268   4C39 AF                  XOR A
7269   4C3A C9                  RET
7270   4C3B             G_EF_SIGN_POS:
7271   4C3B 3E 01               LD A,1
7272   4C3D C9                  RET
7273   4C3E             
7274   4C3E             ; Fast trial used once a crossing search only needs polarity.  This is
7275   4C3E             ; mathematically equivalent to testing the sign of elevation because
7276   4C3E             ; atan2(UP,horizontal) has the same sign as UP.  It deliberately avoids
7277   4C3E             ; EAST, NORTH, squares, integer square root, and atan2.
7278   4C3E             G_EF_TRY_STEP_FAST:
7279   4C3E 2A CB 8A            LD HL,(G_EDU_MIN)
7280   4C41 22 D4 8A            LD (G_EDU_PREV_MIN),HL
7281   4C44 3A D6 8A            LD A,(G_EDU_PREV_SIGN)
7282   4C47 F5                  PUSH AF
7283   4C48             
7284   4C48 3A D3 8A            LD A,(G_EDU_DIR)
7285   4C4B B7                  OR A
7286   4C4C 20 12               JR NZ,G_EF_FAST_SUB
7287   4C4E             G_EF_FAST_ADD:
7288   4C4E ED 5B D1 8A         LD DE,(G_EDU_STEP)
7289   4C52 19                  ADD HL,DE
7290   4C53 11 A0 05            LD DE,1440
7291   4C56 B7                  OR A
7292   4C57 ED 52               SBC HL,DE
7293   4C59 38 02               JR C,G_EF_FAST_ADD_RESTORE
7294   4C5B 18 10               JR G_EF_FAST_STORE
7295   4C5D             G_EF_FAST_ADD_RESTORE:
7296   4C5D 19                  ADD HL,DE
7297   4C5E 18 0D               JR G_EF_FAST_STORE
7298   4C60             G_EF_FAST_SUB:
7299   4C60 ED 5B D1 8A         LD DE,(G_EDU_STEP)
7300   4C64 B7                  OR A
7301   4C65 ED 52               SBC HL,DE
7302   4C67 30 04               JR NC,G_EF_FAST_STORE
7303   4C69 11 A0 05            LD DE,1440
7304   4C6C 19                  ADD HL,DE
7305   4C6D             G_EF_FAST_STORE:
7306   4C6D 22 CB 8A            LD (G_EDU_MIN),HL
7307   4C70 CD CE 4C            CALL G_EF_SIGN_AT_MIN
7308   4C73 47                  LD B,A
7309   4C74 F1                  POP AF
7310   4C75 B8                  CP B
7311   4C76 28 05               JR Z,G_EF_FAST_NO_CROSS
7312   4C78 32 D6 8A            LD (G_EDU_PREV_SIGN),A
7313   4C7B 37                  SCF
7314   4C7C C9                  RET
7315   4C7D             G_EF_FAST_NO_CROSS:
7316   4C7D 78                  LD A,B
7317   4C7E 32 D6 8A            LD (G_EDU_PREV_SIGN),A
7318   4C81 B7                  OR A
7319   4C82 C9                  RET
7320   4C83             
7321   4C83             ; Full trial retained only for the educated |EL|/15-hour jump, because that
7322   4C83             ; stage genuinely needs elevation magnitude to choose the next coarse step.
7323   4C83             ; Carry set = polarity changed (horizon bracketed).
7324   4C83             G_EF_TRY_STEP_FULL:
7325   4C83 2A CB 8A            LD HL,(G_EDU_MIN)
7326   4C86 22 D4 8A            LD (G_EDU_PREV_MIN),HL
7327   4C89 3A D6 8A            LD A,(G_EDU_PREV_SIGN)
7328   4C8C F5                  PUSH AF
7329   4C8D             
7330   4C8D 3A D3 8A            LD A,(G_EDU_DIR)
7331   4C90 B7                  OR A
7332   4C91 20 12               JR NZ,G_EF_TRY_SUB
7333   4C93             G_EF_TRY_ADD:
7334   4C93 ED 5B D1 8A         LD DE,(G_EDU_STEP)
7335   4C97 19                  ADD HL,DE
7336   4C98 11 A0 05            LD DE,1440
7337   4C9B B7                  OR A
7338   4C9C ED 52               SBC HL,DE
7339   4C9E 38 02               JR C,G_EF_TRY_ADD_RESTORE
7340   4CA0 18 10               JR G_EF_TRY_STORE
7341   4CA2             G_EF_TRY_ADD_RESTORE:
7342   4CA2 19                  ADD HL,DE
7343   4CA3 18 0D               JR G_EF_TRY_STORE
7344   4CA5             G_EF_TRY_SUB:
7345   4CA5 ED 5B D1 8A         LD DE,(G_EDU_STEP)
7346   4CA9 B7                  OR A
7347   4CAA ED 52               SBC HL,DE
7348   4CAC 30 04               JR NC,G_EF_TRY_STORE
7349   4CAE 11 A0 05            LD DE,1440
7350   4CB1 19                  ADD HL,DE
7351   4CB2             G_EF_TRY_STORE:
7352   4CB2 22 CB 8A            LD (G_EDU_MIN),HL
7353   4CB5 CD 26 4D            CALL G_EF_ELEV_AT_MIN
7354   4CB8 22 CD 8A            LD (G_EDU_EL10),HL
7355   4CBB CD 35 4C            CALL G_EF_SIGN_HL
7356   4CBE 47                  LD B,A                      ; B = sign after trial
7357   4CBF F1                  POP AF                      ; A = sign before trial
7358   4CC0 B8                  CP B
7359   4CC1 28 05               JR Z,G_EF_TRY_NO_CROSS
7360   4CC3                     ; Crossing: preserve the OLD-side polarity because callers restore
7361   4CC3                     ; G_EDU_PREV_MIN before trying the next finer step.
7362   4CC3 32 D6 8A            LD (G_EDU_PREV_SIGN),A
7363   4CC6 37                  SCF
7364   4CC7 C9                  RET
7365   4CC8             G_EF_TRY_NO_CROSS:
7366   4CC8 78                  LD A,B
7367   4CC9 32 D6 8A            LD (G_EDU_PREV_SIGN),A      ; new point becomes the old side next time
7368   4CCC B7                  OR A                        ; clear carry
7369   4CCD C9                  RET
7370   4CCE             
7371   4CCE             ; HL=local minute. Return A=0 below geometric horizon, A=1 at/above it.
7372   4CCE             ; For crossing polarity we only need the sign of UP; EAST/NORTH and the
7373   4CCE             ; elevation angle are unnecessary.  This preserves the existing geometric
7374   4CCE             ; zero-degree crossing exactly (it intentionally does NOT apply H0 here).
7375   4CCE             G_EF_SIGN_AT_MIN:
7376   4CCE CD D7 4C            CALL G_UP_FOR_VECTOR_FAST
7377   4CD1 2A 3B 89            LD HL,(AST_UP)
7378   4CD4 C3 35 4C            JP G_EF_SIGN_HL
7379   4CD7             
7380   4CD7             ; Compute only q and UP for the fixed AST_X/Y/Z vector.  Compared with
7381   4CD7             ; G_HORIZONTAL_FOR_VECTOR this skips EAST and NORTH entirely: two trig calls
7382   4CD7             ; and four Q15 multiplies instead of four trig calls and eight multiplies.
7383   4CD7             G_UP_FOR_VECTOR_FAST:
7384   4CD7 E5                  PUSH HL
7385   4CD8 CD F5 15            CALL ASTRO_SID_ADV10
7386   4CDB EB                  EX DE,HL
7387   4CDC 2A 2F 89            LD HL,(AST_LST0)
7388   4CDF 19                  ADD HL,DE
7389   4CE0 CD 86 0F            CALL ASTRO_NORM3600_SIGNED
7390   4CE3 22 8D 89            LD (G_TMPW0),HL
7391   4CE6             
7392   4CE6                     ; q = x*cos(LST) + y*sin(LST)
7393   4CE6 CD 24 16            CALL ASTRO_COS10
7394   4CE9 EB                  EX DE,HL
7395   4CEA 2A 20 89            LD HL,(AST_X)
7396   4CED CD 34 16            CALL ASTRO_MUL_Q15
7397   4CF0 22 8F 89            LD (G_TMPW1),HL
7398   4CF3 2A 8D 89            LD HL,(G_TMPW0)
7399   4CF6 CD 14 16            CALL ASTRO_SIN10
7400   4CF9 EB                  EX DE,HL
7401   4CFA 2A 22 89            LD HL,(AST_Y)
7402   4CFD CD 34 16            CALL ASTRO_MUL_Q15
7403   4D00 EB                  EX DE,HL
7404   4D01 2A 8F 89            LD HL,(G_TMPW1)
7405   4D04 19                  ADD HL,DE
7406   4D05 22 35 89            LD (AST_Q),HL
7407   4D08             
7408   4D08                     ; up = q*cos(lat) + z*sin(lat)
7409   4D08 ED 5B 16 8A         LD DE,(G_SITE_LAT_COS_Q15)
7410   4D0C CD 34 16            CALL ASTRO_MUL_Q15
7411   4D0F 22 8F 89            LD (G_TMPW1),HL
7412   4D12 2A 24 89            LD HL,(AST_Z)
7413   4D15 ED 5B 14 8A         LD DE,(G_SITE_LAT_SIN_Q15)
7414   4D19 CD 34 16            CALL ASTRO_MUL_Q15
7415   4D1C EB                  EX DE,HL
7416   4D1D 2A 8F 89            LD HL,(G_TMPW1)
7417   4D20 19                  ADD HL,DE
7418   4D21 22 3B 89            LD (AST_UP),HL
7419   4D24 E1                  POP HL
7420   4D25 C9                  RET
7421   4D26             
7422   4D26             ; HL=local minute, fixed AST_X/Y/Z vector.  Return signed elevation in
7423   4D26             ; tenths of a degree.  Used only where the educated coarse jump needs |EL|.
7424   4D26             G_EF_ELEV_AT_MIN:
7425   4D26 CD 50 4E            CALL G_HORIZONTAL_FOR_VECTOR
7426   4D29 2A 37 89            LD HL,(AST_EAST)
7427   4D2C CD 2E 17            CALL ASTRO_SQUARE16
7428   4D2F CD 3A 17            CALL ASTRO_COPY_ACC_TO_N
7429   4D32 2A 39 89            LD HL,(AST_NORTH)
7430   4D35 CD 2E 17            CALL ASTRO_SQUARE16
7431   4D38 CD 49 17            CALL ASTRO_ADD_ACC_TO_N
7432   4D3B CD 76 17            CALL ASTRO_ISQRT32
7433   4D3E EB                  EX DE,HL                   ; DE = horizontal magnitude
7434   4D3F 2A 3B 89            LD HL,(AST_UP)
7435   4D42 CD 73 18            CALL ASTRO_ATAN2_SIGNED90
7436   4D45 C9                  RET
7437   4D46             
7438   4D46             ; Refine a detected coarse horizon crossing.
7439   4D46             ; AST_PREV = state at previous coarse sample; AST_SCAN_MIN = current sample.
7440   4D46             ; Search current-9 through current.  For ordinary 10-minute samples this is
7441   4D46             ; exactly previous+1..current.  At the special 1439 sample it harmlessly starts
7442   4D46             ; at 1430 (one duplicate evaluation) and still covers through 1439.
7443   4D46             G_EF_REFINE_CROSSING:
7444   4D46 2A 6C 89            LD HL,(AST_SCAN_MIN)
7445   4D49 11 09 00            LD DE,9
7446   4D4C B7                  OR A
7447   4D4D ED 52               SBC HL,DE
7448   4D4F 22 4B 89            LD (AST_TMP6),HL               ; candidate minute
7449   4D52             G_EF_RC_LOOP:
7450   4D52 2A 4B 89            LD HL,(AST_TMP6)
7451   4D55 CD 32 14            CALL ASTRO_UP_AT_LOCAL_MIN
7452   4D58 CD 7E 14            CALL ASTRO_ABOVE_HORIZON
7453   4D5B 57                  LD D,A
7454   4D5C 3A 73 89            LD A,(AST_PREV)
7455   4D5F BA                  CP D
7456   4D60 20 13               JR NZ,G_EF_RC_FOUND
7457   4D62             
7458   4D62 2A 4B 89            LD HL,(AST_TMP6)
7459   4D65 23                  INC HL
7460   4D66 22 4B 89            LD (AST_TMP6),HL
7461   4D69 ED 5B 6C 89         LD DE,(AST_SCAN_MIN)
7462   4D6D B7                  OR A
7463   4D6E ED 52               SBC HL,DE
7464   4D70 38 E0               JR C,G_EF_RC_LOOP
7465   4D72 28 DE               JR Z,G_EF_RC_LOOP
7466   4D74 C9                  RET                             ; defensive: no crossing found
7467   4D75             
7468   4D75             G_EF_RC_FOUND:
7469   4D75 3A 73 89            LD A,(AST_PREV)
7470   4D78 B7                  OR A
7471   4D79 20 0E               JR NZ,G_EF_RC_SET
7472   4D7B 2A 26 89            LD HL,(AST_RISE)
7473   4D7E 7C                  LD A,H
7474   4D7F FE FF               CP $FF
7475   4D81 C0                  RET NZ
7476   4D82 2A 4B 89            LD HL,(AST_TMP6)
7477   4D85 22 26 89            LD (AST_RISE),HL
7478   4D88 C9                  RET
7479   4D89             G_EF_RC_SET:
7480   4D89 2A 28 89            LD HL,(AST_SET)
7481   4D8C 7C                  LD A,H
7482   4D8D FE FF               CP $FF
7483   4D8F C0                  RET NZ
7484   4D90 2A 4B 89            LD HL,(AST_TMP6)
7485   4D93 22 28 89            LD (AST_SET),HL
7486   4D96 C9                  RET
7487   4D97             
7488   4D97             
7489   4D97             ; Convert local minute-of-day in HL to the UTC-minute coordinate used by
7490   4D97             ; the active astronomy vector routines. Runtime offset is signed minutes:
7491   4D97             ; local = UTC + offset, therefore UTC = local - offset.
7492   4D97             G_LOCAL_TO_UTC_MIN:
7493   4D97 ED 5B 77 89         LD DE,(AST_UTC_OFFSET_MIN)
7494   4D9B B7                  OR A
7495   4D9C ED 52               SBC HL,DE
7496   4D9E C9                  RET
7497   4D9F             
7498   4D9F             ; Set AST_LST0 for local midnight.
7499   4D9F             G_SET_LST0:
7500   4D9F 2A 08 89            LD HL,(AST_SM)
7501   4DA2 ED 5B 0C 89         LD DE,(AST_SW)
7502   4DA6 19                  ADD HL,DE
7503   4DA7 11 08 07            LD DE,1800
7504   4DAA 19                  ADD HL,DE
7505   4DAB CD 7C 0F            CALL ASTRO_NORM3600
7506   4DAE ED 5B 10 8A         LD DE,(G_SITE_LON10)
7507   4DB2 19                  ADD HL,DE
7508   4DB3 E5                  PUSH HL
7509   4DB4 21 00 00            LD HL,0
7510   4DB7 CD 97 4D            CALL G_LOCAL_TO_UTC_MIN
7511   4DBA CD F5 15            CALL ASTRO_SID_ADV10
7512   4DBD D1                  POP DE
7513   4DBE 19                  ADD HL,DE
7514   4DBF CD 86 0F            CALL ASTRO_NORM3600_SIGNED
7515   4DC2 22 2F 89            LD (AST_LST0),HL
7516   4DC5 C9                  RET
7517   4DC6             
7518   4DC6             ; ---------------------------------------------------------------------------
7519   4DC6             ; CURRENT HORIZONTAL POSITION
7520   4DC6             ; ---------------------------------------------------------------------------
7521   4DC6             G_CURRENT_HORIZONTAL:
7522   4DC6                     ; local minute = hour*60 + minute
7523   4DC6 3A 04 89            LD A,(AST_HOUR)
7524   4DC9 26 00               LD H,0
7525   4DCB 6F                  LD L,A
7526   4DCC E5                  PUSH HL
7527   4DCD 29                  ADD HL,HL
7528   4DCE 29                  ADD HL,HL
7529   4DCF EB                  EX DE,HL
7530   4DD0 E1                  POP HL
7531   4DD1 29                  ADD HL,HL
7532   4DD2 29                  ADD HL,HL
7533   4DD3 29                  ADD HL,HL
7534   4DD4 29                  ADD HL,HL
7535   4DD5 29                  ADD HL,HL
7536   4DD6 29                  ADD HL,HL
7537   4DD7 B7                  OR A
7538   4DD8 ED 52               SBC HL,DE
7539   4DDA 3A 05 89            LD A,(AST_MINUTE)
7540   4DDD 5F                  LD E,A
7541   4DDE 16 00               LD D,0
7542   4DE0 19                  ADD HL,DE
7543   4DE1 22 75 89            LD (AST_LOCAL_MIN),HL
7544   4DE4                     ; Convert local minute using the selected runtime UTC offset.
7545   4DE4 CD 97 4D            CALL G_LOCAL_TO_UTC_MIN
7546   4DE7 CD F5 49            CALL G_VECTOR_SELECTED
7547   4DEA CD 9F 4D            CALL G_SET_LST0
7548   4DED 2A 75 89            LD HL,(AST_LOCAL_MIN)
7549   4DF0 CD 50 4E            CALL G_HORIZONTAL_FOR_VECTOR
7550   4DF3                     ; visibility
7551   4DF3 CD F1 17            CALL ASTRO_VECTOR_DISTANCE
7552   4DF6 3A 80 89            LD A,(G_OBJECT)
7553   4DF9 FE 02               CP G_OBJ_SUN
7554   4DFB 28 09               JR Z,G_CH_SUNH
7555   4DFD FE 09               CP G_OBJ_MOON
7556   4DFF 28 0A               JR Z,G_CH_MOONH
7557   4E01 11 BC FE            LD DE,G_H0_PLANET
7558   4E04 18 08               JR G_CH_HSET
7559   4E06             G_CH_SUNH:
7560   4E06 11 24 FE            LD DE,G_H0_SUN
7561   4E09 18 03               JR G_CH_HSET
7562   4E0B             G_CH_MOONH:
7563   4E0B 11 47 00            LD DE,G_H0_MOON
7564   4E0E             G_CH_HSET:
7565   4E0E CD 34 16            CALL ASTRO_MUL_Q15
7566   4E11 22 31 89            LD (AST_HORIZON_Q),HL
7567   4E14 2A 3B 89            LD HL,(AST_UP)
7568   4E17 CD 7E 14            CALL ASTRO_ABOVE_HORIZON
7569   4E1A 32 2E 89            LD (AST_VISIBLE),A
7570   4E1D                     ; azimuth
7571   4E1D 2A 37 89            LD HL,(AST_EAST)
7572   4E20 ED 5B 39 89         LD DE,(AST_NORTH)
7573   4E24 CD 0F 18            CALL ASTRO_ATAN2_10
7574   4E27 22 2A 89            LD (AST_AZ10),HL
7575   4E2A                     ; horizontal magnitude
7576   4E2A 2A 37 89            LD HL,(AST_EAST)
7577   4E2D CD 2E 17            CALL ASTRO_SQUARE16
7578   4E30 CD 3A 17            CALL ASTRO_COPY_ACC_TO_N
7579   4E33 2A 39 89            LD HL,(AST_NORTH)
7580   4E36 CD 2E 17            CALL ASTRO_SQUARE16
7581   4E39 CD 49 17            CALL ASTRO_ADD_ACC_TO_N
7582   4E3C CD 76 17            CALL ASTRO_ISQRT32
7583   4E3F 22 3D 89            LD (AST_HOR),HL
7584   4E42                     ; elevation
7585   4E42 2A 3B 89            LD HL,(AST_UP)
7586   4E45 ED 5B 3D 89         LD DE,(AST_HOR)
7587   4E49 CD 73 18            CALL ASTRO_ATAN2_SIGNED90
7588   4E4C 22 2C 89            LD (AST_EL10),HL
7589   4E4F C9                  RET
7590   4E50             
7591   4E50             ; HL=local minute, current AST_X/Y/Z vector. Computes east/north/up.
7592   4E50             G_HORIZONTAL_FOR_VECTOR:
7593   4E50 E5                  PUSH HL
7594   4E51 CD F5 15            CALL ASTRO_SID_ADV10
7595   4E54 EB                  EX DE,HL
7596   4E55 2A 2F 89            LD HL,(AST_LST0)
7597   4E58 19                  ADD HL,DE
7598   4E59 CD 86 0F            CALL ASTRO_NORM3600_SIGNED
7599   4E5C 22 8D 89            LD (G_TMPW0),HL            ; LST
7600   4E5F                     ; q=x cosLST + y sinLST
7601   4E5F CD 24 16            CALL ASTRO_COS10
7602   4E62 EB                  EX DE,HL
7603   4E63 2A 20 89            LD HL,(AST_X)
7604   4E66 CD 34 16            CALL ASTRO_MUL_Q15
7605   4E69 22 8F 89            LD (G_TMPW1),HL
7606   4E6C 2A 8D 89            LD HL,(G_TMPW0)
7607   4E6F CD 14 16            CALL ASTRO_SIN10
7608   4E72 EB                  EX DE,HL
7609   4E73 2A 22 89            LD HL,(AST_Y)
7610   4E76 CD 34 16            CALL ASTRO_MUL_Q15
7611   4E79 EB                  EX DE,HL
7612   4E7A 2A 8F 89            LD HL,(G_TMPW1)
7613   4E7D 19                  ADD HL,DE
7614   4E7E 22 35 89            LD (AST_Q),HL
7615   4E81                     ; east=-x sinLST + y cosLST
7616   4E81 2A 8D 89            LD HL,(G_TMPW0)
7617   4E84 CD 14 16            CALL ASTRO_SIN10
7618   4E87 EB                  EX DE,HL
7619   4E88 2A 20 89            LD HL,(AST_X)
7620   4E8B CD 34 16            CALL ASTRO_MUL_Q15
7621   4E8E CD CF 19            CALL ASTRO_NEG_HL
7622   4E91 22 8F 89            LD (G_TMPW1),HL
7623   4E94 2A 8D 89            LD HL,(G_TMPW0)
7624   4E97 CD 24 16            CALL ASTRO_COS10
7625   4E9A EB                  EX DE,HL
7626   4E9B 2A 22 89            LD HL,(AST_Y)
7627   4E9E CD 34 16            CALL ASTRO_MUL_Q15
7628   4EA1 EB                  EX DE,HL
7629   4EA2 2A 8F 89            LD HL,(G_TMPW1)
7630   4EA5 19                  ADD HL,DE
7631   4EA6 22 37 89            LD (AST_EAST),HL
7632   4EA9                     ; north=-q sinlat + z coslat
7633   4EA9 2A 35 89            LD HL,(AST_Q)
7634   4EAC ED 5B 14 8A         LD DE,(G_SITE_LAT_SIN_Q15)
7635   4EB0 CD 34 16            CALL ASTRO_MUL_Q15
7636   4EB3 CD CF 19            CALL ASTRO_NEG_HL
7637   4EB6 22 8F 89            LD (G_TMPW1),HL
7638   4EB9 2A 24 89            LD HL,(AST_Z)
7639   4EBC ED 5B 16 8A         LD DE,(G_SITE_LAT_COS_Q15)
7640   4EC0 CD 34 16            CALL ASTRO_MUL_Q15
7641   4EC3 EB                  EX DE,HL
7642   4EC4 2A 8F 89            LD HL,(G_TMPW1)
7643   4EC7 19                  ADD HL,DE
7644   4EC8 22 39 89            LD (AST_NORTH),HL
7645   4ECB                     ; up=q coslat + z sinlat
7646   4ECB 2A 35 89            LD HL,(AST_Q)
7647   4ECE ED 5B 16 8A         LD DE,(G_SITE_LAT_COS_Q15)
7648   4ED2 CD 34 16            CALL ASTRO_MUL_Q15
7649   4ED5 22 8F 89            LD (G_TMPW1),HL
7650   4ED8 2A 24 89            LD HL,(AST_Z)
7651   4EDB ED 5B 14 8A         LD DE,(G_SITE_LAT_SIN_Q15)
7652   4EDF CD 34 16            CALL ASTRO_MUL_Q15
7653   4EE2 EB                  EX DE,HL
7654   4EE3 2A 8F 89            LD HL,(G_TMPW1)
7655   4EE6 19                  ADD HL,DE
7656   4EE7 22 3B 89            LD (AST_UP),HL
7657   4EEA E1                  POP HL
7658   4EEB C9                  RET
7659   4EEC             
7660   4EEC             ; ---------------------------------------------------------------------------
7661   4EEC             ; MOON DATE ELEMENTS + VECTOR
7662   4EEC             ; ---------------------------------------------------------------------------
7663   4EEC             G_PREPARE_MOON:
7664   4EEC                     ; N = 125.1228 -0.0529538083*d
7665   4EEC 21 E3 04            LD HL,1251
7666   4EEF 22 96 89            LD (G_CALC_BASE),HL
7667   4EF2 21 51 EB            LD HL,-5295
7668   4EF5 22 98 89            LD (G_CALC_RATE),HL
7669   4EF8 CD A6 46            CALL G_CALC_SMALL
