7671   4EFE                     ; i=5.1454
7672   4EFE 21 33 00            LD HL,51
7673   4F01 22 C0 89            LD (G_I),HL
7674   4F04                     ; w=318.0634 +0.1643573223*d
7675   4F04 21 6D 0C            LD HL,3181
7676   4F07 22 96 89            LD (G_CALC_BASE),HL
7677   4F0A 21 34 40            LD HL,16436
7678   4F0D 22 98 89            LD (G_CALC_RATE),HL
7679   4F10 CD A6 46            CALL G_CALC_SMALL
7680   4F13 22 C2 89            LD (G_W),HL
7681   4F16                     ; M=115.3654 +13.0649929509*d
7682   4F16 21 82 04            LD HL,1154
7683   4F19 22 96 89            LD (G_CALC_BASE),HL
7684   4F1C 21 82 00            LD HL,130
7685   4F1F 22 9A 89            LD (G_CALC_INT),HL
7686   4F22 21 63 19            LD HL,6499
7687   4F25 22 9C 89            LD (G_CALC_FRAC),HL
7688   4F28 CD E0 46            CALL G_CALC_MEAN
7689   4F2B 22 C4 89            LD (G_M),HL
7690   4F2E C9                  RET
7691   4F2F             
7692   4F2F             G_VECTOR_MOON:
7693   4F2F                     ; Sun vector already computed, G_UTC_MIN preserved by G_SUN_VECTOR.
