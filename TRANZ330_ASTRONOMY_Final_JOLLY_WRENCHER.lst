5308   3B15 28 18               JR Z,G_PRS_LITERAL
5309   3B17 3A 49 89            LD A,(AST_TMP5)
5310   3B1A B7                  OR A
5311   3B1B 28 0F               JR Z,G_PRS_MASK
5312   3B1D 1A                  LD A,(DE)
5313   3B1E C6 30               ADD A,'0'
5314   3B20 13                  INC DE
5315   3B21 4F                  LD C,A
5316   3B22 3A 49 89            LD A,(AST_TMP5)
5317   3B25 3D                  DEC A
5318   3B26 32 49 89            LD (AST_TMP5),A
5319   3B29 79                  LD A,C
5320   3B2A 18 05               JR G_PRS_PUT
5321   3B2C             G_PRS_MASK:
5322   3B2C 7E                  LD A,(HL)
5323   3B2D 18 02               JR G_PRS_PUT
5324   3B2F             G_PRS_LITERAL:
