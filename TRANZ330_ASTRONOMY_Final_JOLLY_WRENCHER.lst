5289   3AED 3A 4F 89            LD A,(AST_INPUT_MODE)
5290   3AF0 B7                  OR A
5291   3AF1 20 0B               JR NZ,G_PRS_TIME
5292   3AF3 21 62 1A            LD HL,MSG_DATE_PREFIX
5293   3AF6 CD 48 06            CALL DISPLAY_PRINT_Z
5294   3AF9 21 68 1A            LD HL,MSG_DATE_MASK
5295   3AFC 18 09               JR G_PRS_FORMAT
