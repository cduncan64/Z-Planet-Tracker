8764   582D                     ; We have a complete, checksum-valid active RMC sentence.
8765   582D CD DC 5A            CALL GPS_COMMIT_FIX
8766   5830 C9                  RET
8767   5831             
8768   5831             ; A checksum failure returns carry set. Checksum is XOR of bytes after '$'
8769   5831             ; through byte before '*', compared to the two ASCII hex digits after '*'.
8770   5831             GPS_VALIDATE_CHECKSUM:
8771   5831 21 50 8A            LD HL,GPS_BUFFER
8772   5834 7E                  LD A,(HL)
8773   5835 FE 24               CP '$'
8774   5837 20 2B               JR NZ,GPS_CKS_BAD
8775   5839 23                  INC HL
8776   583A 06 00               LD B,0
8777   583C             GPS_CKS_LOOP:
8778   583C 7E                  LD A,(HL)
8779   583D B7                  OR A
8780   583E 28 24               JR Z,GPS_CKS_BAD
8781   5840 FE 2A               CP '*'
8782   5842 28 07               JR Z,GPS_CKS_STAR
8783   5844 4F                  LD C,A
8784   5845 78                  LD A,B
8785   5846 A9                  XOR C
8786   5847 47                  LD B,A
8787   5848 23                  INC HL
8788   5849 18 F1               JR GPS_CKS_LOOP
8789   584B             GPS_CKS_STAR:
8790   584B 23                  INC HL
8791   584C 7E                  LD A,(HL)
8792   584D CD 66 58            CALL GPS_HEX_NIBBLE
8793   5850 38 12               JR C,GPS_CKS_BAD
8794   5852 87                  ADD A,A
8795   5853 87                  ADD A,A
8796   5854 87                  ADD A,A
8797   5855 87                  ADD A,A
8798   5856 57                  LD D,A
8799   5857 23                  INC HL
8800   5858 7E                  LD A,(HL)
8801   5859 CD 66 58            CALL GPS_HEX_NIBBLE
8802   585C 38 06               JR C,GPS_CKS_BAD
8803   585E B2                  OR D
8804   585F B8                  CP B
8805   5860 20 02               JR NZ,GPS_CKS_BAD
8806   5862 B7                  OR A
8807   5863 C9                  RET
8808   5864             GPS_CKS_BAD:
8809   5864 37                  SCF
8810   5865 C9                  RET
8811   5866             
8812   5866             ; ASCII hex nibble -> A=0..15, carry on invalid.
8813   5866             GPS_HEX_NIBBLE:
8814   5866 FE 30               CP '0'
8815   5868 38 20               JR C,GPS_HEX_BAD
8816   586A FE 3A               CP '9'+1
8817   586C 38 18               JR C,GPS_HEX_DEC
8818   586E FE 41               CP 'A'
8819   5870 38 04               JR C,GPS_HEX_LOWER_TEST
8820   5872 FE 47               CP 'F'+1
8821   5874 38 0C               JR C,GPS_HEX_UPPER
8822   5876             GPS_HEX_LOWER_TEST:
8823   5876 FE 61               CP 'a'
8824   5878 38 10               JR C,GPS_HEX_BAD
8825   587A FE 67               CP 'f'+1
8826   587C 30 0C               JR NC,GPS_HEX_BAD
8827   587E D6 57               SUB 'a'-10
8828   5880 B7                  OR A
8829   5881 C9                  RET
8830   5882             GPS_HEX_UPPER:
8831   5882 D6 37               SUB 'A'-10
8832   5884 B7                  OR A
8833   5885 C9                  RET
8834   5886             GPS_HEX_DEC:
8835   5886 D6 30               SUB '0'
8836   5888 B7                  OR A
8837   5889 C9                  RET
8838   588A             GPS_HEX_BAD:
8839   588A 37                  SCF
8840   588B C9                  RET
8841   588C             
8842   588C             ; Parse two decimal digits at (HL), advance HL by two, A=value, carry invalid.
8843   588C             GPS_PARSE_2DIG:
8844   588C 7E                  LD A,(HL)
