0907   06BE             ; ============================================================================
0908   06BE             ; TRANZ 330 - FIXED-POINT JUPITER ASTRONOMY MODULE V1
0909   06BE             ; Target: Z80 / VeriFone TRANZ 330 / 16-character MSC1937 VFD
0910   06BE             ;
0911   06BE             ; SITE:
0912   06BE             ;   Latitude  = +30.3950 deg
0913   06BE             ;   Longitude = -88.1805 deg (west negative)
0914   06BE             ;   Local time = UTC-5, fixed
0915   06BE             ;
0916   06BE             ; DISPLAY ROTATION (ENTER advances, CLEAR is handled globally by V4 firmware):
0917   06BE             ;   JUPITER VIS
0918   06BE             ;   JUPITER NOVIS
0919   06BE             ;   RISE 04:21
0920   06BE             ;   SET 17:47
0921   06BE             ;   AZ 255.8 DEG
0922   06BE             ;   EL +54.7 DEG
0923   06BE             ;
0924   06BE             ; "VIS" here means Jupiter is above the standard apparent rise/set horizon
0925   06BE             ; (-0.5667 deg).  It does NOT attempt to judge daylight, clouds, buildings,
0926   06BE             ; extinction, or naked-eye detectability.
0927   06BE             ;
0928   06BE             ; FIXED-POINT REPRESENTATION
0929   06BE             ;   Angles:       tenths of a degree, 0..3599
0930   06BE             ;   Trig:         signed Q15, -32767..+32767
0931   06BE             ;   Coordinates:  signed 16-bit, 4096 units = 1 AU
0932   06BE             ;   Times:        local minutes after midnight, 0..1439
0933   06BE             ;
0934   06BE             ; MODEL
0935   06BE             ;   Low-precision orbital elements for Sun/Earth and Jupiter, with the
0936   06BE             ;   principal Jupiter/Saturn longitude perturbation series.
0937   06BE             ;   Ecliptic -> equatorial -> local horizontal transformation.
0938   06BE             ;   Rise/set are found by a one-minute scan of the local civil day.
0939   06BE             ;
0940   06BE             ; EXPECTED PRACTICAL ACCURACY
0941   06BE             ;   Intended for a retrocomputer planet finder, not an observatory almanac.
0942   06BE             ;   With 0.1-degree trig quantization, expect rise/set to usually be within
0943   06BE             ;   a few minutes and instantaneous az/el generally within about 1 degree.
0944   06BE             ;
0945   06BE             ; EXTERNAL ROUTINES PROVIDED BY TRANZ330_MULTI_V4:
0946   06BE             ;   DISPLAY_SHOW       HL -> zero-terminated string, clears/pads
0947   06BE             ;   DISPLAY_CLEAR
0948   06BE             ;   DISPLAY_PRINT_Z
0949   06BE             ;   DISPLAY_PUT_ASCII  A=ASCII
0950   06BE             ;   DISPLAY_DEC2       A=0..99
0951   06BE             ;   KEY_GET            A=raw key code
0952   06BE             ;   KEYCODE_TO_DIGIT   A=key code -> A=0..9, C clear; C set if non-digit
0953   06BE             ;
0954   06BE             ; External key constants expected:
0955   06BE             ;   KEY_CLEAR       EQU $04
0956   06BE             ;   KEY_BACKSPACE   EQU $08
0957   06BE             ;   KEY_ENTER       EQU $10
0958   06BE             ;
0959   06BE             ; INTEGRATION:
0960   06BE             ;   1) Reserve the ASTRO RAM block below.
0961   06BE             ;   2) CALL ASTRO_CLOCK_INIT once after DISPLAY_INIT during MAIN startup.
0962   06BE             ;   3) Replace OPTION9 with:
0963   06BE             ;
0964   06BE             ;        OPTION9:
0965   06BE             ;                DI
0966   06BE             ;                CALL ASTRO_JUPITER_RUN
0967   06BE             ;                JP MENU
0968   06BE             ;
0969   06BE             ; ============================================================================
0970   06BE             
0971   06BE             ; RTC I/O map is defined once at the top of the ROM.
0972   06BE             
0973   06BE             ; ----------------------------------------------------------------------------
0974   06BE             ; Site constants
0975   06BE             ; ----------------------------------------------------------------------------
0976   06BE             UTC_OFFSET_DEFAULT EQU 0             ; GPS is UTC; user selects local whole-hour offset after each fix
0977   06BE             LON10           EQU -888           ; -88.7548 deg rounded to -88.8 in 0.1-degree units
0978   06BE             LAT_SIN_Q15     EQU 16564          ; sin(+30.3642 deg) * 32767
0979   06BE             LAT_COS_Q15     EQU 28272          ; cos(+30.3642 deg) * 32767
0980   06BE             H0_SIN_Q15      EQU -324           ; sin(-0.5667 deg) * 32767
0981   06BE             OBL_SIN_Q15     EQU 13034          ; sin(23.4393 deg)
0982   06BE             OBL_COS_Q15     EQU 30063          ; cos(23.4393 deg)
0983   06BE             
0984   06BE             ; Orbit coordinate constants, 4096 units = 1 AU
0985   06BE             SUN_A_Q         EQU 4096
0986   06BE             SUN_AE_Q        EQU 68             ; a*e*4096
0987   06BE             SUN_B_Q         EQU 4095           ; a*sqrt(1-e^2)*4096
0988   06BE             
0989   06BE             JUP_A_Q         EQU 21310          ; 5.20256 AU * 4096
0990   06BE             JUP_AE_Q        EQU 1033           ; a*e*4096
0991   06BE             JUP_B_Q         EQU 21285          ; a*sqrt(1-e^2)*4096
0992   06BE             
0993   06BE             ; ----------------------------------------------------------------------------
0994   06BE             ; RAM.  Move this block if it collides with other firmware.
0995   06BE             ; ----------------------------------------------------------------------------
0996   06BE             ; Preserve original astronomy RAM addresses for compatibility.
0997   06BE             ASTRO_RAM       EQU $8900
0998   06BE             
0999   06BE             AST_CLOCK_OK    EQU ASTRO_RAM+0
1000   06BE             AST_YEAR        EQU ASTRO_RAM+1    ; 0..99 => 2000..2099
1001   06BE             AST_MONTH       EQU ASTRO_RAM+2
1002   06BE             AST_DAY         EQU ASTRO_RAM+3
1003   06BE             AST_HOUR        EQU ASTRO_RAM+4
1004   06BE             AST_MINUTE      EQU ASTRO_RAM+5
1005   06BE             
1006   06BE             AST_DAYS        EQU ASTRO_RAM+6    ; word, days since 1999-12-31
1007   06BE             
1008   06BE             AST_SM          EQU ASTRO_RAM+8    ; Sun mean anomaly, angle10
1009   06BE             AST_SMF         EQU ASTRO_RAM+10   ; fractional tenth, scale 10000
1010   06BE             AST_SW          EQU ASTRO_RAM+12   ; Sun longitude perihelion
1011   06BE             AST_SWF         EQU ASTRO_RAM+14
1012   06BE             
1013   06BE             AST_JN          EQU ASTRO_RAM+16
1014   06BE             AST_JNF         EQU ASTRO_RAM+18
1015   06BE             AST_JW          EQU ASTRO_RAM+20
1016   06BE             AST_JWF         EQU ASTRO_RAM+22
1017   06BE             AST_JM          EQU ASTRO_RAM+24
1018   06BE             AST_JMF         EQU ASTRO_RAM+26
1019   06BE             AST_SATM        EQU ASTRO_RAM+28
1020   06BE             AST_SATMF       EQU ASTRO_RAM+30
1021   06BE             
1022   06BE             AST_X           EQU ASTRO_RAM+32   ; equatorial Jupiter vector
1023   06BE             AST_Y           EQU ASTRO_RAM+34
1024   06BE             AST_Z           EQU ASTRO_RAM+36
1025   06BE             
1026   06BE             AST_RISE        EQU ASTRO_RAM+38   ; local minute, FFFF=none
1027   06BE             AST_SET         EQU ASTRO_RAM+40
1028   06BE             AST_AZ10        EQU ASTRO_RAM+42   ; 0..3599
1029   06BE             AST_EL10        EQU ASTRO_RAM+44   ; signed -900..+900
1030   06BE             AST_VISIBLE     EQU ASTRO_RAM+46
1031   06BE             
1032   06BE             AST_LST0        EQU ASTRO_RAM+47   ; local sidereal angle at local midnight
1033   06BE             AST_HORIZON_Q   EQU ASTRO_RAM+49   ; signed coordinate threshold
1034   06BE             AST_DIST_Q      EQU ASTRO_RAM+51
1035   06BE             
1036   06BE             AST_Q           EQU ASTRO_RAM+53   ; local intermediate
1037   06BE             AST_EAST        EQU ASTRO_RAM+55
1038   06BE             AST_NORTH       EQU ASTRO_RAM+57
1039   06BE             AST_UP          EQU ASTRO_RAM+59
1040   06BE             AST_HOR         EQU ASTRO_RAM+61
1041   06BE             
1042   06BE             AST_TMP0        EQU ASTRO_RAM+63
1043   06BE             AST_TMP1        EQU ASTRO_RAM+65
1044   06BE             AST_TMP2        EQU ASTRO_RAM+67
1045   06BE             AST_TMP3        EQU ASTRO_RAM+69
1046   06BE             AST_TMP4        EQU ASTRO_RAM+71
1047   06BE             AST_TMP5        EQU ASTRO_RAM+73
1048   06BE             AST_TMP6        EQU ASTRO_RAM+75
1049   06BE             AST_TMP7        EQU ASTRO_RAM+77
1050   06BE             AST_INPUT_MODE  EQU ASTRO_RAM+79   ; 0=date, 1=time
1051   06BE             
1052   06BE             AST_INPUT       EQU ASTRO_RAM+80   ; 6 bytes for manual clock entry
1053   06BE             AST_INCOUNT     EQU ASTRO_RAM+86
1054   06BE             AST_SECOND      EQU ASTRO_RAM+87   ; 0..59, manual/RTC seconds
1055   06BE             
1056   06BE             ; 32-bit multiply / compare scratch, little-endian
1057   06BE             M32_MC          EQU ASTRO_RAM+88   ; 4 bytes multiplicand
1058   06BE             M32_MR          EQU ASTRO_RAM+92   ; 2 bytes multiplier
1059   06BE             M32_ACC         EQU ASTRO_RAM+94   ; 4 bytes accumulator
1060   06BE             M32_N           EQU ASTRO_RAM+98   ; 4 bytes sqrt target
1061   06BE             M32_TEST        EQU ASTRO_RAM+102  ; 4 bytes square/test value
1062   06BE             M32_SIGN        EQU ASTRO_RAM+106
1063   06BE             
1064   06BE             AST_SCAN_MIN    EQU ASTRO_RAM+108  ; word
1065   06BE             AST_LOOPCTR     EQU ASTRO_RAM+110  ; byte
1066   06BE             AST_LOW         EQU ASTRO_RAM+111  ; word
1067   06BE             AST_HIGH        EQU ASTRO_RAM+113  ; word
1068   06BE             AST_PREV        EQU ASTRO_RAM+115  ; byte
1069   06BE             AST_QUAD        EQU ASTRO_RAM+116  ; byte
1070   06BE             AST_LOCAL_MIN   EQU ASTRO_RAM+117  ; word
1071   06BE             AST_UTC_OFFSET_MIN EQU ASTRO_RAM+119 ; signed minutes, e.g. -300 = UTC-5
1072   06BE             AST_UTC_PENDING_HR EQU ASTRO_RAM+121 ; pending whole-hour magnitude 0..12
1073   06BE             AST_UTC_PENDING_SIGN EQU ASTRO_RAM+122 ; legacy/manual startup field
1074   06BE             AST_UTC_OFFSET_HR EQU ASTRO_RAM+123    ; signed whole-hour runtime offset, -12..+12
1075   06BE             
1076   06BE             ; ============================================================================
1077   06BE             ; PUBLIC ENTRY POINTS
1078   06BE             ; ============================================================================
1079   06BE             
1080   06BE             ; ----------------------------------------------------------------------------
1081   06BE             ; ASTRO_CLOCK_INIT
1082   06BE             ; Read local civil date/time from the TRANZ RTC.
1083   06BE             ; If invalid, ask the user once for MMDDYY and HHMM.
1084   06BE             ; ----------------------------------------------------------------------------
1085   06BE             ASTRO_CLOCK_INIT:
1086   06BE                     ; Read the MSM6242-family RTC using the same HOLD/BUSY convention
1087   06BE                     ; used by the original VeriFone firmware: write $05 to control D
1088   06BE                     ; (HOLD request while preserving IRQ flag semantics), wait for BUSY=0,
1089   06BE                     ; read the twelve BCD digit registers, then write $04 to release HOLD.
1090   06BE CD 82 07            CALL RTC_HOLD_WAIT
1091   06C1 DA 75 07            JP C,ASTRO_CLOCK_BAD
1092   06C4             
1093   06C4 DB 30               IN A,(RTC_SEC_1)
1094   06C6 E6 0F               AND $0F
1095   06C8 4F                  LD C,A
1096   06C9 DB 31               IN A,(RTC_SEC_10)
1097   06CB E6 0F               AND $0F
1098   06CD CD 7B 07            CALL RTC_DIGITS_TO_BIN
1099   06D0 32 4F 8A            LD (RTC_TMP_SECOND),A
1100   06D3             
1101   06D3 DB 32               IN A,(RTC_MIN_1)
1102   06D5 E6 0F               AND $0F
1103   06D7 4F                  LD C,A
1104   06D8 DB 33               IN A,(RTC_MIN_10)
1105   06DA E6 0F               AND $0F
1106   06DC CD 7B 07            CALL RTC_DIGITS_TO_BIN
1107   06DF 32 4E 8A            LD (RTC_TMP_MINUTE),A
1108   06E2             
1109   06E2 DB 34               IN A,(RTC_HOUR_1)
1110   06E4 E6 0F               AND $0F
1111   06E6 4F                  LD C,A
1112   06E7 DB 35               IN A,(RTC_HOUR_10)
1113   06E9 E6 03               AND $03              ; 24-hour mode: only 0..2 is meaningful
1114   06EB CD 7B 07            CALL RTC_DIGITS_TO_BIN
1115   06EE 32 4D 8A            LD (RTC_TMP_HOUR),A
1116   06F1             
1117   06F1 DB 36               IN A,(RTC_DAY_1)
1118   06F3 E6 0F               AND $0F
1119   06F5 4F                  LD C,A
1120   06F6 DB 37               IN A,(RTC_DAY_10)
1121   06F8 E6 0F               AND $0F
1122   06FA CD 7B 07            CALL RTC_DIGITS_TO_BIN
1123   06FD 32 4C 8A            LD (RTC_TMP_DAY),A
1124   0700             
1125   0700 DB 38               IN A,(RTC_MONTH_1)
1126   0702 E6 0F               AND $0F
1127   0704 4F                  LD C,A
1128   0705 DB 39               IN A,(RTC_MONTH_10)
1129   0707 E6 0F               AND $0F
1130   0709 CD 7B 07            CALL RTC_DIGITS_TO_BIN
1131   070C 32 4B 8A            LD (RTC_TMP_MONTH),A
1132   070F             
1133   070F DB 3A               IN A,(RTC_YEAR_1)
1134   0711 E6 0F               AND $0F
1135   0713 4F                  LD C,A
1136   0714 DB 3B               IN A,(RTC_YEAR_10)
1137   0716 E6 0F               AND $0F
1138   0718 CD 7B 07            CALL RTC_DIGITS_TO_BIN
1139   071B 32 4A 8A            LD (RTC_TMP_YEAR),A
1140   071E             
1141   071E CD 9B 07            CALL RTC_HOLD_RELEASE
1142   0721             
1143   0721                     ; Range validation.  Day/month combination is validated later by
1144   0721                     ; astronomy date handling; reject impossible basic RTC fields here.
1145   0721 3A 4F 8A            LD A,(RTC_TMP_SECOND)
1146   0724 FE 3C               CP 60
1147   0726 30 4D               JR NC,ASTRO_CLOCK_BAD_RELEASED
1148   0728 3A 4E 8A            LD A,(RTC_TMP_MINUTE)
1149   072B FE 3C               CP 60
1150   072D 30 46               JR NC,ASTRO_CLOCK_BAD_RELEASED
1151   072F 3A 4D 8A            LD A,(RTC_TMP_HOUR)
1152   0732 FE 18               CP 24
1153   0734 30 3F               JR NC,ASTRO_CLOCK_BAD_RELEASED
1154   0736 3A 4B 8A            LD A,(RTC_TMP_MONTH)
1155   0739 B7                  OR A
1156   073A 28 39               JR Z,ASTRO_CLOCK_BAD_RELEASED
1157   073C FE 0D               CP 13
1158   073E 30 35               JR NC,ASTRO_CLOCK_BAD_RELEASED
1159   0740 3A 4C 8A            LD A,(RTC_TMP_DAY)
1160   0743 B7                  OR A
1161   0744 28 2F               JR Z,ASTRO_CLOCK_BAD_RELEASED
1162   0746 FE 20               CP 32
1163   0748 30 2B               JR NC,ASTRO_CLOCK_BAD_RELEASED
1164   074A             
1165   074A                     ; Snapshot is valid: commit it atomically to the astronomy clock.
1166   074A 3A 4A 8A            LD A,(RTC_TMP_YEAR)
1167   074D 32 01 89            LD (AST_YEAR),A
1168   0750 3A 4B 8A            LD A,(RTC_TMP_MONTH)
1169   0753 32 02 89            LD (AST_MONTH),A
1170   0756 3A 4C 8A            LD A,(RTC_TMP_DAY)
1171   0759 32 03 89            LD (AST_DAY),A
1172   075C 3A 4D 8A            LD A,(RTC_TMP_HOUR)
1173   075F 32 04 89            LD (AST_HOUR),A
1174   0762 3A 4E 8A            LD A,(RTC_TMP_MINUTE)
1175   0765 32 05 89            LD (AST_MINUTE),A
1176   0768 3A 4F 8A            LD A,(RTC_TMP_SECOND)
1177   076B 32 57 89            LD (AST_SECOND),A
1178   076E             
1179   076E                     ; Reading the RTC must not alter the user-selected UTC offset.
1180   076E 3E 01               LD A,1
1181   0770 32 00 89            LD (AST_CLOCK_OK),A
1182   0773 B7                  OR A                    ; clear carry
1183   0774 C9                  RET
1184   0775             
1185   0775             ASTRO_CLOCK_BAD:
1186   0775                     ; RTC_HOLD_WAIT already releases HOLD on timeout.
1187   0775             ASTRO_CLOCK_BAD_RELEASED:
1188   0775 AF                  XOR A
1189   0776 32 00 89            LD (AST_CLOCK_OK),A
1190   0779 37                  SCF
1191   077A C9                  RET
1192   077B             
1193   077B             ; A=tens digit, C=ones digit -> A=binary 0..99.
1194   077B             RTC_DIGITS_TO_BIN:
1195   077B 47                  LD B,A
1196   077C 87                  ADD A,A                 ; 2*tens
1197   077D 87                  ADD A,A                 ; 4*tens
1198   077E 80                  ADD A,B                 ; 5*tens
1199   077F 87                  ADD A,A                 ; 10*tens
1200   0780 81                  ADD A,C
1201   0781 C9                  RET
1202   0782             
1203   0782             ; Assert HOLD and wait for BUSY to clear.  The finite timeout prevents a
1204   0782             ; failed/missing RTC from hanging the terminal forever.
1205   0782             RTC_HOLD_WAIT:
1206   0782 3E 05               LD A,$05
1207   0784 D3 3D               OUT (RTC_CTRL_D),A
1208   0786 01 FF FF            LD BC,$FFFF
1209   0789             RTC_HW_LOOP:
1210   0789 DB 3D               IN A,(RTC_CTRL_D)
1211   078B E6 02               AND $02
1212   078D 28 0A               JR Z,RTC_HW_READY
1213   078F 0B                  DEC BC
1214   0790 78                  LD A,B
1215   0791 B1                  OR C
1216   0792 20 F5               JR NZ,RTC_HW_LOOP
1217   0794 CD 9B 07            CALL RTC_HOLD_RELEASE
1218   0797 37                  SCF
1219   0798 C9                  RET
1220   0799             RTC_HW_READY:
1221   0799 B7                  OR A                    ; clear carry
1222   079A C9                  RET
1223   079B             
1224   079B             RTC_HOLD_RELEASE:
1225   079B 3E 04               LD A,$04
1226   079D D3 3D               OUT (RTC_CTRL_D),A
1227   079F C9                  RET
1228   07A0             
1229   07A0             ; Write AST_* local civil time to RTC digit registers.  Weekday is deliberately
1230   07A0             ; left untouched; the original VeriFone 12-digit write path likewise handles
1231   07A0             ; $3B..$30 separately from weekday $3C.
1232   07A0             RTC_WRITE_LOCAL:
1233   07A0 CD 82 07            CALL RTC_HOLD_WAIT
1234   07A3 D8                  RET C
1235   07A4             
1236   07A4 3A 57 89            LD A,(AST_SECOND)
1237   07A7 CD F1 07            CALL RTC_BIN_TO_DIGITS
1238   07AA 79                  LD A,C
1239   07AB D3 30               OUT (RTC_SEC_1),A
1240   07AD 78                  LD A,B
1241   07AE D3 31               OUT (RTC_SEC_10),A
1242   07B0             
1243   07B0 3A 05 89            LD A,(AST_MINUTE)
1244   07B3 CD F1 07            CALL RTC_BIN_TO_DIGITS
1245   07B6 79                  LD A,C
1246   07B7 D3 32               OUT (RTC_MIN_1),A
1247   07B9 78                  LD A,B
1248   07BA D3 33               OUT (RTC_MIN_10),A
1249   07BC             
1250   07BC 3A 04 89            LD A,(AST_HOUR)
1251   07BF CD F1 07            CALL RTC_BIN_TO_DIGITS
1252   07C2 79                  LD A,C
1253   07C3 D3 34               OUT (RTC_HOUR_1),A
1254   07C5 78                  LD A,B
1255   07C6 D3 35               OUT (RTC_HOUR_10),A
1256   07C8             
1257   07C8 3A 03 89            LD A,(AST_DAY)
1258   07CB CD F1 07            CALL RTC_BIN_TO_DIGITS
1259   07CE 79                  LD A,C
1260   07CF D3 36               OUT (RTC_DAY_1),A
1261   07D1 78                  LD A,B
1262   07D2 D3 37               OUT (RTC_DAY_10),A
1263   07D4             
1264   07D4 3A 02 89            LD A,(AST_MONTH)
1265   07D7 CD F1 07            CALL RTC_BIN_TO_DIGITS
1266   07DA 79                  LD A,C
1267   07DB D3 38               OUT (RTC_MONTH_1),A
1268   07DD 78                  LD A,B
1269   07DE D3 39               OUT (RTC_MONTH_10),A
1270   07E0             
1271   07E0 3A 01 89            LD A,(AST_YEAR)
1272   07E3 CD F1 07            CALL RTC_BIN_TO_DIGITS
1273   07E6 79                  LD A,C
1274   07E7 D3 3A               OUT (RTC_YEAR_1),A
1275   07E9 78                  LD A,B
1276   07EA D3 3B               OUT (RTC_YEAR_10),A
1277   07EC             
1278   07EC CD 9B 07            CALL RTC_HOLD_RELEASE
1279   07EF B7                  OR A
1280   07F0 C9                  RET
1281   07F1             
1282   07F1             ; A=0..99 -> B=tens, C=ones.
1283   07F1             RTC_BIN_TO_DIGITS:
1284   07F1 06 00               LD B,0
1285   07F3             RTC_BTD_LOOP:
1286   07F3 FE 0A               CP 10
1287   07F5 38 05               JR C,RTC_BTD_DONE
1288   07F7 D6 0A               SUB 10
1289   07F9 04                  INC B
1290   07FA 18 F7               JR RTC_BTD_LOOP
1291   07FC             RTC_BTD_DONE:
1292   07FC 4F                  LD C,A
1293   07FD C9                  RET
1294   07FE             
1295   07FE             ; ----------------------------------------------------------------------------
1296   07FE             ; ASTRO_STARTUP_INPUT
1297   07FE             ; Startup civil-time entry used until a GPS module is installed.
1298   07FE             ; Latitude/longitude remain fixed. UTC defaults to -5 but is runtime-editable.
1299   07FE             ;
1300   07FE             ; Sequence:
1301   07FE             ;   DATE MM/DD/YY  -> six digits -> MM/DD/YY ENTER ?
1302   07FE             ;       ENTER accepts; BACKSPACE returns to blank DATE entry.
1303   07FE             ;   TIME HH/MM/SS  -> six digits -> HH/MM/SS ENTER ?
1304   07FE             ;       ENTER accepts; CLEAR returns to blank TIME entry.
1305   07FE             ;   UTC OFFSET ?   -> * selects negative, # selects positive, then type 0..12.
1306   07FE             ;       confirmation shows UTC -N ENTER or UTC +N ENTER; second ENTER accepts.
1307   07FE             ;       ENTER with no sign/digits keeps the current/default UTC-5.
1308   07FE             ;       CLEAR returns to UTC OFFSET ?.
1309   07FE             ; ALPHA at any startup input screen performs the full software reset.
1310   07FE             ; ----------------------------------------------------------------------------
1311   07FE             ASTRO_STARTUP_INPUT:
1312   07FE                     ; Establish known defaults first.  They are replaced by accepted input.
1313   07FE CD BE 06            CALL ASTRO_CLOCK_INIT
1314   0801             
1315   0801             ASI_DATE_RESTART:
1316   0801 AF                  XOR A
1317   0802 32 4F 89            LD (AST_INPUT_MODE),A
1318   0805 CD AD 09            CALL ASI_READ_SIX
1319   0808 CD 46 0A            CALL ASI_PARSE_DATE
1320   080B 38 F4               JR C,ASI_DATE_RESTART
1321   080D CD BF 0A            CALL ASI_DRAW_DATE_CONFIRM
1322   0810             ASI_DATE_CONFIRM_WAIT:
1323   0810 CD 3E 02            CALL KEY_GET
1324   0813 FE 0C               CP KEY_ALPHA
1325   0815 CA F3 37            JP Z,G_FULL_RESET
1326   0818 FE 08               CP KEY_BACKSPACE
1327   081A 28 E5               JR Z,ASI_DATE_RESTART
1328   081C FE 10               CP KEY_ENTER
1329   081E 20 F0               JR NZ,ASI_DATE_CONFIRM_WAIT
1330   0820             
1331   0820             ASI_TIME_RESTART:
1332   0820 3E 01               LD A,1
1333   0822 32 4F 89            LD (AST_INPUT_MODE),A
1334   0825 CD AD 09            CALL ASI_READ_SIX
1335   0828 CD 86 0A            CALL ASI_PARSE_TIME
1336   082B 38 F3               JR C,ASI_TIME_RESTART
1337   082D CD E4 0A            CALL ASI_DRAW_TIME_CONFIRM
1338   0830             ASI_TIME_CONFIRM_WAIT:
1339   0830 CD 3E 02            CALL KEY_GET
1340   0833 FE 0C               CP KEY_ALPHA
1341   0835 CA F3 37            JP Z,G_FULL_RESET
1342   0838 FE 04               CP KEY_CLEAR
1343   083A 28 E4               JR Z,ASI_TIME_RESTART
1344   083C FE 10               CP KEY_ENTER
1345   083E 20 F0               JR NZ,ASI_TIME_CONFIRM_WAIT
1346   0840             
1347   0840             ASI_UTC_PROMPT:
1348   0840                     ; Signed UTC offset entry using the physical 4x4 keypad:
1349   0840                     ;   * = negative/west offset
1350   0840                     ;   # = positive/east offset
1351   0840                     ; ENTER here with no sign/digits keeps the current/default offset.
1352   0840 AF                  XOR A
1353   0841 32 56 89            LD (AST_INCOUNT),A
1354   0844 3E FF               LD A,$FF
1355   0846 32 7A 89            LD (AST_UTC_PENDING_SIGN),A
1356   0849 21 9E 1A            LD HL,MSG_UTC_OFFSET_Q
1357   084C CD 2E 06            CALL DISPLAY_SHOW
1358   084F             
1359   084F             ASI_UTC_PROMPT_WAIT:
1360   084F CD 3E 02            CALL KEY_GET
1361   0852 FE 0C               CP KEY_ALPHA
1362   0854 CA F3 37            JP Z,G_FULL_RESET
1363   0857 FE 04               CP KEY_CLEAR
1364   0859 CA 40 08            JP Z,ASI_UTC_PROMPT
1365   085C FE 10               CP KEY_ENTER
1366   085E 28 48               JR Z,ASI_UTC_ENTER_PRESSED
