0385   02AA             ; ============================================================================
0386   02AA             ; DEBUG CHANNEL - DART A, 1200 baud, 8-N-1
0387   02AA             ; In OshonSoft/Server.vb, writes to port $20 are captured in the debug terminal.
0388   02AA             ; On real TRANZ hardware these are the same DART-A bytes that feed the 73K212.
0389   02AA             ; ============================================================================
0390   02AA             DEBUG_DART_INIT:
0391   02AA                 ; CTC0 corrected for ~1200 baud with 1.7897725 MHz trigger and DART x32.
0392   02AA 3E 47           LD A,$47
0393   02AC D3 10           OUT (CTC0),A
0394   02AE 3E 2F           LD A,$2F
0395   02B0 D3 10           OUT (CTC0),A
0396   02B2 3E 10           LD A,$10
0397   02B4 D3 10           OUT (CTC0),A
0398   02B6 3E 47           LD A,$47
0399   02B8 D3 11           OUT (CTC1),A
0400   02BA 3E 06           LD A,$06
0401   02BC D3 11           OUT (CTC1),A
0402   02BE 3E 03           LD A,$03
0403   02C0 D3 12           OUT (CTC2),A
0404   02C2 3E 87           LD A,$87
0405   02C4 D3 13           OUT (CTC3),A
0406   02C6 3E E0           LD A,$E0
0407   02C8 D3 13           OUT (CTC3),A
0408   02CA             
0409   02CA                 ; DART A reset, x32 async, 1 stop, no parity, 8-bit RX/TX, polling.
0410   02CA 3E 18           LD A,$18
0411   02CC D3 21           OUT (DART_A_CTRL),A
0412   02CE 3E 04           LD A,$04
0413   02D0 D3 21           OUT (DART_A_CTRL),A
0414   02D2 3E 84           LD A,$84
0415   02D4 D3 21           OUT (DART_A_CTRL),A
0416   02D6 3E 03           LD A,$03
0417   02D8 D3 21           OUT (DART_A_CTRL),A
0418   02DA 3E C1           LD A,$C1
0419   02DC D3 21           OUT (DART_A_CTRL),A
0420   02DE 3E 05           LD A,$05
0421   02E0 D3 21           OUT (DART_A_CTRL),A
0422   02E2 3E EA           LD A,$EA                    ; DTR + RTS + TX enabled, 8 bits
0423   02E4 D3 21           OUT (DART_A_CTRL),A
0424   02E6 3E 01           LD A,$01
0425   02E8 D3 21           OUT (DART_A_CTRL),A
0426   02EA AF              XOR A
0427   02EB D3 21           OUT (DART_A_CTRL),A
