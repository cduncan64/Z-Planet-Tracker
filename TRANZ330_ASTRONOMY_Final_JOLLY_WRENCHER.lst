7884   510A             ; Moon perturbations, coefficients rounded to 0.1 degree.
7885   510A             G_MOON_PERTURB:
7886   510A                     ; Compute Lm=N+w+Mm; Ls=sun true longitude; D=Lm-Ls; F=Lm-N.
