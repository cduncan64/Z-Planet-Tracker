8851   5897 D8                  RET C
8852   5898 4F                  LD C,A
8853   5899 23                  INC HL
8854   589A 78                  LD A,B
8855   589B 87                  ADD A,A
8856   589C 57                  LD D,A
8857   589D 87                  ADD A,A
8858   589E 87                  ADD A,A
8859   589F 82                  ADD A,D
8860   58A0 81                  ADD A,C
8861   58A1 B7                  OR A
8862   58A2 C9                  RET
8863   58A3             
