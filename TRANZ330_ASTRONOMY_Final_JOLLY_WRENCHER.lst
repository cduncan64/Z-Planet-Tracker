5154   39FE 3A 01 89            LD A,(AST_YEAR)
5155   3A01 32 A8 8A            LD (G_CALC_YEAR),A
5156   3A04 3A 02 89            LD A,(AST_MONTH)
5157   3A07 32 A9 8A            LD (G_CALC_MONTH),A
5158   3A0A 3A 03 89            LD A,(AST_DAY)
5159   3A0D 32 AA 8A            LD (G_CALC_DAY),A
5160   3A10 3A 04 89            LD A,(AST_HOUR)
5161   3A13 32 AB 8A            LD (G_CALC_HOUR),A
5162   3A16 3A 05 89            LD A,(AST_MINUTE)
5163   3A19 32 AC 8A            LD (G_CALC_MINUTE),A
5164   3A1C 3A 57 89            LD A,(AST_SECOND)
5165   3A1F 32 AD 8A            LD (G_CALC_SECOND),A
5166   3A22 C9                  RET
5167   3A23             
