8123   52F1 22 0E 8A            LD (G_REFINE_MIN),HL
8124   52F4 CD 23 53            CALL G_MOON_UP_AT_MIN
8125   52F7 CD 7E 14            CALL ASTRO_ABOVE_HORIZON
8126   52FA 32 73 89            LD (AST_PREV),A
8127   52FD 06 0A               LD B,10
8128   52FF             G_RC_LOOP:
8129   52FF 2A 0E 8A            LD HL,(G_REFINE_MIN)
8130   5302 23                  INC HL
8131   5303 22 0E 8A            LD (G_REFINE_MIN),HL
8132   5306 C5                  PUSH BC                         ; lunar vector code freely uses B/C
8133   5307 CD 23 53            CALL G_MOON_UP_AT_MIN
8134   530A CD 7E 14            CALL ASTRO_ABOVE_HORIZON
8135   530D C1                  POP BC                          ; preserve DJNZ refinement count
8136   530E 57                  LD D,A
8137   530F 3A 73 89            LD A,(AST_PREV)
8138   5312 BA                  CP D
8139   5313 20 0A               JR NZ,G_RC_FOUND
8140   5315 7A                  LD A,D
8141   5316 32 73 89            LD (AST_PREV),A
8142   5319 10 E4               DJNZ G_RC_LOOP
8143   531B 2A 0E 8A            LD HL,(G_REFINE_MIN)
8144   531E C9                  RET
8145   531F             G_RC_FOUND:
8146   531F 2A 0E 8A            LD HL,(G_REFINE_MIN)
8147   5322 C9                  RET
8148   5323             
8149   5323             ; Input HL=local minute, returns signed up coordinate.
8150   5323             ; IMPORTANT: lunar vector generation uses G_TMPW0..G_TMPW3 as scratch,
8151   5323             ; so preserve the local minute in dedicated RAM instead of a G_TMPW register.
8152   5323             G_MOON_UP_AT_MIN:
8153   5323 22 0C 8A            LD (G_MOON_LOCAL_MIN),HL
8154   5326 CD 97 4D            CALL G_LOCAL_TO_UTC_MIN
8155   5329 CD F5 49            CALL G_VECTOR_SELECTED
8156   532C 2A 0C 8A            LD HL,(G_MOON_LOCAL_MIN)
8157   532F                     ; Event detection needs only UP.  Skip EAST/NORTH during all lunar
8158   532F                     ; coarse and one-minute event samples; final current AZ/EL still uses
8159   532F                     ; the complete horizontal calculation elsewhere.
8160   532F CD D7 4C            CALL G_UP_FOR_VECTOR_FAST
8161   5332 2A 3B 89            LD HL,(AST_UP)
8162   5335 C9                  RET
8163   5336             
8164   5336             ; ---------------------------------------------------------------------------
8165   5336             ; MOON PHASE from corrected Moon/Sun ecliptic longitude at current vector.
8166   5336             ; 0 => NEW, 100 => FULL, 1..99 numeric PHASE.
8167   5336             ; ---------------------------------------------------------------------------
8168   5336             G_CALC_MOON_PHASE:
8169   5336 2A DE 89            LD HL,(G_MOON_LON)
8170   5339 ED 5B E0 89         LD DE,(G_SUN_LON)
8171   533D B7                  OR A
8172   533E ED 52               SBC HL,DE
8173   5340 CD 86 0F            CALL ASTRO_NORM3600_SIGNED
8174   5343 E5                  PUSH HL
8175   5344 11 08 07            LD DE,1800
8176   5347 B7                  OR A
8177   5348 ED 52               SBC HL,DE
8178   534A 3E 00               LD A,0                       ; 0 = waxing for elongation < 180 deg
8179   534C 38 01               JR C,G_PHASE_DIR_STORE
8180   534E 3C                  INC A                        ; 1 = waning for elongation >= 180 deg
8181   534F             G_PHASE_DIR_STORE:
8182   534F 32 0A 8A            LD (G_PHASE_DIR),A
8183   5352 E1                  POP HL
8184   5353 CD 21 16            CALL ASTRO_COS10_SIGNED
8185   5356 EB                  EX DE,HL                   ; DE=cos Q15 signed
8186   5357 21 FF 7F            LD HL,32767
8187   535A B7                  OR A
8188   535B ED 52               SBC HL,DE                  ; 0..65534
8189   535D                     ; divide by 655, quotient 0..100
8190   535D 06 00               LD B,0
8191   535F 11 8F 02            LD DE,655
8192   5362             G_PHASE_DIV:
8193   5362 B7                  OR A
8194   5363 ED 52               SBC HL,DE
8195   5365 38 03               JR C,G_PHASE_DONE
8196   5367 04                  INC B
8197   5368 18 F8               JR G_PHASE_DIV
8198   536A             G_PHASE_DONE:
8199   536A 78                  LD A,B
8200   536B FE 65               CP 101
8201   536D 38 02               JR C,G_PHASE_STORE
8202   536F 3E 64               LD A,100
8203   5371             G_PHASE_STORE:
8204   5371 32 82 89            LD (G_PHASE),A
8205   5374 C9                  RET
8206   5375             
8207   5375             ; ---------------------------------------------------------------------------
8208   5375             ; PLUTO SPECIAL LOW-PRECISION MODEL (Schlyter-style periodic series).
8209   5375             ; input uses current G_UTC_MIN. returns through G_ECL_TO_EQ.
8210   5375             ; ---------------------------------------------------------------------------
8211   5375             G_VECTOR_PLUTO:
8212   5375                     ; For the 0.1-degree Z80 model, evolve S, P and base longitude using
8213   5375                     ; small linear rates from AST_DAYS; fractional day is negligible here.
8214   5375 21 F4 01            LD HL,500
8215   5378 22 96 89            LD (G_CALC_BASE),HL
8216   537B 21 12 0D            LD HL,3346
8217   537E 22 98 89            LD (G_CALC_RATE),HL
8218   5381 CD A6 46            CALL G_CALC_SMALL
8219   5384 22 8D 89            LD (G_TMPW0),HL            ; S
8220   5387 21 56 09            LD HL,2390
8221   538A 22 96 89            LD (G_CALC_BASE),HL
8222   538D 21 8D 01            LD HL,397
8223   5390 22 98 89            LD (G_CALC_RATE),HL
8224   5393 CD A6 46            CALL G_CALC_SMALL
8225   5396 22 8F 89            LD (G_TMPW1),HL            ; P
8226   5399 21 56 09            LD HL,2390
8227   539C 22 96 89            LD (G_CALC_BASE),HL
8228   539F 21 91 01            LD HL,401
8229   53A2 22 98 89            LD (G_CALC_RATE),HL
8230   53A5 CD A6 46            CALL G_CALC_SMALL
8231   53A8 22 D8 89            LD (G_LON),HL              ; base lon
8232   53AB                     ; longitude periodic terms (tenths deg)
8233   53AB 21 00 00            LD HL,0
8234   53AE 22 DC 89            LD (G_PSUM),HL
8235   53B1 2A 8F 89            LD HL,(G_TMPW1)
8236   53B4 11 3A FF            LD DE,-198
8237   53B7 CD E8 50            CALL G_ADD_SIN_TERM
8238   53BA 2A 8F 89            LD HL,(G_TMPW1)
8239   53BD 11 C6 00            LD DE,198
8240   53C0 CD F9 50            CALL G_ADD_COS_TERM
8241   53C3 2A 8F 89            LD HL,(G_TMPW1)
8242   53C6 29                  ADD HL,HL
8243   53C7 11 09 00            LD DE,9
8244   53CA CD E8 50            CALL G_ADD_SIN_TERM
8245   53CD 2A 8F 89            LD HL,(G_TMPW1)
8246   53D0 29                  ADD HL,HL
8247   53D1 11 CE FF            LD DE,-50
8248   53D4 CD F9 50            CALL G_ADD_COS_TERM
8249   53D7 2A 8F 89            LD HL,(G_TMPW1)
8250   53DA ED 5B 8F 89         LD DE,(G_TMPW1)
8251   53DE 29                  ADD HL,HL
8252   53DF 19                  ADD HL,DE                  ; 3P
8253   53E0 11 06 00            LD DE,6
8254   53E3 CD E8 50            CALL G_ADD_SIN_TERM
8255   53E6 2A 8F 89            LD HL,(G_TMPW1)
8256   53E9 ED 5B 8F 89         LD DE,(G_TMPW1)
8257   53ED 29                  ADD HL,HL
8258   53EE 19                  ADD HL,DE
8259   53EF 11 0C 00            LD DE,12
8260   53F2 CD F9 50            CALL G_ADD_COS_TERM
8261   53F5 2A 8F 89            LD HL,(G_TMPW1)
8262   53F8 29                  ADD HL,HL
8263   53F9 29                  ADD HL,HL                  ; 4P
8264   53FA 11 FD FF            LD DE,-3
8265   53FD CD E8 50            CALL G_ADD_SIN_TERM
8266   5400 2A 8F 89            LD HL,(G_TMPW1)
8267   5403 29                  ADD HL,HL
8268   5404 29                  ADD HL,HL
8269   5405 11 FE FF            LD DE,-2
8270   5408 CD F9 50            CALL G_ADD_COS_TERM
8271   540B 2A 8F 89            LD HL,(G_TMPW1)
8272   540E ED 5B 8F 89         LD DE,(G_TMPW1)
8273   5412 29                  ADD HL,HL
8274   5413 29                  ADD HL,HL
8275   5414 19                  ADD HL,DE                  ; 5P
8276   5415 11 01 00            LD DE,1
8277   5418 CD E8 50            CALL G_ADD_SIN_TERM
8278   541B 2A D8 89            LD HL,(G_LON)
8279   541E ED 5B DC 89         LD DE,(G_PSUM)
8280   5422 19                  ADD HL,DE
8281   5423 CD 86 0F            CALL ASTRO_NORM3600_SIGNED
8282   5426 22 D8 89            LD (G_LON),HL
8283   5429             
8284   5429                     ; latitude base -39 tenths + periodic terms
8285   5429 21 D9 FF            LD HL,-39
8286   542C 22 DC 89            LD (G_PSUM),HL
8287   542F 2A 8F 89            LD HL,(G_TMPW1)
8288   5432 11 C9 FF            LD DE,-55
8289   5435 CD E8 50            CALL G_ADD_SIN_TERM
8290   5438 2A 8F 89            LD HL,(G_TMPW1)
8291   543B 11 6A FF            LD DE,-150
8292   543E CD F9 50            CALL G_ADD_COS_TERM
8293   5441 2A 8F 89            LD HL,(G_TMPW1)
8294   5444 29                  ADD HL,HL
8295   5445 11 23 00            LD DE,35
8296   5448 CD E8 50            CALL G_ADD_SIN_TERM
8297   544B 2A 8F 89            LD HL,(G_TMPW1)
8298   544E 29                  ADD HL,HL
8299   544F 11 11 00            LD DE,17
8300   5452 CD F9 50            CALL G_ADD_COS_TERM
8301   5455 2A 8F 89            LD HL,(G_TMPW1)
8302   5458 ED 5B 8F 89         LD DE,(G_TMPW1)
8303   545C 29                  ADD HL,HL
8304   545D 19                  ADD HL,DE
8305   545E 11 F5 FF            LD DE,-11
8306   5461 CD E8 50            CALL G_ADD_SIN_TERM
8307   5464 2A 8F 89            LD HL,(G_TMPW1)
8308   5467 ED 5B 8F 89         LD DE,(G_TMPW1)
8309   546B 29                  ADD HL,HL
8310   546C 19                  ADD HL,DE
8311   546D 11 03 00            LD DE,3
8312   5470 CD F9 50            CALL G_ADD_COS_TERM
8313   5473 2A 8F 89            LD HL,(G_TMPW1)
8314   5476 29                  ADD HL,HL
8315   5477 29                  ADD HL,HL
8316   5478 11 02 00            LD DE,2
8317   547B CD E8 50            CALL G_ADD_SIN_TERM
8318   547E 2A 8F 89            LD HL,(G_TMPW1)
8319   5481 29                  ADD HL,HL
8320   5482 29                  ADD HL,HL
8321   5483 11 FD FF            LD DE,-3
8322   5486 CD F9 50            CALL G_ADD_COS_TERM
8323   5489 2A 8F 89            LD HL,(G_TMPW1)
8324   548C ED 5B 8F 89         LD DE,(G_TMPW1)
8325   5490 29                  ADD HL,HL
8326   5491 29                  ADD HL,HL
8327   5492 19                  ADD HL,DE
8328   5493 11 01 00            LD DE,1
8329   5496 CD F9 50            CALL G_ADD_COS_TERM
8330   5499 2A DC 89            LD HL,(G_PSUM)
8331   549C 22 DA 89            LD (G_LAT),HL
8332   549F             
8333   549F                     ; radius in units of 1/512 AU: base 40.72 AU = 20849
8334   549F 21 71 51            LD HL,20849
8335   54A2 22 DC 89            LD (G_PSUM),HL
8336   54A5 2A 8F 89            LD HL,(G_TMPW1)
8337   54A8 11 5C 0D            LD DE,3420
8338   54AB CD E8 50            CALL G_ADD_SIN_TERM
8339   54AE 2A 8F 89            LD HL,(G_TMPW1)
8340   54B1 11 CD 0D            LD DE,3533
8341   54B4 CD F9 50            CALL G_ADD_COS_TERM
8342   54B7 2A 8F 89            LD HL,(G_TMPW1)
8343   54BA 29                  ADD HL,HL
8344   54BB 11 A4 FD            LD DE,-604
8345   54BE CD E8 50            CALL G_ADD_SIN_TERM
8346   54C1 2A 8F 89            LD HL,(G_TMPW1)
8347   54C4 29                  ADD HL,HL
8348   54C5 11 F1 FF            LD DE,-15
8349   54C8 CD F9 50            CALL G_ADD_COS_TERM
8350   54CB 2A 8F 89            LD HL,(G_TMPW1)
8351   54CE ED 5B 8F 89         LD DE,(G_TMPW1)
8352   54D2 29                  ADD HL,HL
8353   54D3 19                  ADD HL,DE
8354   54D4 11 4D 00            LD DE,77
8355   54D7 CD E8 50            CALL G_ADD_SIN_TERM
8356   54DA 2A 8F 89            LD HL,(G_TMPW1)
8357   54DD ED 5B 8F 89         LD DE,(G_TMPW1)
8358   54E1 29                  ADD HL,HL
8359   54E2 19                  ADD HL,DE
8360   54E3 11 B8 FF            LD DE,-72
8361   54E6 CD F9 50            CALL G_ADD_COS_TERM
8362   54E9 2A DC 89            LD HL,(G_PSUM)
8363   54EC 22 91 89            LD (G_TMPW2),HL            ; r
8364   54EF             
8365   54EF                     ; heliocentric xyz from lon/lat/r
8366   54EF 2A DA 89            LD HL,(G_LAT)
8367   54F2 CD 21 16            CALL ASTRO_COS10_SIGNED
8368   54F5 22 93 89            LD (G_TMPW3),HL            ; coslat
8369   54F8 2A D8 89            LD HL,(G_LON)
8370   54FB CD 24 16            CALL ASTRO_COS10
8371   54FE ED 5B 93 89         LD DE,(G_TMPW3)
8372   5502 CD 34 16            CALL ASTRO_MUL_Q15
8373   5505 EB                  EX DE,HL
8374   5506 2A 91 89            LD HL,(G_TMPW2)
8375   5509 CD 34 16            CALL ASTRO_MUL_Q15
8376   550C 22 D2 89            LD (G_XH),HL
8377   550F 2A D8 89            LD HL,(G_LON)
8378   5512 CD 14 16            CALL ASTRO_SIN10
8379   5515 ED 5B 93 89         LD DE,(G_TMPW3)
8380   5519 CD 34 16            CALL ASTRO_MUL_Q15
8381   551C EB                  EX DE,HL
8382   551D 2A 91 89            LD HL,(G_TMPW2)
8383   5520 CD 34 16            CALL ASTRO_MUL_Q15
8384   5523 22 D4 89            LD (G_YH),HL
8385   5526 2A DA 89            LD HL,(G_LAT)
8386   5529 CD 11 16            CALL ASTRO_SIN10_SIGNED
8387   552C EB                  EX DE,HL
8388   552D 2A 91 89            LD HL,(G_TMPW2)
8389   5530 CD 34 16            CALL ASTRO_MUL_Q15
8390   5533 22 D6 89            LD (G_ZH),HL
8391   5536                     ; geocentric = heliocentric + Sun
8392   5536 2A D2 89            LD HL,(G_XH)
8393   5539 ED 5B C6 89         LD DE,(G_SX)
8394   553D 19                  ADD HL,DE
8395   553E 22 D2 89            LD (G_XH),HL
8396   5541 2A D4 89            LD HL,(G_YH)
8397   5544 ED 5B C8 89         LD DE,(G_SY)
8398   5548 19                  ADD HL,DE
8399   5549 22 D4 89            LD (G_YH),HL
8400   554C C3 60 4A            JP G_ECL_TO_EQ
