6129   442D                     ; Brief completion acknowledgement, then return automatically.
6130   442D                     ; Do NOT wait for a key here.  The caller will restore G_SCREEN=0
6131   442D                     ; and redraw the normal object status screen (for example JUPITER VIS).
6132   442D 21 AF 5E            LD HL,GMSG_PRINT_COMPLETE
