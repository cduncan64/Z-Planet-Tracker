8039   5248 CD 23 53            CALL G_MOON_UP_AT_MIN
8040   524B 22 E8 89            LD (G_DYN_PREV),HL
8041   524E CD 7E 14            CALL ASTRO_ABOVE_HORIZON
8042   5251 32 73 89            LD (AST_PREV),A
8043   5254 21 0A 00            LD HL,10
8044   5257 22 6C 89            LD (AST_SCAN_MIN),HL
8045   525A             G_EM_LOOP:
8046   525A                     ; Spread progress dots 2, 3 and 4 across the lunar event scan.
8047   525A 2A 6C 89            LD HL,(AST_SCAN_MIN)
8048   525D 11 68 01            LD DE,360
8049   5260 B7                  OR A
8050   5261 ED 52               SBC HL,DE
